# bc, as a CPDL recipe (ADR-0305 stage 4).
#
# A translation of the previous build.sh: same tarball at the same
# digest, the same configure invocation, the same `make install`.
#
# The shell recipe deleted usr/share/{man,info}; ADR-0306 withdrew that practice (#491) and those lines are gone.
package "bc" {
    version "1.08.1"
    release 5
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "bc" {
            url "https://ftp.gnu.org/gnu/bc/bc-1.08.1.tar.gz"
            sha256 "b71457ffeb210d7ea61825ff72b3e49dc8f2c1a04102bbe23591d783d1bfe996"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "d7830101fdfff667d569c21bd21666f51e1075d3f43698d95bc21c00130e41dc"
        "changelog" "1.08.1-5: no change but the release. The 1.08.1-4 approval was earned over a .tar.gz before the artifact-format flip, so it can never match the .cixpkg this recipe declares and every fresh host rebuilds this version from source (cix#497). This revision carries no approval and earns one over its own .cixpkg on first publish, which is ADR-0307 clause 5's path."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/bc"
        }
        require directory "${src}/bc/bc-1.08.1" {
            exists
        }
    }

    build {
        cd "${src}/bc/bc-1.08.1" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
            }
            run "make" {
                "MAKEINFO=true"
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/bc/bc-1.08.1" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
            }
        }
        require file "${dest}/usr/bin/bc" {
            exists
            nonempty
        }
    }
}
