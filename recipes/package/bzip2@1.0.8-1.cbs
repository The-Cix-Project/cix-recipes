# bzip2 1.0.8: the bzip2 compressor, for build use (ADR-0398).
#
# WHY IT EXISTS. usb-modeswitch-data is published only as .tar.bz2, and
# CBS's libarchive is built --without-bz2lib (libarchive@3.8.1-7), so no
# Cix host could unpack it. Measured: probe-modeswitch@2-2 found the
# tarball still packed under ${src}/data. A recipe that needs a .bz2
# source materializes it and runs this bzip2, then tar.
#
# BUILT DIRECTLY WITH TCC. upstream's Makefile builds libbz2.a and links
# against it, which needs ar/ranlib for nothing but this; the binary is
# the eight translation units the Makefile names (OBJS plus bzip2.o),
# compiled in one tcc call. -D_FILE_OFFSET_BITS=64 is the Makefile's own
# BIGFILES. No shared library is shipped: nothing in Cix links libbz2.
#
# GATE: upstream ships sample1..3.bz2 for exactly this; `bzip2 -t`
# decompresses each in memory and checks its CRC, so a miscompiled
# decoder fails here rather than in a later build.
package "bzip2" {
    version "1.0.8"
    release 1
    format "cixpkg"

    license "bzip2-1.0.6"

    sources {
        main "bzip2" {
            url "https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz"
            sha256 "ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
        }
    }

    metadata {
        "changelog" "1.0.8-1: new. The bzip2 binary only, built directly with tcc, gated by upstream's sample files; for unpacking .tar.bz2 sources such as usb-modeswitch-data (ADR-0398)."
    }

    prepare {
        require directory "${src}/bzip2/bzip2-1.0.8" {
            exists
        }
        on_fail {
            run "ls" { "-la" "${src}/bzip2" allow_failure }
        }
    }

    build {
        cd "${src}/bzip2/bzip2-1.0.8" {
            run "tcc" {
                "-O2"
                "-D_FILE_OFFSET_BITS=64"
                "-o" "bzip2"
                "blocksort.c" "huffman.c" "crctable.c" "randtable.c"
                "compress.c" "decompress.c" "bzlib.c" "bzip2.c"
            }
            run "./bzip2" { "-t" "sample1.bz2" "sample2.bz2" "sample3.bz2" }
        }
    }

    install {
        mkdir "${dest}/usr/bin" parents
        copy "${src}/bzip2/bzip2-1.0.8/bzip2" to "${dest}/usr/bin/bzip2"
        chmod 0755 "${dest}/usr/bin/bzip2"
        symlink "bzip2" to "${dest}/usr/bin/bunzip2"
        symlink "bzip2" to "${dest}/usr/bin/bzcat"
        mkdir "${dest}/usr/share/licenses/bzip2" parents
        copy "${src}/bzip2/bzip2-1.0.8/LICENSE" to "${dest}/usr/share/licenses/bzip2/LICENSE"
        require file "${dest}/usr/bin/bzip2" {
            exists
            nonempty
        }
    }
}
