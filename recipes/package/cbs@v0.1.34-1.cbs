# cbs v0.1.34-1: seven operations, and every one of them was filed
# from this corpus in a single day of converting recipes.
#
#   non-archive main sources          cix-build-system#205
#   stderr capture and assertions     #206
#   globs expanded into run arguments #207
#   literal ${} preserved in a block string  #208
#   glob bindings preserved across phases    #209
#   anchored source replacements      #210
#   named post-install check cases    #211
#
# #205 is the one that unblocks packages OUTRIGHT rather than
# tidying them. `ca-certificates` is a bare cacert.pem and
# `rtw88-firmware` is a 150984-byte blob pinned to a linux-firmware
# commit; neither has a tarball to point at, and CBS extracted every
# declared source unconditionally, so neither could be written in
# CPDL at all. Re-hosting either inside a tarball we build ourselves
# would have defeated the point, because for a CA bundle "the
# publisher's bytes" IS the security property.
#
# #211 is the one that changes how recipes are written from here on.
# Measured across the 98 latest .cbs recipes in this repository:
# 367 verification operations, and THREE recipes using the check
# phase built for them. The cause was structural -- check ran before
# install, so it could not see the staged artifact, and 239 of 315
# require operations assert on ${dest}. Named post-install cases fix
# the ordering and give a failure something to say beyond a line
# number.
#
# #207, #208, #209 and #210 are each a workaround in a shipped
# recipe, tracked in cix#509 and revertible now: three in
# hostapd@2.11-11 alone (a generated makefile standing in for a
# wildcard link line, a toolwrap rebuilt through positional
# parameters because a block string rejected ${}, and a glob binding
# declared twice), and libcap@2.78-15's shebang rewrite narrowed
# from the whole tree to one named script.
#
# #206 restores an assertion rather than enabling one: bird prints
# --version to stderr, CPDL could only see stdout, and
# bird@2.19.1-12 had to ship checking that the binary runs without
# checking what it says.
#
# AND v0.1.34 IS TAGGED WITH VERSION MOVED. That had failed five
# times running (#172, #184, #187, #200, #204). It matters because
# CBS's own suite asserts `cbs --version` equals VERSION, so a build
# from main can only report a stale number, and this platform cannot
# publish something called 0.1.33 that is not 0.1.33 -- two byte
# sequences under one immutable version is exactly what package
# immutability exists to prevent.
#
package "cbs" {
    version "v0.1.34"
    release 1
    format "cixpkg"

    sources {
        main "cbs" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix-build-system/archive/v0.1.34.tar.gz"
            sha256 "b358052a94823a3bccc55bcd45533cc4bb43134a7d9bc67cbae4b25537e143ea"
        }
        # zstd 1.5.4, for upstream-test. Declared as a source so the
        # daemon fetches and checksum-verifies it host-side; never
        # fetched from inside the build.
        extra "zstd" {
            url "https://github.com/facebook/zstd/archive/refs/tags/v1.5.4.tar.gz"
            sha256 "35ad983197f8f8eb0c963877bf8be50490a0b3df54b4edeb8399ba8a8b2f60a4"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "grep"
            tool "sed"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "tar"
            tool "gzip"
            # curl, for libcurl.so.4. CBS dlopen()s it to fetch, and
            # tests/cli-build-test.sh serves a source over a local
            # http-server and has cbs fetch it -- so the suite needs the
            # library even though nothing here reaches the network.
            #
            # Dropped by the first draft of this translation, and the
            # build caught it: `make test` ran the recipe corpus, 50
            # parser cases, the metadata test and the upstream smoke
            # test, then failed in cli-build-test.sh. A declaration
            # system earning its keep on its own recipe.
            tool "curl"
            tool "libarchive"
            tool "zstd"
            tool "linux-headers"
        }
        runtime {
            package "libarchive"
            package "zstd"
        }
    }

    metadata {
        "artifact_sha256" "4973529c7b3db712dd83f11215365270ce1d16c5d59a2ec59737d7deaa401817"
        "changelog" "v0.1.34-1: seven operations, every one filed from this corpus while converting recipes. #205 non-archive main sources unblocks ca-certificates and rtw88-firmware outright -- neither has a tarball to point at. #211 named post-install check cases: 98 recipes carry 367 verification operations and three use the check phase, because it ran before install and could not see the artifact. #206 stderr assertions, #207 globs as run arguments, #208 braces in block strings, #209 glob bindings across phases."
    }

    prepare {
        #
        # Every source extracts into ${src}/<source-name>/, main
        # included -- cbs_prepare_sources_with_events() mkdirs
        # "<source_root>/<source->name>" for each and extracts there,
        # preserving the archive's own top-level directory. Note two of
        # the three recipes upstream ships omit that segment and would
        # not build; their recipe-test only validates.
        #
        # Listed before it is required so that the log answers what the
        # gitea archive's top-level directory is actually called, rather
        # than only whether one guess was right. This sandbox compiles
        # and unpacks nothing, so the box is the only place that can
        # answer it, and one build cycle is the price of that rule.
        #
        run "ls" {
            "-la"
            "${src}/cbs"
        }
        require directory "${src}/cbs/cix-build-system" {
            exists
        }
        #
        # The zstd deprecation define, appended to the Makefile rather
        # than passed on the command line.
        #
        # This is the shell recipe's hardest-won detail and the reason
        # this phase exists at all. A make command-line assignment has
        # the highest precedence of all and cannot be appended to, so
        # passing CPPFLAGS there silently discards the Makefile's own
        #
        #   CPPFLAGS += -DCBS_VERSION=\"$(CBS_VERSION)\"
        #
        # and src/main.c falls through to `#define CBS_VERSION
        # "unknown"`. That is why `cbs --version` said `cbs unknown`
        # through revisions -3 to -7 of the shell recipe: the version
        # was being computed and thrown away.
        #
        # Anchored on the CBS_VERSION line, and `exactly 1`, so that if
        # upstream moves or renames it the edit fails loudly here
        # rather than producing a binary that builds and reports the
        # wrong version. The shell recipe relies on a sed that matches
        # nothing failing later at zstd.h; CPDL can simply insist.
        #
        replace "${src}/cbs/cix-build-system/Makefile" {
            from "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\""
            to "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\"\nCPPFLAGS += -DZSTD_DISABLE_DEPRECATE_WARNINGS"
            exactly 1
        }
    }

    build {
        # CC=tcc explicitly, never a bare cc: the build sandbox's
        # default compiler has silently become real GCC before (#109),
        # and a build system compiled by the wrong compiler is the least
        # useful place for that to go unnoticed.
        cd "${src}/cbs/cix-build-system" {
            run "make" {
                env "CC" = "tcc"
                jobs $jobs
            }
        }
    }

    check {
        # The whole upstream suite, as a real gate -- restored to the
        # plain form every cbs revision before v0.1.27-1 had.
        #
        # v0.1.27-1's check carried five build cycles of scaffolding
        # after ./tests/archive-test failed under `make test` while
        # passing standalone, printing nothing either way. That is
        # cix-build-system#180, and this release carries its fix:
        # "make archive-test report which check failed". So the
        # scaffolding is gone -- if the test fails now it says which
        # assertion, which is what the issue asked for and what makes a
        # diagnostic revision unnecessary.
        cd "${src}/cbs/cix-build-system" {
            run "make" {
                "test"
                env "CC" = "tcc"
                env "CBS_UPSTREAM_CACHE" = "/build/cbscache"
                env "TMPDIR" = "/run"
                jobs $jobs
            }
            # It runs, and it knows its own version.
            run "./cbs" {
                "--version"
            }
        }
    }

    install {
        mkdir "${dest}/usr/bin" chmod 0755
        copy "${src}/cbs/cix-build-system/cbs" to "${dest}/usr/bin/cbs"
        require file "${dest}/usr/bin/cbs" {
            exists
        }
    }
}
