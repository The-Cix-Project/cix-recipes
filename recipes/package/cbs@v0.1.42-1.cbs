# cbs v0.1.42-1: CBS-owned compiler tool policies (cbs#219) and a
# filesystem fixture that says what it failed on (cbs#218).
#
# cbs#219 IS THE ONE THAT CHANGES RECIPES. Four packages in this
# corpus fabricate seven executables and put them on PATH, because
# CPDL had no way to say how a declared tool should be invoked --
# shell smuggled back into a language whose whole point is not
# having one. v0.1.42 replaces that with a declaration:
#
#   tools {
#       compiler alias "cc"
#       compiler rewrite "-MMD" to "-MD"
#   }
#
# TWO VERBS, NOT THREE, AND THE THIRD WAS DELETED BY MEASUREMENT.
# The original proposal had a `via` verb for a tool that must run
# under an interpreter, justified solely by libuv, whose recipe said
# aclocal/automake/libtoolize were "dangling Debian update-
# alternatives symlink chains" failing ENOEXEC.
# probe-autotools-exec@3 measured all three in a composed
# environment: ordinary regular files, 36020/262055/136685 bytes,
# readlink -f landing on themselves, and all three exec directly and
# report their version. The premise was true of the old cumulative
# g_pkgbuild_rootfs with its ambient Debian content and has not been
# true since ADR-0199. So `via` had no user, and the verb whose
# resolution contract was blocking implementation simply went away.
#
# cbs#218 IS WHY THAT WAS FINDABLE AT ALL. v0.1.39 failed its own
# filesystem fixture and named the assertion; v0.1.40 failed it and
# printed only "FAIL". A fixture harness that can say
# CPDL-E4004 ... allow_failure in one release and nothing in the
# next has lost the thing that made the first diagnosable, which is
# cbs#180's shape. v0.1.41 gave it operation context back.
#
# v0.1.39 AND v0.1.40 ARE BOTH SKIPPED and neither was ever
# installed here. Each failed its own `make test` in this recipe's
# check phase -- v0.1.39 because allow_failure stopped tolerating a
# zero-match glob (cbs#217), which openssl, iptables and libcap all
# rely on for the normal case where nothing matched. The check
# phase refusing to install an engine whose suite fails is this
# recipe working as intended.
#
package "cbs" {
    version "v0.1.42"
    release 1
    format "cixpkg"

    sources {
        main "cbs" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix-build-system/archive/v0.1.42.tar.gz"
            sha256 "a50eb540ffd6247809fd250461ed7997c01da42d3d2b7bd2b5ed3aa2dd380386"
        }
        # zstd 1.5.4, for upstream-test. Declared as a source so the
        # daemon fetches and checksum-verifies it host-side; never
        # fetched from inside the build.
        extra "zstd" {
            url "https://github.com/facebook/zstd/archive/refs/tags/v1.5.4.tar.gz"
            sha256 "35ad983197f8f8eb0c963877bf8be50490a0b3df54b4edeb8399ba8a8b2f60a4"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "grep"
            tool "sed"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "tar"
            tool "gzip"
            # curl, for libcurl.so.4. CBS dlopen()s it to fetch, and
            # tests/cli-build-test.sh serves a source over a local
            # http-server and has cbs fetch it -- so the suite needs the
            # library even though nothing here reaches the network.
            #
            # Dropped by the first draft of this translation, and the
            # build caught it: `make test` ran the recipe corpus, 50
            # parser cases, the metadata test and the upstream smoke
            # test, then failed in cli-build-test.sh. A declaration
            # system earning its keep on its own recipe.
            tool "curl"
            tool "libarchive"
            tool "zstd"
            tool "linux-headers"
        }
        runtime {
            package "libarchive"
            package "zstd"
        }
    }

    metadata {
        "artifact_sha256" "4973529c7b3db712dd83f11215365270ce1d16c5d59a2ec59737d7deaa401817"
        "changelog" "v0.1.42-1: CBS-owned compiler tool policies (cbs#219) and a filesystem fixture that reports operation context again (cbs#218). The tools block replaces the seven shell shims four recipes fabricate. Two verbs, not three: the via verb was deleted by measurement -- probe-autotools-exec@3 showed aclocal, automake and libtoolize are ordinary files that exec directly, so libuv premise about dangling Debian symlinks has not been true since ADR-0199. v0.1.39 and v0.1.40 are skipped; both failed their own suite."
    }

    prepare {
        #
        # THE MAIN source extracts into ${src}/<source-name>/,
        # preserving the archive's own top-level directory. An EXTRA
        # source no longer does: v0.1.34 made the specification true
        # -- an extra source "remains a named verified input until an
        # explicit extract or materialize operation uses it" -- so
        # anything reaching for ${src}/<extra-name>/ now finds
        # nothing. hostapd@2.11-12 found that out with
        # "glob binding expected 1 matches but found 0".
        #
        # Listed before it is required so that the log answers what the
        # gitea archive's top-level directory is actually called, rather
        # than only whether one guess was right. This sandbox compiles
        # and unpacks nothing, so the box is the only place that can
        # answer it, and one build cycle is the price of that rule.
        #
        run "ls" {
            "-la"
            "${src}/cbs"
        }
        require directory "${src}/cbs/cix-build-system" {
            exists
        }
        #
        # The zstd deprecation define, appended to the Makefile rather
        # than passed on the command line.
        #
        # This is the shell recipe's hardest-won detail and the reason
        # this phase exists at all. A make command-line assignment has
        # the highest precedence of all and cannot be appended to, so
        # passing CPPFLAGS there silently discards the Makefile's own
        #
        #   CPPFLAGS += -DCBS_VERSION=\"$(CBS_VERSION)\"
        #
        # and src/main.c falls through to `#define CBS_VERSION
        # "unknown"`. That is why `cbs --version` said `cbs unknown`
        # through revisions -3 to -7 of the shell recipe: the version
        # was being computed and thrown away.
        #
        # Anchored on the CBS_VERSION line, and `exactly 1`, so that if
        # upstream moves or renames it the edit fails loudly here
        # rather than producing a binary that builds and reports the
        # wrong version. The shell recipe relies on a sed that matches
        # nothing failing later at zstd.h; CPDL can simply insist.
        #
        replace "${src}/cbs/cix-build-system/Makefile" {
            from "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\""
            to "CPPFLAGS += -DCBS_VERSION=\\\"$(CBS_VERSION)\\\"\nCPPFLAGS += -DZSTD_DISABLE_DEPRECATE_WARNINGS"
            exactly 1
        }
    }

    build {
        # CC=tcc explicitly, never a bare cc: the build sandbox's
        # default compiler has silently become real GCC before (#109),
        # and a build system compiled by the wrong compiler is the least
        # useful place for that to go unnoticed.
        cd "${src}/cbs/cix-build-system" {
            run "make" {
                env "CC" = "tcc"
                jobs $jobs
            }
        }
    }

    check {
        # The whole upstream suite, as a real gate -- restored to the
        # plain form every cbs revision before v0.1.27-1 had.
        #
        # v0.1.27-1's check carried five build cycles of scaffolding
        # after ./tests/archive-test failed under `make test` while
        # passing standalone, printing nothing either way. That is
        # cix-build-system#180, and this release carries its fix:
        # "make archive-test report which check failed". So the
        # scaffolding is gone -- if the test fails now it says which
        # assertion, which is what the issue asked for and what makes a
        # diagnostic revision unnecessary.
        cd "${src}/cbs/cix-build-system" {
            run "make" {
                "test"
                env "CC" = "tcc"
                env "CBS_UPSTREAM_CACHE" = "/build/cbscache"
                env "TMPDIR" = "/run"
                jobs $jobs
            }
            # It runs, and it knows its own version.
            run "./cbs" {
                "--version"
            }
        }
    }

    install {
        mkdir "${dest}/usr/bin" chmod 0755
        copy "${src}/cbs/cix-build-system/cbs" to "${dest}/usr/bin/cbs"
        require file "${dest}/usr/bin/cbs" {
            exists
        }
    }
}
