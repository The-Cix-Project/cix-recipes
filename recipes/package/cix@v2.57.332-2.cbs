#
# THIS RECIPE STATES ITS VERSION IN FIVE PLACES AND THEY MUST MOVE
# TOGETHER: the `version` field, and four `CIX_VERSION=` env settings
# on the make invocations. The Makefile takes CIX_VERSION when it is
# set and falls back to `git describe` otherwise, and a build
# container has no git, so whatever those four say is what every
# binary in the artifact reports for the rest of its life.
#
# Getting that wrong is silent and it reaches a booted host. Measured
# on 192.168.15.95, 2026-09-26: cix@v2.57.332-1 was derived from the
# v2.57.277 recipe by changing the version, the url and the sha256,
# which left the four CIX_VERSION lines behind. It built clean, its
# whole suite passed, it assembled, it deployed, it booted -- and
# `cixctl boot` reported `v2.57.277 (02:01:37Z)` on a slot running
# binaries compiled at 02:01:37Z from the v2.57.332 tree. Correct
# bytes wearing the previous release's name, with nothing anywhere
# reporting a fault. The functional change was verified live and only
# the label was wrong, which is the dangerous shape: every later
# "is it deployed?" reads the label.
#
# CPDL has no way to say "my own version" -- `${version}` does not
# exist, and none of the 385 recipes in the corpus uses such a thing
# -- which is why this is five literals rather than one. Filed
# upstream as cix-build-system#238. Until it lands, bump all five or
# bump none.
#
# cix -- the platform itself: cix-init, cixd, cixctl, mkbootroot,
# cix-install, cix-recover, mkinstalleriso, cix-boot.efi, cix-xorriso,
# and the web dashboard. This is what `pkg hostbuild cix --upgrade
# --wait --deploy` builds and ships.
#
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
# Same tag at the same digest, same nine binaries, same selftest, same
# negative control.
#
# THE NEGATIVE CONTROL IS THE HEART OF THIS RECIPE. A selftest that
# passes proves nothing unless it can fail, so the build poisons the
# console session struct -- reintroducing cix#296 -- rebuilds cixd,
# and runs the console-input test again, which MUST now fail. If it
# passes against a build carrying the bug, the test is not detecting
# what it was written for and its earlier pass means nothing, so this
# build is refused. The poison is then reverted and cixd rebuilt
# clean, and that restore is asserted before anything ships.
#
# CPDL states both halves better than the shell did.
#
#   The poison and the restore were `sed -i` followed by `grep -q` to
#   check the sed had taken. `replace ... exactly 1` is both: the
#   count must match BEFORE a byte is written, so an edit that would
#   not apply fails on the operation rather than on a verification
#   afterwards. If main.c moves, this fails naming the operation
#   instead of shipping a build whose control was never armed.
#
#   The "must now fail" run was `rc=0; ./build/test_console_exec ||
#   rc=$?` then a test for rc = 0. test_console_exec returns 1 on
#   every failure path, so `expect exit 1` is exact -- and it is
#   STRONGER, because a test binary that crashed, or that could not
#   start, no longer counts as "it failed, good". Only the specific
#   failure the control is designed to provoke satisfies it.
#
# WHAT CANNOT BE CARRIED OVER: the shell tailed 30 lines of the failed
# run's log to make the failure legible. CBS prints the failing
# command and the run's own output reaches the build log, so the
# diagnostic is not lost, only its formatting.
#
package "cix" {
    version "v2.57.332"
    release 2
    format "cixpkg"

    sources {
        main "cix" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/v2.57.332.tar.gz"
            sha256 "9dd7c9f275236c3b85f463831826469718251bcca364e1bef8ca81fadd78796e"
        }
        # The ADR-0209 build floor, for the three FLOOR_SELFTESTS the
        # selftest below now runs (cix#485). Real published artifacts,
        # each verified against the checksum its own recipe approves by
        # test_image_fixture_seed_floor_packages(), which refuses to
        # fabricate one -- so these are a precondition of the selftest
        # passing, not an optimisation.
        extra "bash" {
            url "http://192.168.15.31:8080/bash-5.2.37-2-x86_64.tar.gz"
            sha256 "47f08a7eac65b59ce6e6a211ffcf77545993f4b5c52c094dbd79ec367f08bd14"
        }
        extra "coreutils" {
            url "http://192.168.15.31:8080/coreutils-9.11-3-x86_64.tar.gz"
            sha256 "f040e943e222849b9b8b405c16d1abeebf238544c9905328173c2f3ad4fb1009"
        }
        extra "tcc" {
            url "http://192.168.15.31:8080/tcc-0.9.27-7-x86_64.tar.gz"
            sha256 "2e9095069725a251dcecadddc89e179f08627728ff13d376510a854e0e6de26d"
        }
        extra "glibc" {
            url "http://192.168.15.31:8080/glibc-2.44-19-x86_64.cixpkg"
            sha256 "220c11019bf7cc729befca2b0cdf7ddd77399de2b436a50000299d52bd4d954d"
        }
        extra "linuxheaders" {
            url "http://192.168.15.31:8080/linux-headers-6.18.40-4-x86_64.tar.gz"
            sha256 "5cd03e3376c4640bd7a05b578855935ca6ae880a6c6cfe6e516e914ea880e315"
        }
        extra "zlib" {
            url "http://192.168.15.31:8080/zlib-1.3.2-11-x86_64.tar.gz"
            sha256 "c79f66f9ce3aa84236b46c9001eb617ac9d57fbd9c263ebb023e9581af38e284"
        }
        extra "flex" {
            url "http://192.168.15.31:8080/flex-2.6.4-2-x86_64.tar.gz"
            sha256 "956c62c65e3befad1c725c98032cd63aa7e167598a7be3e12ffaaace155fe6bd"
        }
        extra "binutils" {
            url "http://192.168.15.31:8080/binutils-2.42-10-x86_64.tar.gz"
            sha256 "23f6cc2b007bb58dcb105f1ef390caaee81cf6c36b0c50150e415d0f66d4d73e"
        }
        extra "xz" {
            url "http://192.168.15.31:8080/xz-5.8.3-8-x86_64.tar.gz"
            sha256 "e3828c45658a3ecf15793b2918a5d4fa2b947f47228d9d0b21b456257a76ca68"
        }
        extra "zstd" {
            url "http://192.168.15.31:8080/zstd-1.5.7-5-x86_64.cixpkg"
            sha256 "75e78994a5f46bab071a93ae83a88f095d4a98aba79e39316e5a860763bde05c"
        }
        extra "libarchive" {
            url "http://192.168.15.31:8080/libarchive-3.8.1-5-x86_64.cixpkg"
            sha256 "80c911806cb2892392d58cdd2910c7f0b1504093ea9ea57c24e733ff1f93f720"
        }
        extra "cbs" {
            url "http://192.168.15.31:8080/cbs-v0.1.55-1-x86_64.cixpkg"
            sha256 "14663c02a2df52113919e416f995f28679c69495ec004d2ceab94761a18d7fbf"
        }
        # The corpus the floor reads each package's own recipe from, so
        # it can verify the artifact against the checksum that recipe
        # approves. Pinned, because a release has to build the same way
        # tomorrow; bd2c3d83 is the tree probe-cix-testreport@26 proved
        # these three tests pass against.
        extra "recipes" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix-recipes/archive/bd2c3d8314cac560febe2f3c1b1258a83090d5c7.tar.gz"
            sha256 "4f0d5969d91b33f3ecbb566d44661f85dc7f23da6b3caf8345747f0ae81abe03"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "tar"
            tool "gzip"
            tool "binutils"
            tool "openssl"
            tool "libarchive"
            tool "curl"
            tool "quickjs"
            tool "minisign"
            # cix-boot.efi is built with gcc: a PE/COFF EFI image needs
            # the MS ABI, which TCC does not emit.
            tool "gcc"
        }
        runtime {
            package "openssl"
            package "libarchive"
            package "curl"
        }
    }

    metadata {
        "changelog" "v2.57.332-1: cix v2.57.332. Publishing a NEW shell recipe is refused (cix#516, ADR-0309 clause 4), so the parallel stops growing while it retires. NOT the build path: 65 of 181 installed versions here still resolve to a shell revision and parse_recipe() builds every one. The check sits after the immutability block so recipe-sync's skips stay skips, and test_pkg gates both halves -- 400 for a new shell revision, 409 for a stored one."
    }

    # The selftest creates real containers, so the build container
    # needs cgroup2 mounted and the right to clone namespaces. cixd
    # grants both only for CAP_SYS_ADMIN (src/container.c's
    # mount_cgroup2 derivation). The shell recipe carried this as
    # pkg_build_caps="CAP_SYS_ADMIN"; -2 to -4 dropped it, and the
    # suite failed with 258 cgroup_create errors, 33 missing
    # cgroup.controllers and ns_clone3 EPERM (cix#515).
    capability "CAP_SYS_ADMIN"

    prepare {
        # The floor where test_image_fixture_seed_floor_packages() looks
        # for it, under the source tree, with the UNSTAMPED names its own
        # table asks for -- the published artifacts are arch-stamped and
        # the fixture is not (cix#485).
        mkdir "${src}/cix/cix/build-inputs"
        mkdir "${src}/cix/cix/build-inputs/floor-artifacts"
        materialize $source.bash to "${src}/cix/cix/build-inputs/floor-artifacts/bash-5.2.37-2.tar.gz"
        materialize $source.coreutils to "${src}/cix/cix/build-inputs/floor-artifacts/coreutils-9.11-3.tar.gz"
        materialize $source.tcc to "${src}/cix/cix/build-inputs/floor-artifacts/tcc-0.9.27-7.tar.gz"
        materialize $source.glibc to "${src}/cix/cix/build-inputs/floor-artifacts/glibc-2.44-19.cixpkg"
        materialize $source.linuxheaders to "${src}/cix/cix/build-inputs/floor-artifacts/linux-headers-6.18.40-4.tar.gz"
        materialize $source.zlib to "${src}/cix/cix/build-inputs/floor-artifacts/zlib-1.3.2-11.tar.gz"
        materialize $source.flex to "${src}/cix/cix/build-inputs/floor-artifacts/flex-2.6.4-2.tar.gz"
        materialize $source.binutils to "${src}/cix/cix/build-inputs/floor-artifacts/binutils-2.42-10.tar.gz"
        materialize $source.xz to "${src}/cix/cix/build-inputs/floor-artifacts/xz-5.8.3-8.tar.gz"
        materialize $source.zstd to "${src}/cix/cix/build-inputs/floor-artifacts/zstd-1.5.7-5.cixpkg"
        materialize $source.libarchive to "${src}/cix/cix/build-inputs/floor-artifacts/libarchive-3.8.1-5.cixpkg"
        materialize $source.cbs to "${src}/cix/cix/build-inputs/floor-artifacts/cbs-v0.1.55-1.cixpkg"

        extract $source.recipes into "${src}" as "cix-recipes"
        require directory "${src}/cix-recipes/recipes/package" {
            exists
        }
    }

    build {
        cd "${src}/cix/cix" {
            run "make" {
                "CIX_VERSION=v2.57.332"
                "build/cix-init"
                "build/cixd"
                "build/cixctl"
                "build/mkbootroot"
                "build/cix-install"
                "build/cix-recover"
                "build/mkinstalleriso"
                "build/cix-boot.efi"
                "build/cix-xorriso"
            }

            # Serial, like every make in this recipe, because the
            # shell recipe was serial and a conversion's job is to be
            # equivalent. Parallelism did NOT cause the -2 to -4
            # selftest failures -- -4 had none and failed worse. The
            # cause was the missing capability declared above.
            run "make" {
                "CIX_VERSION=v2.57.332"
                "selftest"
                # The floor reads each package's own recipe for the
                # checksum it verifies the artifact against; the
                # default is a sibling of the source tree, and this
                # says so rather than relying on the layout.
                env "CIX_RECIPES_DIR" = "${src}/cix-recipes/recipes"
            }
        }

        # cix#296: poison the console session struct. See the header --
        # this is what makes the selftest above mean something.
        replace "${src}/cix/cix/daemon/src/main.c" {
            from "\tmemset(sess, 0, sizeof(*sess));"
            to "\tmemset(sess, 0xff, sizeof(*sess)); /* #296 proof */"
            exactly 1
        }

        cd "${src}/cix/cix" {
            run "make" {
                "CIX_VERSION=v2.57.332"
                "build/cixd"
            }

            # It must now detect the bug. Exactly 1 -- the code
            # test_console_exec returns on a real detection.
            run "build/test_console_exec" {
                expect exit 1
            }
        }

        # Restore, and assert the restore. A build that shipped the
        # poisoned memset would be shipping cix#296 deliberately.
        replace "${src}/cix/cix/daemon/src/main.c" {
            from "\tmemset(sess, 0xff, sizeof(*sess)); /* #296 proof */"
            to "\tmemset(sess, 0, sizeof(*sess));"
            exactly 1
        }

        cd "${src}/cix/cix" {
            run "make" {
                "CIX_VERSION=v2.57.332"
                "build/cixd"
            }
        }
    }

    install {
        # The hostbuild artifact is flat: mkbootroot reads these from
        # the artifact root, not from a usr/bin prefix.
        copy "${src}/cix/cix/build/cix-init" to "${dest}/cix-init"
        copy "${src}/cix/cix/build/cixd" to "${dest}/cixd"
        copy "${src}/cix/cix/build/cixctl" to "${dest}/cixctl"
        copy "${src}/cix/cix/build/mkbootroot" to "${dest}/mkbootroot"
        copy "${src}/cix/cix/build/cix-install" to "${dest}/cix-install"
        copy "${src}/cix/cix/build/cix-recover" to "${dest}/cix-recover"
        copy "${src}/cix/cix/build/mkinstalleriso" to "${dest}/mkinstalleriso"
        copy "${src}/cix/cix/build/cix-boot.efi" to "${dest}/cix-boot.efi"
        copy "${src}/cix/cix/build/cix-xorriso" to "${dest}/cix-xorriso"
        copy tree "${src}/cix/cix/web" to "${dest}/web"

        # Without these the assembled control plane serves a blank
        # dashboard -- which looks like a running system.
        require file "${dest}/web/index.html" {
            exists
            nonempty
        }
        require file "${dest}/web/app.js" {
            exists
            nonempty
        }
        require file "${dest}/web/style.css" {
            exists
            nonempty
        }
        require file "${dest}/web/api.js" {
            exists
            nonempty
        }

        require file "${dest}/cixd" {
            exists
            executable
        }
        require file "${dest}/cix-init" {
            exists
            executable
        }

        # cix-boot.efi must be a PE image. Two bytes captured and
        # asserted, which is exact for a two-byte file -- the same
        # shape squashfs-tools uses for its squashfs magic.
        run "dd" {
            "if=${dest}/cix-boot.efi"
            "bs=1"
            "count=2"
            stdout file "${build}/efi-magic"
        }
        require file "${build}/efi-magic" {
            exists
            contains "MZ"
        }
    }
}
