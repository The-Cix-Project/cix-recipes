# cmake -- needed to build fastfetch, and whatever else arrives with
# a CMakeLists.txt rather than a configure script.
#
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
#
# THE GATE IS THE WHOLE POINT OF THIS RECIPE, and it survives the
# conversion intact. A `make` that exits 0 says a cmake binary was
# linked; it says nothing about whether that cmake can do its job.
# So the build writes a two-file project, configures it, builds it,
# runs the result, and requires the exact string back. Four steps,
# each of which a broken cmake fails at a different one of.
#
# The two heredocs become block strings, which process no escapes
# and no interpolation, so the CMakeLists and the C stay byte for
# byte what the heredocs emitted. Neither contains dollar-brace, so
# neither runs into cbs#208.
#
# The scratch tree moves from /run/cmake-gate into the build root.
# CPDL confines paths to the build roots, and that is the right
# place for scratch anyway -- /run was only ever chosen because this
# platform's minimal images have no /tmp. The final `rm -rf` goes
# with it: the build root is discarded.
#
# --parallel takes ${jobs} rather than a command substitution,
# because the job count is a value CBS already knows and CPDL does
# no command substitution.
#
# gcc, and it is not a TCC gap to fix or track: CMake is C++17 and
# TCC has no C++ front end at all, so this is the wrong tool rather
# than a missing feature -- the same reasoning btop records
# (ADR-0226).
package "cmake" {
    version "4.4.3"
    release 6
    format "cixpkg"

    sources {
        main "cmake" {
            url "https://cmake.org/files/v4.4/cmake-4.4.3.tar.gz"
            sha256 "c46400618b4f1f2b43507f24fb22f3ae830c3416cf23b776e16e1d413aa892f0"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "findutils"
            tool "binutils"
            tool "glibc"
            tool "linux-headers"
            tool "openssl"
            tool "pkgconf"
        }
        runtime {
            package "openssl"
            #
            # cix#534: usr/bin/cmake links libstdc++.so.6, and gcc is
            # what provides it -- measured on 192.168.15.95,
            # 2026-09-27: GET /v1/pkg/gcc lists
            # lib/x86_64-linux-gnu/libstdc++.so.6 and usr/lib64/
            # libstdc++.so.6, and no other installed package lists it
            # at all. There is no split libstdc++ package in the
            # corpus.
            #
            # Declaring the whole compiler as a runtime dependency is
            # heavier than it sounds and is nonetheless the
            # established answer here: node@24.21.0-2 does exactly
            # this, for exactly this reason, and its own comment
            # records the same measurement. Inventing a second way
            # for cmake would be a parallel implementation of a
            # decision already taken.
            #
            # Not optional. gcc was already declared as a BUILD tool,
            # which puts it in the build sandbox and NOT in the
            # target image, so the link was recorded and the
            # dependency was not -- and the install-time gate refuses
            # the package outright (#389), rightly: an image without
            # libstdc++ crashes cmake at execve. The shell recipe
            # 4.4.3-3 has the same gap and installed only because
            # that gate did not run against it.
            #
            package "gcc"
        }
    }

    toolchain "gcc" {
        reason "language: CMake is C++17 and TCC has no C++ front end at all, so this is not a TCC gap to fix or track -- it is the wrong tool, the same reasoning btop 1.4.7-1 records. Measured against gcc 16.2.0-13, which is installed in cix-builder with g++, libstdc++ and the C++ headers."
    }

    metadata {
        "artifact_sha256" "23f330e14cae5b99a8680d49dad5b84b878e61826f5093d1401d7c4f7d5bb25a"
        "changelog" "4.4.3-6: fixes cix#534. 4.4.3-5 built clean and its gate passed, then install refused it: usr/bin/cmake links libstdc++.so.6 and nothing declared a provider. gcc was declared as a BUILD tool, which puts it in the sandbox and not the target image, so the link was recorded and the dependency was not. gcc is the only package shipping libstdc++.so.6 (measured), and declaring it at runtime is what node@24.21.0-2 already does for the same reason."
    }

    build {
        cd "${src}/cmake/cmake-4.4.3" {
            run "./bootstrap" {
                "--prefix=/usr"
                "--parallel=${jobs}"
                "--no-qt-gui"
                "--no-system-libs"
            }
            run "make" {
                jobs $jobs
            }
            # THE GATE. A two-file project, configured, built and
            # run, because a linked cmake binary is not a working
            # one.
            mkdir "${build}/cmake-gate/src"
            write "${build}/cmake-gate/src/CMakeLists.txt" """
            cmake_minimum_required(VERSION 3.12.0)
            project(cixgate C)
            add_executable(cixgate main.c)
            """
            # printf is load-bearing: the gate RUNS this binary and
            # requires its output below, which is what proves the
            # cmake just built produces a WORKING binary and not
            # merely a linked one. So cix#530's fix is the include,
            # not dropping the printf -- that would quietly demote
            # the gate to a compile check.
            #
            # 4.4.3-4 omitted the include and cost 44 minutes: it
            # built cmake completely, then died on this line, because
            # an implicit printf is an error in current gcc and was a
            # warning when the fixture was written. A gate's fixture
            # is code and ages like code.
            #
            # It cannot be syntax-checked cheaply before the build:
            # CPDL refuses a compiler as a run executable
            # (CPDL-E3006, "command interpreters are not valid run
            # executables"), so there is no way to spend a
            # millisecond here instead of 44 minutes. Recorded rather
            # than worked around.
            write "${build}/cmake-gate/src/main.c" """
            #include <stdio.h>
            int main(void) { printf("cmake-gate-ok\n"); return 0; }
            """
            run "./bin/cmake" {
                "-S"
                "${build}/cmake-gate/src"
                "-B"
                "${build}/cmake-gate/build"
                "-DCMAKE_BUILD_TYPE=Release"
            }
            run "./bin/cmake" {
                "--build"
                "${build}/cmake-gate/build"
            }
            run "${build}/cmake-gate/build/cixgate" {
                stdout file "${build}/cmake-gate/out.txt"
            }
            require file "${build}/cmake-gate/out.txt" {
                exists
                contains "cmake-gate-ok"
            }
        }
    }

    install {
        cd "${src}/cmake/cmake-4.4.3" {
            run "make" {
                "DESTDIR=${dest}"
                "install"
            }
        }
        require file "${dest}/usr/bin/cmake" {
            exists
            executable
        }
        require file "${dest}/usr/bin/ctest" {
            exists
            executable
        }
    }
}
