# curl-impersonate 2.3.1 -- libcurl patched to present a browser's TLS
# and HTTP/2 fingerprint, for curl_cffi, which SearXNG makes every
# outgoing request through. 2.3.1 is the version curl_cffi 0.17.0's
# Makefile names.
#
# ONE SUPERBUILD, NINE PINNED DEPENDENCIES. Upstream's CMakeLists builds
# BoringSSL, nghttp2, ngtcp2, nghttp3, brotli, zstd, zlib and c-ares as
# ExternalProjects, then curl 8.23.0 against them, each pinned by URL and
# SHA256 in that file. Every one is declared here with the same sha256,
# and placed where ExternalProject downloads it to
# (<build>/<name>-prefix/src/<file>): ExternalProject finds a file with
# the expected hash there and skips the download, so the sealed build
# fetches nothing and upstream's build files are not edited.
#
# INSTALLED UNDER /usr/lib/curl-impersonate. Its headers are curl's own
# (<curl/curl.h>), so under /usr/include they would collide with the
# curl package's; the prefix keeps the library, headers and the static
# curl-impersonate binary out of every other package's paths. curl_cffi
# links the shared libcurl-impersonate (all nine dependencies linked into
# it) with an rpath to this directory: the static archive holds curl
# alone, without them, so a static link would leave BoringSSL unresolved
# until import.
package "curl-impersonate" {
    version "2.3.1"
    release 3
    format "cixpkg"

    license "MIT"

    sources {
        main "ci" {
            url "https://github.com/lexiforest/curl-impersonate/archive/refs/tags/v2.3.1.tar.gz"
            sha256 "7ba6eb87aefa6fb5c0974945e84783bf55faed0d08c70972e3f2807125264451"
        }
        extra "cares" {
            url "https://github.com/c-ares/c-ares/releases/download/v1.34.9/c-ares-1.34.9.tar.gz"
            sha256 "9364b70a12eb59a06830fb488d9357f90100dff0d98b23ea3593a183d43e6f2f"
        }
        extra "zlib" {
            url "https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz"
            sha256 "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
        }
        extra "zstd" {
            url "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz"
            sha256 "eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
        }
        extra "brotli" {
            url "https://github.com/google/brotli/archive/refs/tags/v1.2.1.tar.gz"
            sha256 "98d35d11a78dc453aebb7d10c3748f3f73ff78c8267c0dc697b8631f67bf7e8f"
        }
        extra "boringssl" {
            url "https://github.com/google/boringssl/archive/156c7b75ae9b8c3b3f847acf264f17594c3859fb.zip"
            sha256 "450e169b284697c6eafe523cb7679f4221fbe1a0993f773a566c33b188762844"
        }
        extra "nghttp2" {
            url "https://github.com/nghttp2/nghttp2/releases/download/v1.63.0/nghttp2-1.63.0.tar.bz2"
            sha256 "607b174554d22a828bc532d1d734fe0f729b5d5ed207f2f12e96a62e83f29c55"
        }
        extra "ngtcp2" {
            url "https://github.com/ngtcp2/ngtcp2/releases/download/v1.20.0/ngtcp2-1.20.0.tar.bz2"
            sha256 "871ec97ad86803cf312901b0c393b0ee70163e25a87c9b2894d1234341ce4e97"
        }
        extra "nghttp3" {
            url "https://github.com/ngtcp2/nghttp3/releases/download/v1.15.0/nghttp3-1.15.0.tar.bz2"
            sha256 "c6c491a52804814098e446630e6efc459afc0d3da7952ffe6cbdc0b3f99b2b62"
        }
        extra "curl" {
            url "https://github.com/curl/curl/archive/curl-8_23_0.tar.gz"
            sha256 "d0605d5883124ef5ae64c6d2b307e1417c482b362583b57491fdf37d9a99a792"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "cmake"
            tool "make"
            tool "ninja"
            tool "patch"
            tool "perl"
            tool "pkgconf"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
        runtime {
            package "glibc"
            package "gcc-libs"
        }
    }

    toolchain "gcc" {
        reason "BoringSSL is C++ and tcc compiles no C++. Stated 2026-11-28."
    }

    metadata {
        "artifact_sha256" "806327638be1f7299caf58bb72f34b05c6a9a517eba26a2e48fe3a65b6f486ed"
        "changelog" "2.3.1-3: declares ninja, which the superbuild's curl subproject configures with. 2.3.1-2: built without libidn2 (USE_LIBIDN2=OFF): upstream expects one prebuilt by its Makefile, and internationalised host names are not something SearXNG's engines need. 2.3.1-1: first revision, for curl_cffi 0.17.0 (SearXNG). Upstream's superbuild with its nine pinned dependencies supplied as declared sources, installed under /usr/lib/curl-impersonate."
    }

    prepare {
        require file "${src}/ci/curl-impersonate-2.3.1/CMakeLists.txt" {
            exists
        }
        mkdir "${build}/cmk/cares-prefix/src" parents
        materialize $source.cares to "${build}/cmk/cares-prefix/src/c-ares-1.34.9.tar.gz"
        mkdir "${build}/cmk/zlib-prefix/src" parents
        materialize $source.zlib to "${build}/cmk/zlib-prefix/src/zlib-1.3.1.tar.gz"
        mkdir "${build}/cmk/zstd-prefix/src" parents
        materialize $source.zstd to "${build}/cmk/zstd-prefix/src/zstd-1.5.7.tar.gz"
        mkdir "${build}/cmk/brotli-prefix/src" parents
        materialize $source.brotli to "${build}/cmk/brotli-prefix/src/v1.2.1.tar.gz"
        mkdir "${build}/cmk/boringssl-prefix/src" parents
        materialize $source.boringssl to "${build}/cmk/boringssl-prefix/src/156c7b75ae9b8c3b3f847acf264f17594c3859fb.zip"
        mkdir "${build}/cmk/nghttp2-prefix/src" parents
        materialize $source.nghttp2 to "${build}/cmk/nghttp2-prefix/src/nghttp2-1.63.0.tar.bz2"
        mkdir "${build}/cmk/ngtcp2-prefix/src" parents
        materialize $source.ngtcp2 to "${build}/cmk/ngtcp2-prefix/src/ngtcp2-1.20.0.tar.bz2"
        mkdir "${build}/cmk/nghttp3-prefix/src" parents
        materialize $source.nghttp3 to "${build}/cmk/nghttp3-prefix/src/nghttp3-1.15.0.tar.bz2"
        mkdir "${build}/cmk/curl-prefix/src" parents
        materialize $source.curl to "${build}/cmk/curl-prefix/src/curl-8_23_0.tar.gz"
        on_fail {
            run "ls" { "-la" "${src}/ci" allow_failure }
        }
    }

    build {
        run "cmake" {
            "-S" "${src}/ci/curl-impersonate-2.3.1"
            "-B" "${build}/cmk"
            "-DCMAKE_BUILD_TYPE=Release"
            "-DCMAKE_INSTALL_PREFIX=/usr/lib/curl-impersonate"
            "-DCMAKE_INSTALL_LIBDIR=lib"
            "-DCMAKE_C_COMPILER=/usr/bin/gcc"
            "-DCMAKE_CXX_COMPILER=/usr/bin/g++"
            "-DCURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
            "-DSUBJOBS=8"
            "-DUSE_LIBIDN2=OFF"
        }
        run "cmake" {
            "--build" "${build}/cmk"
            "--parallel" "8"
        }
        on_fail {
            run "ls" { "-laR" "${build}/cmk/deps/src" allow_failure }
            run "ls" { "-la" "${build}/cmk/boringssl-prefix/src" "${build}/cmk/curl-prefix/src" allow_failure }
        }
    }

    install {
        run "cmake" {
            "--install" "${build}/cmk"
            env "DESTDIR" = "${dest}"
        }
        require file "${dest}/usr/lib/curl-impersonate/lib/pkgconfig/libcurl-impersonate.pc" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/curl-impersonate/include/curl/curl.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/curl-impersonate/bin/curl-impersonate" {
            exists
            executable
        }
        run "${dest}/usr/lib/curl-impersonate/bin/curl-impersonate" {
            "--version"
            stdout file "${build}/version.txt"
        }
        run "grep" { "-q" "BoringSSL" "${build}/version.txt" }
        on_fail {
            run "cat" { "${build}/version.txt" allow_failure }
            run "ls" { "-laR" "${dest}/usr/lib/curl-impersonate" allow_failure }
        }
    }
}
