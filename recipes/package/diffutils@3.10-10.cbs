# diffutils, as a CPDL recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/diffutils/3.10-8/build.sh: same
# tarball at the same digest, the same two source edits, the same
# configure and `make install`.
#
# The shell recipe's guard-then-edit pair collapses into the edit.
# It did:
#
#     grep -q '= (/\* UNCHANGED \*/' src/diff.c || {
#             echo "... the parenthesized initializer is gone" >&2
#             exit 1
#     }
#     sed -i -e 's|= (/\* UNCHANGED \*/|= /* UNCHANGED */|' ...
#
# -- a guard whose whole job is to make a `sed` that matches nothing
# fail loudly, because `sed` itself will not. CPDL's `replace` takes
# `exactly N` and does that by construction, so the guard is not
# translated: it is subsumed. A count that is wrong fails the build
# naming the file and the count, which is strictly more than the hand
# -written message said.
#
# Both edits are LITERAL despite how they look. The backslashes in the
# shell form are sed's, escaping `*` and `|` for its own regex; the
# text being matched contains no metacharacters. The `\n` in the second
# is genuinely two characters in the C source -- a backslash and an n
# inside a string literal -- so it is written `\\n` here, since CPDL
# maps `\n` to a newline.
package "diffutils" {
    version "3.10"
    release 10
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "diffutils" {
            url "https://ftp.gnu.org/gnu/diffutils/diffutils-3.10.tar.xz"
            sha256 "90e5e93cc724e4ebe12ede80df1634063c7a855692685919bfe60b556c9bd09e"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "e70ae492f05b356e3b83f97dffdd3d95fe08a76ee9160dd7fac297fcaa77a6ac"
        "changelog" "3.10-10: no change but the release. The 3.10-9 approval was earned over a .tar.gz before the artifact-format flip, so it can never match the .cixpkg this recipe declares and every fresh host rebuilds this version from source (cix#497). This revision carries no approval and earns one over its own .cixpkg on first publish, which is ADR-0307 clause 5's path."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/diffutils"
        }
        require directory "${src}/diffutils/diffutils-3.10" {
            exists
        }
        # TCC rejects the parenthesized initializer this removes.
        replace "${src}/diffutils/diffutils-3.10/src/diff.c" {
            from "= (/* UNCHANGED */"
            to "= /* UNCHANGED */"
            exactly 1
        }
        # An unterminated string literal as upstream writes it; the
        # trailing `)` belongs to a macro TCC does not take here.
        replace "${src}/diffutils/diffutils-3.10/src/diff.c" {
            from "\"#endif /* @ */\\n\");"
            to "\"#endif /* @ */\\n\";"
            exactly 1
        }
    }

    build {
        cd "${src}/diffutils/diffutils-3.10" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
            }
            # dist_man1_MANS= carried over: diffutils builds its man
            # pages with help2man, which is not declared here and is not
            # worth pulling in. This is upstream being told not to BUILD
            # them, which is a different thing from ADR-0306's rule
            # against deleting what was built.
            run "make" {
                "MAKEINFO=true"
                "dist_man1_MANS="
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/diffutils/diffutils-3.10" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "MAKEINFO=true"
                "dist_man1_MANS="
            }
        }
        require file "${dest}/usr/bin/diff" {
            exists
            nonempty
        }
        require file "${dest}/usr/bin/cmp" {
            exists
            nonempty
        }
    }
}
