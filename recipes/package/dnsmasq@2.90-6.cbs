# dnsmasq -- the DNS forwarder and DHCP server this platform's own
# dns-1/dns-2 containers run. Converted from build.sh to build.cbs
# (ADR-0305 stage 4, #487).
#
# Nothing to restore under #491: this recipe never deleted anything.
# It copies one binary and writes two small files.
#
# THE /etc/passwd AND /etc/group ARE LOAD-BEARING, not boilerplate.
# dnsmasq looks up its configured run-as user by name at startup --
# even as root, even with privilege-dropping compiled out -- and
# these images have no /etc/passwd at all, so getpwnam() legitimately
# returns nothing and it exits with "Fatal error : Could not get
# user/group ID of root" on every attempt. That is recorded in
# CLAUDE.md's environment notes against chrony, which fails the same
# way for the same reason.
package "dnsmasq" {
    version "2.90"
    release 6
    format "cixpkg"

    sources {
        main "dnsmasq" {
            url "https://deb.debian.org/debian/pool/main/d/dnsmasq/dnsmasq_2.90.orig.tar.xz"
            sha256 "8e50309bd837bfec9649a812e066c09b6988b73d749b7d293c06c57d46a109e4"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "nftables"
            tool "libnftnl"
            tool "libmnl"
            tool "gmp"
        }
        runtime {
            package "glibc"
            package "nftables"
        }
    }

    metadata {
        "artifact_sha256" "cf2db7a481f58695b31c0419fc5899181538a4d2229b05270569550ca4980814"
        "changelog" "2.90-6: the nftset gate greps a file, since --version prints several lines and CPDL expects one (-5 built; only that gate failed). 2.90-5: built with nftset (HAVE_NFTSET, linking libnftables from nftables), for the cores' per-domain policy routing; the install is gated on --version listing nftset. 2.90-4: converted from build.sh to CPDL (ADR-0305) and published as a .cixpkg; the minimal /etc/passwd and /etc/group are load-bearing (dnsmasq looks up its run-as user by name at startup)."
    }

    build {
        cd "${src}/dnsmasq/dnsmasq-2.90" {
            run "make" {
                jobs $jobs
                "CC=tcc"
                "PREFIX=/usr"
                "COPTS=-DHAVE_NFTSET"
            }
        }
    }

    install {
        mkdir "${dest}/usr/sbin" chmod 0755
        mkdir "${dest}/etc" chmod 0755
        copy "${src}/dnsmasq/dnsmasq-2.90/src/dnsmasq" to "${dest}/usr/sbin/dnsmasq"
        chmod 0755 "${dest}/usr/sbin/dnsmasq"
        write "${dest}/etc/passwd" "root:x:0:0:root:/root:/bin/sh\n"
        write "${dest}/etc/group" "root:x:0:\n"
        require file "${dest}/usr/sbin/dnsmasq" {
            exists
            nonempty
        }
        # The options line lists "nftset" when it is built in and
        # "no-nftset" when it is not; the leading space tells them apart.
        run "${dest}/usr/sbin/dnsmasq" {
            "--version"
            stdout file "${build}/dnsmasq-version.txt"
        }
        run "grep" {
            "-q"
            " nftset"
            "${build}/dnsmasq-version.txt"
        }
    }
}
