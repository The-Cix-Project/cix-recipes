# dosfstools -- mkfs.fat, which the installer uses to make the EFI
# system partition. Converted from build.sh to build.cbs (ADR-0305
# stage 4, cix#487).
#
# WHAT CHANGES: usr/share/{man,doc} are no longer deleted (ADR-0306,
# cix#491).
#
# The DT_NEEDED check survives the conversion because
# `stdout file` exists now (cix-build-system#185). The shell form
# captured readelf's output into a variable and ran it through a
# `case`; the whole shape -- a command printing many lines, matched
# against a pattern -- had no CPDL equivalent, which is why this
# package waited.
#
# It is a weak check and it is kept honestly rather than dressed up:
# every dynamically linked ELF names libc, so what this actually
# catches is a build that went STATIC, which would name nothing.
# That matters because ADR-0251's install-time gate reads DT_NEEDED
# to compare declared against actual, and a static binary declares
# nothing undeclared -- it passes. Same blind spot iw's assertion
# covers, for the same reason.
package "dosfstools" {
    version "4.2"
    release 4
    format "cixpkg"

    sources {
        main "dosfstools" {
            url "https://github.com/dosfstools/dosfstools/releases/download/v4.2/dosfstools-4.2.tar.gz"
            sha256 "64926eebf90092dca21b14259a5301b7b98e7b1943e8a201c7d726084809b527"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "bash"
            tool "coreutils"
            tool "make"
            tool "linux-headers"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "pkgconf"
            tool "findutils"
            tool "diffutils"
        }
    }

    metadata {
        "artifact_sha256" "803c68ceff63caaae2c838be6d215e0ab823ca3bfe6c41d7e04e5840fa01eef9"
        "artifact_sha256.dosfstools-extra" "01f98bd6aaa3b0cd3bb743a26a4332abcef65dfaadaafe84d30d21d9ae298ec1"
        "changelog" "4.2-4: mkfs.fat, fatlabel, their man pages and the docs move to a dosfstools-extra output; dosfstools keeps fsck.fat, the one the control-plane root runs (include/controlplane_programs.h). The installer ISO takes mkfs.fat from the iso-builder image, which declares dosfstools-extra (ADR-0371 decision E and the owner's 2026-11-10 decision to split the tool packages, cix#350)."
    }

    # The owner's 2026-11-10 decision to split the tool packages too
    # (ADR-0371): the control-plane root runs fsck.fat only. mkfs.fat
    # formats an ESP from the installer ISO, which takes it from the
    # iso-builder image (mkinstalleriso.c), never from the root.
    output "dosfstools-extra" {
        files {
            "usr/sbin/fatlabel"
            "usr/sbin/mkfs.fat"
            "usr/share/man/man8/fatlabel.8"
            "usr/share/man/man8/mkfs.fat.8"
            "usr/share/doc/dosfstools"
        }
    }

    build {
        cd "${src}/dosfstools/dosfstools-4.2" {
            run "./configure" {
                "--prefix=/usr"
                "--sbindir=/usr/sbin"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/dosfstools/dosfstools-4.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/sbin/mkfs.fat" {
            exists
            nonempty
        }
        run "readelf" {
            "-d"
            "${dest}/usr/sbin/mkfs.fat"
            stdout file "${src}/dosfstools/needed.txt"
        }
        require file "${src}/dosfstools/needed.txt" {
            exists
            contains "libc.so.6"
        }
    }
}
