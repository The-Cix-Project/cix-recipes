# git. Converted from build.sh to build.cbs (ADR-0305 stage 4,
# cix#487).
#
# NOTHING TO RESTORE under cix#491: this recipe never deleted
# anything.
#
# THE FUZZ_OBJS STRIP IS WHY THIS WAITED. The shell form was a regex
# sed with an anchored .* --
#
#   sed -i 's|^FUZZ_OBJS += .*$||' Makefile
#
# -- and CPDL's replace is literal only. `until line` (cbs#177) is
# that pattern as an operation: match the literal prefix and
# everything after it up to the newline, which is exactly what
# `^FUZZ_OBJS += .*$` meant. The delimiter is never part of the
# match, so the line ending survives and the Makefile keeps its
# shape.
#
# The grep-after-the-sed guard is gone, as the recipe guide
# prescribes: `exactly N` refuses to mutate anything unless the count
# matches and names the file and the number when it does not, which
# is strictly more than the grep did.
#
# `exactly 9` is MEASURED. 2.55.0-9 claimed 1 and the build answered
# "expected 1 matches but found 9" -- git's Makefile appends to
# FUZZ_OBJS nine times, which the shell's global sed did silently and
# recorded nowhere. Now a tenth appearing, or one of the nine going
# away, fails the build instead of being stripped unnoticed.
#
# -D__STDC_NO_VLA__=1: glibc's regex.h sizes regexec()'s match array
# with a C99 VLA-in-prototype expression TCC's parser rejects, and
# the header has an explicit branch for a compiler without VLA
# support, which TCC genuinely is.
package "git" {
    version "2.55.0"
    release 10
    format "cixpkg"

    sources {
        main "git" {
            url "https://www.kernel.org/pub/software/scm/git/git-2.55.0.tar.xz"
            sha256 "457fdb04dc8728e007d4688695e6912e6f680727920f2a40bf11eacc17505357"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "zlib"
            tool "perl"
            tool "tar"
        }
        runtime {
            package "zlib"
        }
    }

    metadata {
        "changelog" "2.55.0-10: the FUZZ_OBJS strip is exactly 9, measured -- 2.55.0-9 claimed 1 and the build answered expected 1 but found 9. git appends to FUZZ_OBJS nine times and the shell global sed recorded that nowhere. 2.55.0-9: converted to build.cbs (ADR-0305) as a .cixpkg (ADR-0307); the strip uses until line (cbs#177), which is what the anchored regex sed meant, and the grep-after guard goes since exactly N is strictly more."
    }

    build {
        cd "${src}/git/git-2.55.0" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
                env "CPPFLAGS" = "-D__STDC_NO_VLA__=1"
            }
            replace "${src}/git/git-2.55.0/Makefile" {
                from "FUZZ_OBJS += "
                until line
                to ""
                exactly 9
            }
            run "make" {
                jobs $jobs
                "NO_RUST=1"
                "NO_GETTEXT=1"
                "NO_TCLTK=1"
            }
        }
    }

    install {
        cd "${src}/git/git-2.55.0" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
                "prefix=/usr"
                "NO_RUST=1"
                "NO_GETTEXT=1"
                "NO_TCLTK=1"
            }
        }
        require file "${dest}/usr/bin/git" {
            exists
            nonempty
        }
    }
}
