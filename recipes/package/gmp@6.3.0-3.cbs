# GMP -- the multiple-precision arithmetic library nftables links.
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
#
# WHAT CHANGES:
#
#   usr/share/{info,man} -- no longer deleted (ADR-0306, cix#491).
#   usr/lib/*.la         -- not translated: --disable-static means
#                           none is built, finalize drops any anyway,
#                           and `remove glob` FAILS on a glob that
#                           matches nothing where `rm -f` shrugged
#                           (cix-build-system#188).
#   four diagnostic prints -- gone. An `echo` of what configure
#                           decided, a `find` of what shipped, and a
#                           `readelf | grep NEEDED || true`: all
#                           printed to the build log and none could
#                           fail a build.
#
# THE SHARED-LIBRARY GUARD IS THE ONE THAT MATTERS and it changes
# shape. The shell form was `ls usr/lib/libgmp.so.* || exit 1` -- a
# glob, because the recipe did not want to name a version. CPDL
# cannot bind a glob match to anything (cix-build-system#192), so
# this names the file: libgmp.so.10.5.0, which is what GMP 6.3.0's
# own libtool -version-info produces.
#
# That is DERIVED, not measured -- gmp is installed in no image, so
# there was nothing to read the name off. If GMP ever changes its
# interface number the assertion fails loudly and names the file it
# wanted, which is the right failure: a soname change is exactly the
# thing a consumer needs to be told about.
#
# Why the guard exists at all: a silent fall back to static-only
# installs cleanly and fails much later at the consumer, blaming gmp
# for being absent when it is present (cix#113). nftables links it.
package "gmp" {
    version "6.3.0"
    release 3
    format "cixpkg"

    sources {
        main "gmp" {
            url "https://gmplib.org/download/gmp/gmp-6.3.0.tar.xz"
            sha256 "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "m4"
        }
    }

    metadata {
        "artifact_sha256" "08f2b396fd4cecc23dad60a25f1cb751d6088476f4c0ff2282c711caa1b3251e"
        "changelog" "6.3.0-3: converted to build.cbs (ADR-0305 stage 4) as a .cixpkg (ADR-0307). Same tarball and configure line. Keeps usr/share/{info,man} (cix#491); drops four diagnostic prints that could not fail a build. The shared-library guard was ls libgmp.so.* and now names libgmp.so.10.5.0, CPDL having no way to bind a glob match (cix-build-system#192) -- derived from GMP 6.3.0 libtool version-info rather than measured, since gmp is installed nowhere to read it off."
    }

    build {
        cd "${src}/gmp/gmp-6.3.0" {
            # --disable-assembly: GMP is unusually opinionated about
            # its assembly paths and this sandbox's compiler is not
            # one it knows.
            run "./configure" {
                "--prefix=/usr"
                "--disable-assembly"
                "--disable-static"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/gmp/gmp-6.3.0" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/lib/libgmp.so.10.5.0" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/gmp.h" {
            exists
            nonempty
        }
        # gmp.pc is generated by configure and describes exactly the
        # header and library above, so it is a true claim and ships.
        # nftables uses AC_CHECK_LIB rather than pkg-config, but
        # other consumers do use it.
        require file "${dest}/usr/lib/pkgconfig/gmp.pc" {
            exists
            nonempty
        }
    }
}
