# hostapd -- the 802.11 access point daemon the wifi_router image
# runs, built against OpenWrt libnl-tiny rather than full libnl.
#
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
#
# THE SECOND SOURCE STOPS BEING A MANUAL UNPACK. The shell form
# listed /build/extra, picked the first entry, tar xzf it, listed
# libnl-tiny-* to find what came out, and mv it to a fixed name --
# five steps and three failure messages, all of which existed
# because ADR-0036 hands a non-first source to the recipe as an
# opaque file. CBS extracts every declared source into $src/<name>/,
# so the tarball is already unpacked; the only unknown left is the
# directory name, which carries the pinned commit hash, and
# `glob "nltiny" = ...` binds it. That operation requires exactly one
# match by default, so a tarball that ever produced two top-level
# directories fails here rather than silently picking one.
#
# ALL THREE WORKAROUNDS 2.11-11 CARRIED ARE GONE, because cbs
# v0.1.34 landed the three operations they stood in for. They were
# tracked in cix#509 and this revision is what that list is for.
#
#   cbs#207  the libnl-tiny link line was hidden in a generated
#            makefile so `make` could expand *.c. `args glob` puts
#            it back in one `run` that says what it does.
#   cbs#208  the toolwrap rebuilt its argument list through the
#            positional parameters, because a block string
#            containing dollar-brace was refused at publish. The
#            bash array is back.
#   cbs#209  the glob binding was declared twice, once per phase.
#            One declaration now, used in both.
#
# Worth recording that none of the three was discovered by reading
# the specification: each was found by a recipe failing, filed the
# same day, fixed and tagged the same day. The workaround list
# existed so they would not survive by inertia, and this is it
# working.
#
# THE TOOLWRAP IS GONE, AND WITH IT THE LAST SHELL IN THIS RECIPE.
# Every earlier revision fabricated a bash script that rewrote -MMD
# to -MD and exec'd tcc, because TCC rejects -MMD outright. That
# wrapper was also the sole proposed user of CBS's `compiler
# rewrite` verb (cbs#219), so what the flag actually is decided
# whether that verb has any user at all.
#
# Measured on 192.168.15.95, 2026-09-22, by probe-hostapd-mmd@4
# against this exact tarball -- -MMD appears ONCE in the whole
# hostapd tree:
#
#   ./src/build.rules:34:CFLAGS = -MMD -O2 -Wall -g
#
# It is a plain literal in hostapd's own build file. Editing a
# third-party build file is the commonest thing recipes here do --
# libnl strips -Wl,--version-script from seven generated makefiles,
# libcap strips a prioritised constructor attribute, nss-pam-ldapd
# rewrites two link lines -- so this needs no new language feature
# and no interposed executable, only the `replace` CPDL has had all
# along. `exactly 1` is the measurement, asserted: a future hostapd
# that moves or duplicates the flag fails here rather than silently
# building with a wrapper that no longer covers it.
#
# BASH STAYS, AND THE REASON IS NOT THE ONE 2.11-15 AND 2.11-16
# GAVE. 2.11-14 dropped `tool "bash"` with the wrapper, on the
# reasoning that the script was its only user, and was killed by
# signal 14 -- a timeout. 2.11-15 asserted a missing /bin/sh under
# make as the cause; 2.11-16 withdrew that as unmeasured and left
# the cause open. It is measurable, and the whole of it is in an
# 80-byte retained build log (192.168.15.95, 2026-09-22,
# `cixctl pkg build-logs --file=hostapd-2.11-14-1790102435.log`):
#
#   cix-init: execve(/usr/bin/bash) failed, errno 2
#   cix-init: oneshot failed: build
#
# The build container's own PID 1 could not start the build phase
# at all. Nothing in this recipe ran -- not make, not the first
# operation. So bash is a precondition of a build phase EXECUTING,
# not a dependency of what the phase invokes, which is why every
# make-using recipe in this corpus declares it and why dropping it
# alongside a bash script was wrong even though the script really
# was the only thing in the recipe that named bash.
#
# Two things worth carrying away. The failure presents as a
# timeout, so it reads as a slow build rather than a missing tool;
# the discriminator is the log SIZE, 80 bytes against 4162 for a
# build that ran. And `cixctl pkg build-logs` retains these --
# `pkg build-log` (singular) is live-only and 404s the moment a run
# ends, which cost four probe runs to learn before the retained
# store was noticed in the same help output.
#
# -MD rather than deletion, deliberately. Deleting -MMD would also
# stop dependency generation, which is a second change this recipe
# has no reason to make; -MD is what the wrapper substituted, so
# the compile line is byte-identical to the revision this replaces.
#
package "hostapd" {
    version "2.11"
    release 17
    format "cixpkg"

    sources {
        main "hostapd" {
            url "https://w1.fi/releases/hostapd-2.11.tar.gz"
            sha256 "2b3facb632fd4f65e32f4bf82a76b4b72c501f995a4f62e330219fe7aed1747a"
        }
        extra "libnltiny" {
            url "https://codeload.github.com/openwrt/libnl-tiny/tar.gz/40493a655d8caa2ccf5206dde1e733abe2920432"
            sha256 "a3f0456006b72352f0ccc9a653eb2428a03bc3ff3c6987a858b0c060ac19b181"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
        tool "bash"
            tool "linux-headers"
                    tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "openssl"
        }
        runtime {
            package "openssl"
        }
    }

    metadata {
        "changelog" "2.11-17: names the measured cause of 2.11-14 failure, which 2.11-15 guessed wrong and 2.11-16 left open. The retained build log shows cix-init execve(/usr/bin/bash) failed errno 2 -- the build container PID 1 could not start the phase, so nothing in the recipe ran. bash is a precondition of a build phase executing, not a dependency of make."
    }

    build {
        # EXTRACTED EXPLICITLY, AND THE GLOB IS GONE. Through
        # v0.1.33 CBS extracted every declared source at prepare
        # time, so an extra source arrived already unpacked under a
        # directory named for the pinned commit, and the only way to
        # reach it was to bind that name with a glob. v0.1.34 makes
        # the spec true -- an extra source "remains a named verified
        # input until an explicit extract or materialize operation
        # uses it" -- and `as` renames the archive's single top-level
        # directory on the way in. So the path is chosen here rather
        # than discovered, and 2.11-12's binding found zero matches:
        #
        #   error[CPDL-E4005]: glob binding expected 1 matches but found 0
        extract $source.libnltiny into "${src}" as "nltiny"
        mkdir "${src}/nltiny/build"
        # One command again. cbs#207 landed `args glob`, so the
        # link line says what it does instead of hiding in a
        # generated makefile. `exactly` is deliberately omitted: the
        # file count of a pinned upstream commit is not a fact this
        # recipe should assert, only that there is at least one.
        cd "${src}/nltiny" {
            run "tcc" {
                "-shared"
                "-Wall"
                "-Iinclude"
                args glob "${src}/nltiny/*.c"
                "-o"
                "build/libnl-tiny.so"
            }
        }
        require file "${src}/nltiny/build/libnl-tiny.so" {
            exists
            nonempty
        }
        copy "${src}/hostapd/hostapd-2.11/hostapd/defconfig" to "${src}/hostapd/hostapd-2.11/hostapd/.config"
        # The TLS line is rewritten AND carries the three appends,
        # because CPDL has no append-to-file operation.
        replace "${src}/hostapd/hostapd-2.11/hostapd/.config" {
            from "#CONFIG_TLS=openssl"
            to "CONFIG_TLS=openssl\nCONFIG_LIBNL_TINY=y\nCFLAGS += -I${src}/nltiny/include -D_GNU_SOURCE\nLDFLAGS += -L${src}/nltiny/build"
            exactly 1
        }
        replace "${src}/hostapd/hostapd-2.11/hostapd/.config" {
            from "CONFIG_LIBNL32=y"
            to "#CONFIG_LIBNL32=y"
            exactly 1
        }
        # The one token the toolwrap existed for.
        replace "${src}/hostapd/hostapd-2.11/src/build.rules" {
            from "-MMD"
            to "-MD"
            exactly 1
        }
        cd "${src}/hostapd/hostapd-2.11/hostapd" {
            # No `jobs` directive, so make runs a single job --
            # its own default when nothing passes -j, and
            # deliberate: hostapd's makefile is not parallel-safe
            # here. `jobs $jobs` is how the corpus asks for
            # parallelism, so its absence is the -j1 this says.
            run "make" {
                "CC=tcc"
            }
        }
    }

    install {
        mkdir "${dest}/usr/bin"
        mkdir "${dest}/usr/lib"
        copy "${src}/hostapd/hostapd-2.11/hostapd/hostapd" to "${dest}/usr/bin/hostapd"
        copy "${src}/hostapd/hostapd-2.11/hostapd/hostapd_cli" to "${dest}/usr/bin/hostapd_cli"
        copy "${src}/nltiny/build/libnl-tiny.so" to "${dest}/usr/lib/libnl-tiny.so"
        require file "${dest}/usr/bin/hostapd" {
            exists
            executable
        }
        require file "${dest}/usr/bin/hostapd_cli" {
            exists
            executable
        }
        require file "${dest}/usr/lib/libnl-tiny.so" {
            exists
            nonempty
        }
    }
}
