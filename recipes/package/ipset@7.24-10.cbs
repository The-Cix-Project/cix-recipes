# ipset -- the kernel IP-set CLI and library keepalived links.
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
#
# WHAT CHANGES:
#
#   usr/share/man   -- no longer deleted (ADR-0306, cix#491).
#   usr/lib/*.la    -- not translated; finalize drops every .la and
#                      `remove glob` fails on a glob matching nothing
#                      (cbs#188).
#   two diagnostic prints -- gone. A `find` of what shipped and a
#                      readelf dump: both printed to the build log
#                      and neither could fail a build.
#
# THE VERSION-SCRIPT STRIP NOW TOUCHES ONE FILE, MEASURED. The shell
# ran its sed over lib/Makefile AND src/Makefile with `2>/dev/null
# || true`, so a file with no match was silently fine. Counted in
# the release tarball before writing this: lib/Makefile.in carries
# the flag once and src/Makefile.in not at all, so the src half was
# always a no-op and `replace`, which fails on zero matches, would
# have failed on it.
#
# Only the `=` spelling occurs; the shell's character class also
# allowed `-Wl,--version-script,` and nothing in this tarball uses
# it. `until whitespace` (cbs#177) takes the flag and its argument
# together without a pattern language.
#
# The `grep … && exit 1` that followed the sed is gone, as the
# recipe guide prescribes -- `exactly 1` is that guard and names the
# file.
#
# TCC cannot honour --version-script, which is why any of this
# exists.
package "ipset" {
    version "7.24"
    release 10
    format "cixpkg"

    sources {
        main "ipset" {
            url "https://deb.debian.org/debian/pool/main/i/ipset/ipset_7.24.orig.tar.bz2"
            sha256 "fbe3424dff222c1cb5e5c34d38b64524b2217ce80226c14fdcbb13b29ea36112"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "libmnl"
            # bzip2, for the SOURCE: this is a .tar.bz2 and cbs's
            # libarchive shells out to decompress it. gnu-efi failed
            # exactly this way before reaching a compile.
            tool "bzip2"
        }
        runtime {
            package "libmnl"
        }
    }

    metadata {
        "artifact_sha256" "f1a1b6ff7420fa730913ac362c138e0f5207ffefc4134c5fe3b4c5010045e602"
        "changelog" "7.24-10: converted to build.cbs (ADR-0305 stage 4) as a .cixpkg (ADR-0307). Same tarball and configure line. Keeps usr/share/man (cix#491) and drops two diagnostic prints that could not fail a build. The version-script strip is one file and exactly 1, measured from the tarball: lib/Makefile.in carries the flag once and src/Makefile.in not at all, so the shell second sed target was always a no-op. Declares bzip2, needed to decompress the source itself."
    }

    build {
        cd "${src}/ipset/ipset-7.24" {
            run "./configure" {
                "--prefix=/usr"
                "--with-kmod=no"
                env "CC" = "tcc"
                env "PKG_CONFIG_PATH" = "/usr/lib/pkgconfig:/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig"
            }
            replace "${src}/ipset/ipset-7.24/lib/Makefile" {
                from "-Wl,--version-script="
                until whitespace
                to ""
                exactly 1
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/ipset/ipset-7.24" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # The real file, not the soname link: require file matches
        # regular files only (cbs#175).
        require file "${dest}/usr/lib/libipset.so.13.4.0" {
            exists
            nonempty
        }
        require symlink "${dest}/usr/lib/libipset.so.13" {
            exists
            target "libipset.so.13.4.0"
        }
        require file "${dest}/usr/lib/pkgconfig/libipset.pc" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/libipset/session.h" {
            exists
            nonempty
        }
        # Really linked against Cix's libmnl, not resolved some other
        # way (cix#113).
        run "readelf" {
            "-d"
            "${dest}/usr/sbin/ipset"
            stdout file "${src}/ipset/needed.txt"
        }
        require file "${src}/ipset/needed.txt" {
            exists
            contains "libmnl.so.0"
        }
    }
}
