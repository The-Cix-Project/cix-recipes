# isc-dhcp -- ISC dhcpd, the DHCP server for the dhcp-1/dhcp-2 pair,
# which serve every range in failover, load-balancing (cix#107).
#
# ISC ended maintenance of ISC DHCP with 4.4.3-P1 in October 2022
# (https://isc.org/blogs/isc-dhcp-eol/). It is chosen anyway, by the
# owner on 2026-11-20 over Kea, because it is the one small server with
# a real active-active failover protocol. Being frozen means a security
# fix found in it is ours to carry in this recipe.
#
# Only the server is shipped. The client and the relay are built by the
# same make (nothing can stop them) and left out: cix has its own
# client, and relays are dnsmasq (ADR-0383).
#
# The tarball carries its own BIND 9.11 export libraries
# (bind/bind.tar.gz), which make unpacks with gunzip and tar and links
# statically, so the server needs nothing from the bind-utils package.
package "isc-dhcp" {
    version "4.4.3-P1"
    release 2
    format "cixpkg"

    sources {
        main "isc-dhcp" {
            url "https://downloads.isc.org/isc/dhcp/4.4.3-P1/dhcp-4.4.3-P1.tar.gz"
            sha256 "0ac416bb55997ca8632174fd10737fd61cdb8dba2752160a335775bc21dc73c7"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "tar"
            tool "gzip"
        }
    }

    metadata {
        "changelog" "4.4.3-P1-2: unpacks bind/bind.tar.gz with tar -z before make, which runs a tar that refused it (Archive is compressed. Use -z option) (cix#107)."
    }

    build {
        cd "${src}/isc-dhcp/dhcp-4.4.3-P1" {
            run "./configure" {
                "--prefix=/usr"
                "--sysconfdir=/etc"
                "--localstatedir=/var"
                "--with-srv-lease-file=/var/lib/dhcp/dhcpd.leases"
                "--with-srv-pid-file=/run/dhcpd.pid"
                "--disable-dhcpv6"
                env "CC" = "tcc"
            }
        }
        cd "${src}/isc-dhcp/dhcp-4.4.3-P1/bind" {
            run "tar" {
                "-xzf"
                "bind.tar.gz"
            }
        }
        cd "${src}/isc-dhcp/dhcp-4.4.3-P1" {
            run "make" {
                jobs $jobs
            }
        }
        on_fail {
            run "ls" {
                "-la"
                "${src}/isc-dhcp/dhcp-4.4.3-P1/bind"
                allow_failure
            }
            run "sed" {
                "-n"
                "20,80p"
                "${src}/isc-dhcp/dhcp-4.4.3-P1/bind/Makefile"
                allow_failure
            }
        }
    }

    install {
        mkdir "${dest}/usr/sbin" parents chmod 0755
        copy "${src}/isc-dhcp/dhcp-4.4.3-P1/server/dhcpd" to "${dest}/usr/sbin/dhcpd"
        chmod 0755 "${dest}/usr/sbin/dhcpd"
        require file "${dest}/usr/sbin/dhcpd" {
            exists
            nonempty
        }
    }
}
