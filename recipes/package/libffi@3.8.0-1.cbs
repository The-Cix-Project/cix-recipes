#
# libffi -- a portable foreign function interface. (cix#584)
#
# WHY IT IS HERE. glib needs it for GObject closures, and glib is
# qemu's one hard library dependency, so this is the first leaf of the
# chain cix#584 needs for a QEMU boot test to run on a Cix host.
#
# TCC FIRST, which is ADR-0224's rule and not optimism: libffi leans
# on inline assembly and visibility attributes, so it is a fair test
# of the compiler rather than a formality. If TCC cannot do it the
# move to gcc is ordinary (ADR-0226) and gets a dated reason.
#
# --disable-static because nothing here links a .a, and
# --disable-docs because the texinfo toolchain is not in this build
# image and the documentation is not what glib wants.
#
# --libdir=/usr/lib EXPLICITLY. libffi's configure has a
# multi-os-directory notion that can land a library in /usr/lib64 on
# x86_64, and every other package in this corpus installs to
# /usr/lib -- a second library directory would be a path nothing else
# looks in.
#
package "libffi" {
    version "3.8.0"
    release 1
    format "cixpkg"

    license "MIT"

    sources {
        main "libffi" {
            url "https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz"
            sha256 "7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "changelog" "3.8.0-1: first revision. glib needs libffi for GObject closures and glib is qemu's one hard library dependency, so this is the first leaf of the chain a QEMU boot test on a Cix host needs (cix#584). sha256 measured on this box by probe-libffi-tarball@1-1. Built with tcc per ADR-0224; --libdir=/usr/lib explicitly, because libffi's multi-os-directory notion can otherwise land the library in /usr/lib64."
    }

    prepare {
        require directory "${src}/libffi/libffi-3.8.0" {
            exists
        }
    }

    build {
        cd "${src}/libffi/libffi-3.8.0" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-static"
                "--disable-docs"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/libffi/libffi-3.8.0" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/lib/libffi.so" {
            exists
        }
        require file "${dest}/usr/lib/pkgconfig/libffi.pc" {
            exists
            nonempty
        }
    }
}
