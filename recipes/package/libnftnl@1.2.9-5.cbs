# libnftnl -- the netlink library nftables and keepalived link.
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
#
# THIS IS THE FIRST RECIPE HERE TO USE `links` (cbs#194), and it is
# the clearest case for why that operation was worth asking for.
# Everything below replaced a shell guard that either could not be
# written in CPDL at all, or took four lines to say.
#
# WHAT CHANGES:
#
#   usr/lib/*.la     -- not translated. --disable-static builds none,
#                       finalize drops any, and `remove glob` fails
#                       on a glob matching nothing.
#   the DT_NEEDED check -- `readelf -d | grep -q NEEDED.*libmnl` and
#                       a separate diagnostic readelf become one
#                       `links { needs }` declaration.
#   the three `test -e` -- become `require file`.
#   the before/after continuation count -- GONE, and deliberately.
#                       The shell recipe counted backslash-newline
#                       continuations across every Makefile before
#                       and after the strip, because its sed had
#                       once eaten a TAB and a line-continuation and
#                       orphaned the following line. `replace …
#                       exactly N` is that guard: it counts matches,
#                       refuses to mutate unless the count is right,
#                       and names the file. The recipe guide says to
#                       delete a count-guard around an edit for
#                       exactly this reason.
#
# THE VERSION-SCRIPT STRIP is what cbs#177 was filed for. TCC cannot
# honour --version-script and src/Makefile.am passes one
# unconditionally. The shell form needed a character class of
# [^[:space:]] rather than [^ ], because the real line ends in a TAB
# and a backslash, and using [^ ] deleted both and killed the -1
# revision with "recipe commences before first target" four
# directories deep. `until whitespace` is that rule as an operation:
# the delimiter is never part of the match.
#
# `exactly 6` is a CLAIM. The shell used a global sed across every
# Makefile and recorded no number. If it is wrong the build says
# "expected 6 matches but found N", which is how the real count gets
# written down instead of being lost again.
package "libnftnl" {
    version "1.2.9"
    release 5
    format "cixpkg"

    sources {
        main "libnftnl" {
            url "https://www.netfilter.org/projects/libnftnl/files/libnftnl-1.2.9.tar.xz"
            sha256 "e8c216255e129f26270639fee7775265665a31b11aa920253c3e5d5d62dfc4b8"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "pkgconf"
            tool "libmnl"
        }
        runtime {
            package "libmnl"
        }
    }

    metadata {
        "changelog" "1.2.9-5: converted to build.cbs (ADR-0305 stage 4) as a .cixpkg (ADR-0307). First recipe here to use links (cbs#194): a readelf-and-grep DT_NEEDED check plus a diagnostic readelf become one declaration. The version-script strip uses until whitespace (cbs#177), which is that rule as an operation -- the shell needed [^[:space:]] because the real line ends in a TAB and a backslash, and [^ ] deleted both and killed the -1 revision. The before/after continuation count goes: replace exactly N is that guard."
    }

    build {
        cd "${src}/libnftnl/libnftnl-1.2.9" {
            run "pkg-config" {
                "--exists"
                "libmnl"
                env "PKG_CONFIG_PATH" = "/usr/lib/pkgconfig:/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig"
            }
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-static"
                env "CC" = "tcc"
                env "PKG_CONFIG_PATH" = "/usr/lib/pkgconfig:/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig"
            }
            replace glob "${src}/libnftnl/libnftnl-1.2.9/**/Makefile" {
                from "-Wl,--version-script="
                until whitespace
                to ""
                exactly 6
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/libnftnl/libnftnl-1.2.9" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/lib/libnftnl.so.11" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/libnftnl/rule.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/libnftnl.pc" {
            exists
            nonempty
        }
        # It must really be linked against Cix's libmnl, not have
        # quietly resolved the symbols some other way (cix#113).
        links "${dest}/usr/lib/libnftnl.so.11" {
            needs "libmnl.so.0"
        }
    }
}
