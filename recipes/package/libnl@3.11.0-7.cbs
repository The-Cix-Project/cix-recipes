# libnl -- the netlink protocol library suite (libnl-3, libnl-genl-3,
# libnl-route-3 and friends). iw, hostapd and keepalived all link it.
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
#
# THIS IS THE FIRST RECIPE HERE TO USE A BLOCK STRING, and the reason
# is the compatibility header below: a 60-line C file that the shell
# form wrote with a heredoc. Written as a quoted string with \n
# escapes it would be one unreadable line, which is precisely the
# case CPDL's block string says it is for ("generated files and
# source-edit text"). No escapes or interpolation are processed
# inside one, so the C stays byte-for-byte what the heredoc emitted.
#
# WHAT CHANGES:
#
#   the heredoc      -- becomes `write` with a block string, in a
#                       prepare phase, the same shape bind-utils
#                       uses for its cc shim.
#   export CPPFLAGS  -- becomes `env` on configure. Autoconf
#                       substitutes CPPFLAGS into the generated
#                       Makefile, so the forced include survives
#                       into every compile without a second export.
#   find -exec sed   -- becomes `replace glob ... until whitespace`.
#   the find+grep guard -- GONE. `exactly 7` IS that guard: it
#                       counts, refuses to mutate on a mismatch, and
#                       names the file. The shell guard existed
#                       because the sed could silently match
#                       nothing; a count cannot.
#   mkdir usr/lib/pkgconfig -- GONE. make install creates it; the
#                       installed 3.11.0-6 carries six .pc files
#                       there, so the mkdir never did anything.
#   rm -f usr/lib/*.la  -- GONE. --disable-static builds none and
#                       finalize drops any; 3.11.0-6's 153 installed
#                       files include no .la at all, and `remove
#                       glob` fails on a glob matching nothing.
#   the five `test -e` -- become require file / require symlink.
#
# `exactly 7` IS MEASURED, not guessed. libnl is a non-recursive
# automake build: one Makefile.in, seven link lines, one per shared
# library (libnl-3, -route-3, -idiag-3, -genl-3, -nf-3, -xfrm-3,
# -cli-3), each passing -Wl,--version-script=$(srcdir)/NAME.sym.
# The cli line survives --disable-cli because automake resolves a
# conditional by commenting the line out, not by deleting it.
#
# THE SONAME TRAP (cix-build-system#175) applies here too: the real
# files are libnl-3.so.200.26.0 and libnl-genl-3.so.200.26.0, and
# .so.200 -- the name the shell recipe asserted, and the name a
# consumer knows -- is a symlink that `require file` refuses. Both
# halves are asserted now, which is strictly more than the shell
# form checked.
package "libnl" {
    version "3.11.0"
    release 7
    format "cixpkg"

    sources {
        main "libnl" {
            url "https://github.com/thom311/libnl/releases/download/libnl3_11_0/libnl-3.11.0.tar.gz"
            sha256 "2a56e1edefa3e68a7c00879496736fdbf62fc94ed3232c0baba127ecfa76874d"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            # libnl's route library carries a real generated parser
            # (lib/route/pktloc_syntax.y, pktloc_grammar.l). The
            # release tarball ships the pre-generated output, so
            # these may be unnecessary -- but a missing generator
            # surfaces as a confusing mid-build error rather than a
            # clean refusal, and this is the one package in this set
            # that has a grammar at all.
            tool "flex"
            tool "bison"
        }
    }

    metadata {
        "changelog" "3.11.0-7: converts to CPDL (cix#487). No build change: same source, same configure line, same seven version-script strips, same forced-include shim. The find+grep guard, the mkdir and the rm are dropped -- `exactly 7` is the guard, make install creates the pkgconfig directory, and 3.11.0-6 installed no .la. The five test -e become require file, and each soname assertion splits into the real file plus its symlink (cbs#175), more than the shell form checked. First block string here."
    }

    prepare {
        # TCC implements none of the four GCC builtins libnl uses, and
        # does not reject them either -- it emits each as an ordinary
        # undefined external, so the library links, installs and is
        # broken (cix#176). Confirmed by direct probe, not assumed:
        #
        #   __builtin_ffs       lib/route/link/bridge.c find_next_bit()
        #   __builtin_bswap16   \
        #   __builtin_bswap32    > libnl's bundled linux/swab.h
        #   __builtin_bswap64   /
        #
        # The 3.11.0-2 build shipped exactly that: configure, make and
        # make install all exited 0, and the daemon's install gate
        # refused the resulting libnl-route-3.so over an undefined
        # __builtin_ffs. A SHARED LIBRARY is what makes this silent --
        # an executable fails at link, but undefined symbols are legal
        # in a .so, so nothing complains until something calls one.
        write "${src}/libnl/libnl-3.11.0/tcc-builtins.h" """
        #ifndef CIX_TCC_BUILTINS_H
        #define CIX_TCC_BUILTINS_H
        #if !defined(__GNUC__)

        /*
         * No system headers here, deliberately. A forced-include header is
         * processed before the translation unit can define _GNU_SOURCE, so
         * including any libc header at this point latches glibc's
         * feature-test macros too early. That really happened: 3.11.0-3
         * included <strings.h> for ffs() and hid struct ucred from
         * nl-core.h, failing the build with "field 'nm_creds' has
         * incomplete type" -- an error naming nothing to do with builtins.
         *
         * Plain `static`, never `static inline`: TCC emits a static inline
         * function from a shared header as a strong global in every
         * translation unit, which is the "defined twice" failure m4 hit.
         */

        static __attribute__((unused)) int cix_ffs(unsigned int v)
        {
        	int i;
        	if (!v)
        		return 0;
        	for (i = 1; !(v & 1u); i++)
        		v >>= 1;
        	return i;
        }

        static __attribute__((unused)) unsigned short cix_bswap16(unsigned short v)
        {
        	return (unsigned short)((v >> 8) | (v << 8));
        }

        static __attribute__((unused)) unsigned int cix_bswap32(unsigned int v)
        {
        	return ((v & 0x000000FFu) << 24) | ((v & 0x0000FF00u) << 8) |
        	       ((v & 0x00FF0000u) >> 8)  | ((v & 0xFF000000u) >> 24);
        }

        static __attribute__((unused)) unsigned long long cix_bswap64(unsigned long long v)
        {
        	return ((unsigned long long)cix_bswap32((unsigned int)v) << 32) |
        	       (unsigned long long)cix_bswap32((unsigned int)(v >> 32));
        }

        #define __builtin_ffs(x)     cix_ffs((unsigned int)(x))
        #define __builtin_bswap16(x) cix_bswap16((unsigned short)(x))
        #define __builtin_bswap32(x) cix_bswap32((unsigned int)(x))
        #define __builtin_bswap64(x) cix_bswap64((unsigned long long)(x))
        #endif
        #endif
        """
    }

    build {
        cd "${src}/libnl/libnl-3.11.0" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-static"
                "--disable-cli"
                env "CC" = "tcc"
                env "CPPFLAGS" = "-include ${src}/libnl/libnl-3.11.0/tcc-builtins.h"
            }
            # TCC cannot honour --version-script; libmnl, libnftnl and
            # ipset all hit this, and it is in the recipe guide. The
            # GENERATED makefile is edited so upstream's own tree stays
            # unmodified. `until whitespace` is the rule the shell sed
            # needed a [^[:space:]] character class to express: the
            # delimiter is never part of the match, so a line ending in
            # a TAB and a backslash keeps both.
            replace glob "${src}/libnl/libnl-3.11.0/**/Makefile" {
                from "-Wl,--version-script="
                until whitespace
                to ""
                exactly 7
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/libnl/libnl-3.11.0" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # Assert what the three consumers actually need rather than
        # trusting that configure and make exited 0 (cix#113). iw,
        # hostapd and keepalived all link libnl-3 AND libnl-genl-3, so
        # a build producing only the core library would satisfy make
        # and still be useless to every one of them.
        require file "${dest}/usr/lib/libnl-3.so.200.26.0" {
            exists
            nonempty
        }
        require symlink "${dest}/usr/lib/libnl-3.so.200" {
            exists
            target "libnl-3.so.200.26.0"
        }
        require file "${dest}/usr/lib/libnl-genl-3.so.200.26.0" {
            exists
            nonempty
        }
        require symlink "${dest}/usr/lib/libnl-genl-3.so.200" {
            exists
            target "libnl-genl-3.so.200.26.0"
        }
        require file "${dest}/usr/include/libnl3/netlink/netlink.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/libnl-3.0.pc" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/libnl-genl-3.0.pc" {
            exists
            nonempty
        }
    }
}
