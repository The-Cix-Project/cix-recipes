#
# libslirp -- user-mode networking for qemu's -netdev user. (cix#584)
#
# WHY IT IS HERE. qemu needs libslirp for `-netdev user`, and
# test_disk_image.c's with_nic case uses exactly that. qemu@11.1.2-2
# is deliberately built --disable-slirp so that everything which does
# not need a NIC could land first; this is what lifts that stated gap,
# and the qemu revision that follows it re-enables slirp.
#
# THE VERSION WAS MEASURED, NOT READ. libslirp lives on
# gitlab.freedesktop.org, whose tag listing is rendered by javascript,
# so nothing could read it directly. Five candidate versions were
# probed at once instead (probe-slirp480/490/491/492/4100-tarball):
# v4.8.0, v4.9.0, v4.9.1 and v4.9.2 all answered with a checksum
# mismatch, which proves existence and gives the sha256 in one go,
# while v4.10.0 answered a real HTTP 404 rather than a resolver
# failure. So 4.9.2 is the newest release, established rather than
# assumed.
#
# gcc, BECAUSE MESON REFUSES TCC: "Unknown compiler(s): [['tcc']]",
# before any source file is read. Measured by pixman@0.46.4-1 on this
# box; it is the build system's limit rather than this package's.
#
# THE GATE NAMES NO VERSION, because a soname's library version is not
# predictable from the package version -- libffi 3.8.0 ships
# .so.8.5.0, and gating on a guessed one costs a build cycle. slirp.pc
# is called that whatever the release.
#
package "libslirp" {
    version "4.9.2"
    release 1
    format "cixpkg"

    license "BSD-3-Clause"

    sources {
        main "libslirp" {
            url "https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v4.9.2/libslirp-v4.9.2.tar.gz"
            sha256 "fb3c0d3db56174016c96803882378e262e5b59a7bd38feb107d915a79aad5288"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "meson"
            tool "ninja"
            tool "python"
            tool "pkgconf"
            tool "glib"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "binutils"
        }
        runtime {
            package "glib"
        }
    }

    toolchain "gcc" {
        reason "meson does not recognise this tcc at all: 'Unknown compiler(s): [[tcc]]', before any source file is read, because it identifies a compiler from its version output and has no matcher for it. The build system's limit rather than libslirp's. Measured on 192.168.15.95, 2026-10-09 by pixman@0.46.4-1."
    }

    metadata {
        "changelog" "4.9.2-1: first revision. qemu needs libslirp for -netdev user, which test_disk_image.c's with_nic case uses; qemu@11.1.2-2 was built --disable-slirp so the rest could land, and this lifts that gap. The version was measured rather than read: gitlab's tag list is javascript-rendered, so five candidates were probed at once and v4.10.0 answered a real 404 while v4.9.2 existed (cix#584)."
    }

    prepare {
        require directory "${src}/libslirp/libslirp-v4.9.2" {
            exists
        }
        require file "${src}/libslirp/libslirp-v4.9.2/meson.build" {
            exists
            nonempty
        }
    }

    build {
        cd "${src}/libslirp/libslirp-v4.9.2" {
            run "meson" {
                "setup"
                "build"
                "--prefix=/usr"
                "--libdir=lib"
                "--buildtype=release"
                "-Ddefault_library=shared"
                env "CC" = "/usr/bin/gcc"
            }
            run "ninja" {
                "-C"
                "build"
            }
        }
    }

    install {
        cd "${src}/libslirp/libslirp-v4.9.2" {
            run "meson" {
                "install"
                "-C"
                "build"
                "--destdir"
                "${dest}"
            }
        }
        require file "${dest}/usr/lib/pkgconfig/slirp.pc" {
            exists
            nonempty
        }
    }
}
