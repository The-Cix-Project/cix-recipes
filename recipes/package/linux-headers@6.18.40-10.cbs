# 6.18.40-8 replaces the last shell escape in this recipe. See the
# install phase: `copy tree` (cix-build-system#186) is now a real
# operation, so the `run "cp" { "-a" ... }` that 6.18.40-7 carried --
# a shell command inside a declarative phase, with none of what CPDL
# is for -- is gone.
#
# 6.18.40-6 is published and was never built, and the reason was NOT
# the mirror. /var/lib/cix filled up during its first build attempt
# and every failure after that was collateral:
#
#   attempt 1  reached the BUILD stage, exit 3, 65-byte log holding
#              only the source digest -- the log could not be written
#   attempts 2-4  `fetch failed (curl exit status 1)` -- a ~150 MB
#              download into a partition with 0 bytes free
#   meanwhile  every `pkg recipe add` returned a bare HTTP 500 and
#              the log store stopped accepting entries entirely,
#              frozen at the exact second that build started
#
# Freeing space made publishing work again in the same minute and the
# log store resume. Measured on 192.168.15.95, 2026-09-21: vdb5, the
# 15.6 GiB partition mounted at /var/lib/cix, at 0.0 GiB free.
#
# THE MIRROR CHANGE IS KEPT ANYWAY, on its own merits rather than as
# the fix it was first written to be. www.kernel.org is what every
# other kernel.org fetch in this corpus already uses -- getopt and
# libblkid both take their util-linux tarball from it -- so this
# removes the one recipe reaching a different host for no reason.
# The digest is unchanged, which is what makes a mirror swap a
# non-event.
#
package "linux-headers" {
    version "6.18.40"
    release 10
    format "cixpkg"

    sources {
        main "linux" {
            url "https://www.kernel.org/pub/linux/kernel/v6.x/linux-6.18.40.tar.xz"
            sha256 "3712fc1ec839e4daac981176c8518912e8f452650aaedfe4381da4419613a431"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "bash"
            tool "coreutils"
            tool "make"
            tool "binutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "findutils"
            tool "diffutils"
            tool "perl"
        }
    }

    toolchain "gcc" {
        reason "missing flag: the build passes -MMD,<path>, a dependency-generation option TCC does not implement (#209). Measured against tcc 0.9.27; #209 tracks it and this is a candidate for re-measuring when it moves"
    }

    metadata {
        "artifact_sha256" "6368d291848982a8ee77332957c2baf92f8fd0b0330be8f01400d8eb140d80b3"
        "changelog" "6.18.40-10: earns its own artifact approval. 6.18.40-7, -8 and -9 all carry the identical artifact_sha256, so that value was copied forward across revisions rather than earned -- the Build Provenance Mandate forbids exactly that, and the -9 artifact the cache serves hashes to 3a3914759019... instead, which is why the test floor could not verify it. Published with no approval and given the one above by its own first build on 192.168.15.95, 2026-09-25. Otherwise identical to -9 (cix#516, cix#497 clause 5)."
    }

    build {
        cd "${src}/linux/linux-6.18.40" {
            # HOSTCC by absolute path. The kernel's default is a bare
            # "gcc", which in this build environment resolved to TCC
            # and failed on -MMD; and a bare name makes real gcc
            # compute its installation prefix relatively, failing cc1
            # with a misleading posix_spawnp error.
            run "make" {
                "ARCH=x86"
                "HOSTCC=/usr/bin/gcc"
                "headers"
            }
        }
    }

    install {
        # cix-build-system#186. 6.18.40-7 used `run "cp" { "-a" ... }`
        # here, with a comment saying CPDL had no recursive copy and
        # that ten packages in this corpus would each need the same
        # escape. cbs v0.1.31 has one, so the escape goes.
        #
        # The spec is explicit that `copy tree` preserves regular-file
        # modes and copies symlinks WITHOUT DEREFERENCING them, which
        # is what `cp -a` was relied on for and what a naive recursive
        # copy would get wrong.
        # The mkdir is back. 6.18.40-8 dropped it on the spec's
        # "creates the destination directory when absent", and the
        # build failed with errno=2 on that operation -- so what it
        # creates is the leaf, not its parent, and ${dest}/usr has to
        # exist first. Worth the line: the failure names the
        # unexpanded path, so it reads as a missing SOURCE.
        mkdir "${dest}/usr" chmod 0755
        copy tree "${src}/linux/linux-6.18.40/usr/include" to "${dest}/usr/include"
        # These four are what glibc's own configure looks for. A
        # headers run that silently produced nothing would otherwise
        # surface much later as a confusing glibc configure failure.
        require file "${dest}/usr/include/linux/version.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/asm/unistd.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/asm-generic/unistd.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/linux/errno.h" {
            exists
            nonempty
        }
    }
}
