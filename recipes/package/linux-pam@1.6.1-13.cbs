# Linux-PAM -- libpam and the twelve modules this platform uses.
# Converted from build.sh to build.cbs (ADR-0305 stage 4, cix#487).
#
# WHAT CHANGES: the two `rm -f .../*.la` are not translated.
# Finalize drops every .la, and `remove glob` fails on a glob
# matching nothing where `rm -f` shrugged (cbs#188) -- and the
# second of them pointed at /lib64/security, a path this build does
# not produce at all with --libdir=/usr/lib.
#
# THE ONE PATCH teaches pam_cc_compat.h that TCC understands the
# construct behind PAM_GNUC_PREREQ(3, 0). Counted in the release
# tarball before writing: exactly one occurrence, so `exactly 1` is
# measured rather than claimed.
#
# THIRTEEN EXPLICIT `make -C` PAIRS, build and install, rather than
# a loop. CPDL has `each`, and this is the shape it fits -- but the
# body would be one `run` per phase and the guide says a
# single-operation body is written out as N lines. Thirteen names
# in source order also reads as the dependency order it actually
# is: libpam_internal before libpam, libpam before the modules.
#
# ac_cv_func_pthread_kill_other_threads_np=no is a cache variable,
# which is autoconf's own supported way to correct a probe, and is
# truthful: glibc dropped that function.
package "linux-pam" {
    version "1.6.1"
    release 13
    format "cixpkg"

    sources {
        main "linux-pam" {
            url "https://github.com/linux-pam/linux-pam/releases/download/v1.6.1/Linux-PAM-1.6.1.tar.xz"
            sha256 "f8923c740159052d719dbfc2a2f81942d68dd34fcaf61c706a02c9b80feeef8e"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "libxcrypt"
            tool "diffutils"
        }
        runtime {
            # libcrypt.so.2, which pam_unix links for password
            # hashing -- glibc 2.44 moved crypt() out of libc. The
            # #389 gate refused 1.6.1-10 for exactly this, and the
            # hole predates the conversion: libxcrypt was declared
            # as a BUILD tool only, so the link was recorded and the
            # dependency was not, and nothing noticed because
            # linux-pam had not been rebuilt since the gate existed.
            package "libxcrypt"
        }
    }

    metadata {
        "artifact_sha256" "6245c92cacd3c40219c33363f758982eb05daac2579c908c8b920dabc0420e41"
        "changelog" "1.6.1-13: installs unix_chkpwd setuid-root (04755), declared with privileged file, so a non-root process can verify a password through pam_unix -- a screen locker, or re-authentication inside a session (cix#552). make install leaves it 0755. 1.6.1-12 said the same with the wrong cix release (416, which never built) in a comment. 1.6.1-11 declared libxcrypt at runtime."
    }

    # unix_chkpwd reads the shadow database for a caller that cannot,
    # which is why every distribution installs it setuid-root. Declared
    # here because CIXPKG refuses an undeclared setuid entry, and chmod'd
    # in install because linux-pam's own `make install` leaves it 0755:
    # measured on 192.168.15.95, 2026-09-30, from 1.6.1-11 in jumpbox
    # (probe-setuid@1-1), which built with no declaration and so could
    # not have staged the bit. The installer keeps a declared bit from
    # cix 0.2.57-417 on (cix#552); before that it masked every mode to
    # 0777.
    privileged file "${dest}/sbin/unix_chkpwd" mode 04755

    prepare {
        replace "${src}/linux-pam/Linux-PAM-1.6.1/libpam/include/pam_cc_compat.h" {
            from "#if PAM_GNUC_PREREQ(3, 0)"
            to "#if PAM_GNUC_PREREQ(3, 0) || defined(__TINYC__)"
            exactly 1
        }
    }

    build {
        cd "${src}/linux-pam/Linux-PAM-1.6.1" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-nls"
                "--disable-doc"
                "--disable-selinux"
                "--disable-audit"
                "--disable-systemd"
                "--disable-econf"
                "--disable-nis"
                "--disable-db"
                "--disable-lckpwdf"
                env "CC" = "tcc"
                env "CPPFLAGS" = "-D__STDC_NO_VLA__=1"
                env "ac_cv_func_pthread_kill_other_threads_np" = "no"
            }
            run "make" {
                "-C"
                "libpam_internal"
            }
            run "make" {
                "-C"
                "libpam"
            }
            run "make" {
                "-C"
                "libpam_misc"
            }
            run "make" {
                "-C"
                "libpamc"
            }
            run "make" {
                "-C"
                "modules/pam_unix"
            }
            run "make" {
                "-C"
                "modules/pam_permit"
            }
            run "make" {
                "-C"
                "modules/pam_deny"
            }
            run "make" {
                "-C"
                "modules/pam_env"
            }
            run "make" {
                "-C"
                "modules/pam_limits"
            }
            run "make" {
                "-C"
                "modules/pam_rootok"
            }
            run "make" {
                "-C"
                "modules/pam_warn"
            }
            run "make" {
                "-C"
                "modules/pam_mkhomedir"
            }
            run "make" {
                "-C"
                "conf"
            }
        }
    }

    install {
        cd "${src}/linux-pam/Linux-PAM-1.6.1" {
            run "make" {
                "-C"
                "libpam_internal"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "libpam"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "libpam_misc"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "libpamc"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_unix"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_permit"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_deny"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_env"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_limits"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_rootok"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_warn"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "modules/pam_mkhomedir"
                "DESTDIR=${dest}"
                "install"
            }
            run "make" {
                "-C"
                "conf"
                "DESTDIR=${dest}"
                "install"
            }
        }
        chmod 04755 "${dest}/sbin/unix_chkpwd"
        require file "${dest}/usr/lib/libpam.so.0.85.1" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/security/pam_appl.h" {
            exists
            nonempty
        }
    }
}
