#
# longwire -- one long wire between your sites: a Layer 2 VPN that
# stretches one Ethernet segment across the internet. The owner's
# project (git.home.arpa/itdlabs/longwire), built on hibr.
#
# THREE THINGS, ONE PACKAGE. Upstream ships the module (longwire.so)
# as a deb/rpm/pacman package and the two scripts (the node and the
# switchboard) through hibr's online catalogue. On Cix an image's
# content comes only from packages (ADR-0333), so this package carries
# all three, at one version: the module, the two launchers, and the
# two scripts in /var/lib/hibr/cli, which is where the launcher looks
# (packaging/launcher.sh, the machine's scope). The owner's choice,
# 2026-10-28.
#
# UPSTREAM'S OWN COMPILE LINE. The Makefile builds longwire.so with tcc
# ("override CC = tcc", longwire ADR 0021) against
# $(HIBR_SRC)/include/hibr.h. hibr installs its headers at
# /usr/include/hibr, so HIBR_SRC is a directory whose include links
# there, and `make` runs as upstream wrote it.
#
# WHAT IS LEFT OUT, because Cix has no use for it: the systemd units,
# sysusers.d, the polkit action, the `jack` root helper (it makes a tap
# device with `ip`), and the gzipped man pages. A Cix container runs
# the node as a service of its own definition instead.
#
package "longwire" {
    version "0.5.9"
    release 1
    format "cixpkg"

    upstream "gitea-tags" {
        tag "v{version}"
        source "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/longwire/archive/v{version}.tar.gz"
        verify origin
    }

    sources {
        main "longwire" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/longwire/archive/v0.5.9.tar.gz"
            sha256 "aa62e96ede901676e7b987ba2135218ecc6e931c63f7c7acf8eae7b0ff16decf"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            # strip, which finalize runs on longwire.so (ADR-0251).
            tool "binutils"
            # hibr.h, and the hibr the module is loaded by. HIBR_MIN is
            # 0.99.315.
            tool "hibr"
        }
        runtime {
            # The module is loaded by hibr and the launchers exec it,
            # so nothing records hibr as a DT_NEEDED.
            package "hibr"
            # The launchers are /bin/sh scripts.
            package "bash"
            # chmod, id, mkdir, mv, cat, sleep and tail, which the node
            # script runs (scripts/longwire.hibr at v0.5.7).
            package "coreutils"
        }
    }

    metadata {
        "changelog" "0.5.9-1: longwire 0.5.9, sha256 aa62e96ede901676e7b987ba2135218ecc6e931c63f7c7acf8eae7b0ff16decf, verified by origin trust: the release archive fetched from trusted origin https://git.home.arpa at 2026-10-28T17:54:33Z. Written by cixd from 0.5.7-1 (ADR-0323)."
    }

    prepare {
        require file "${src}/longwire/longwire/Makefile" {
            exists
        }
        mkdir "${build}/hibr" parents
        symlink "/usr/include/hibr" to "${build}/hibr/include"
    }

    build {
        cd "${src}/longwire/longwire" {
            run "make" {
                "HIBR_SRC=${build}/hibr"
            }
            # TCC's own warnings, as errors, on everything upstream wrote.
            # 0.5.5 stopped here at engine/port.c:113 and 0.5.6 at
            # engine/call.c:223 under tcc@0.9.28rc-31; 0.5.7 fixed both.
            run "make" {
                "lint"
                "HIBR_SRC=${build}/hibr"
            }
        }
    }

    install {
        mkdir "${dest}/usr/lib/hibr" parents
        mkdir "${dest}/usr/bin" parents
        mkdir "${dest}/var/lib/hibr/cli" parents
        copy "${src}/longwire/longwire/build/longwire.so" to "${dest}/usr/lib/hibr/longwire.so"
        copy "${src}/longwire/longwire/packaging/launcher.sh" to "${dest}/usr/bin/longwire"
        copy "${src}/longwire/longwire/packaging/launcher.sh" to "${dest}/usr/bin/longwire-switchboard"
        copy "${src}/longwire/longwire/scripts/longwire.hibr" to "${dest}/var/lib/hibr/cli/longwire.hibr"
        copy "${src}/longwire/longwire/scripts/longwire-switchboard.hibr" to "${dest}/var/lib/hibr/cli/longwire-switchboard.hibr"
        require file "${dest}/usr/lib/hibr/longwire.so" {
            exists
            nonempty
        }
        require file "${dest}/usr/bin/longwire" {
            exists
            executable
        }
        require file "${dest}/usr/bin/longwire-switchboard" {
            exists
            executable
        }
        require file "${dest}/var/lib/hibr/cli/longwire.hibr" {
            exists
            nonempty
        }
        require file "${dest}/var/lib/hibr/cli/longwire-switchboard.hibr" {
            exists
            nonempty
        }
    }
}
