# ncurses, as a CPDL recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/ncurses/6.6-8/build.sh: same tarball
# at the same digest, the same seven configure switches, the same
# generated-Makefile edit, the same `make install` and the same six
# compatibility symlinks.
#
# Three translation notes.
#
# CC=tcc is a POSITIONAL argument, not an environment variable, because
# that is what the shell form used: `./configure CC=tcc --prefix=...`.
# autoconf treats it as a precious variable either way; the positional
# spelling is kept so the two recipes read the same.
#
# The `find . -name Makefile -exec sed -i 's/,-stats,-lc//g' {} +`
# becomes `replace glob "**/Makefile"`. CPDL's globs recurse and `**`
# crosses directories, so this is a faithful translation rather than an
# approximation -- and `exactly N` turns it into an assertion the shell
# form needed a separate `grep -rlq ... || exit 1` guard to make. That
# guard is therefore not translated: it is subsumed.
#
# `,-stats,-lc` is a linker argument ncurses' configure emits that TCC
# does not accept. Removing it from the generated Makefiles is the fix;
# the count below is what the tree actually contains, measured rather
# than assumed -- see this recipe's changelog for how.
#
# NOT translated: `rm -f "$PKG_DESTDIR"/usr/lib/*.a`. `--without-normal`
# already suppresses the static libraries, so the glob matched nothing
# and `rm -f` shrugged; CPDL's `remove glob` fails on a glob matching
# nothing, and ADR-0251's finalize phase removes a superseded archive
# anyway.
package "ncurses" {
    version "6.6"
    release 13
    format "cixpkg"

    license "X11"

    sources {
        main "ncurses" {
            url "https://invisible-island.net/archives/ncurses/ncurses-6.6.tar.gz"
            sha256 "355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
        }
    }

    metadata {
        "changelog" "6.6-13: the programs (tic, tput, clear, reset, ...) move to an ncurses-tools output and the terminfo database and tabset to ncurses-terminfo; ncurses keeps its libraries (ADR-0371 decision E, cix#350). ncurses-tools requires ncurses-terminfo, since the programs read it. tool \"ncurses\" still composes every output (ADR-0372); an image that runs a terminal program declares ncurses-terminfo, and one that runs the ncurses programs declares ncurses-tools."
    }

    # ADR-0372: build-time files are their own package. A recipe that
    # declares tool "ncurses" still composes them; a runtime requirement
    # and an image get the main package without them, so the
    # control-plane root carries no headers (ADR-0371).
    output "ncurses-dev" {
        files {
            "usr/include"
            "usr/lib/pkgconfig"
            "usr/bin/ncursesw6-config"
            "usr/share/man/man1/ncursesw6-config.1"
            "usr/share/man/man3"
        }
        requires { runtime { package "ncurses" } }
    }

    # ADR-0371 decision E (the owner, 2026-11-10): ncurses keeps its
    # libraries -- util-linux links them, so the control-plane root does
    # too -- and nothing else. The root runs no terminal program, so it
    # carries neither these programs nor the 2,899-file terminfo
    # database. Paths are named one by one, because ncurses-dev already
    # claims usr/bin/ncursesw6-config and man pages beside these.
    output "ncurses-tools" {
        files {
            "usr/bin/captoinfo"
            "usr/bin/clear"
            "usr/bin/infocmp"
            "usr/bin/infotocap"
            "usr/bin/reset"
            "usr/bin/tabs"
            "usr/bin/tic"
            "usr/bin/toe"
            "usr/bin/tput"
            "usr/bin/tset"
            "usr/share/man/man1/captoinfo.1m"
            "usr/share/man/man1/clear.1"
            "usr/share/man/man1/infocmp.1m"
            "usr/share/man/man1/infotocap.1m"
            "usr/share/man/man1/reset.1"
            "usr/share/man/man1/tabs.1"
            "usr/share/man/man1/tic.1m"
            "usr/share/man/man1/toe.1m"
            "usr/share/man/man1/tput.1"
            "usr/share/man/man1/tset.1"
        }
        requires { runtime { package "ncurses" package "ncurses-terminfo" } }
    }

    output "ncurses-terminfo" {
        files {
            "usr/share/terminfo"
            "usr/lib/terminfo"
            "usr/share/tabset"
            "usr/share/man/man5"
            "usr/share/man/man7"
        }
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/ncurses"
        }
        require directory "${src}/ncurses/ncurses-6.6" {
            exists
        }
    }

    build {
        cd "${src}/ncurses/ncurses-6.6" {
            run "./configure" {
                "CC=tcc"
                "--prefix=/usr"
                "--with-shared"
                "--without-normal"
                "--without-debug"
                "--without-ada"
                "--enable-widec"
                "--enable-pc-files"
                "--with-pkg-config-libdir=/usr/lib/pkgconfig"
                #
                # ALIASES ARE SYMLINKS (cix#497).
                #
                # ncurses was the last package that could not ship
                # as a .cixpkg, because CIXPKG refuses a hard link
                # by design (cix-build-system#182):
                #
                #   usr/share/terminfo/d/dec-vt340 is a hard link
                #   (link count 4)
                #
                # and unlike gzip and gawk, where three names could
                # be relinked by hand in the install phase, tic
                # hard-links aliases across a database of 2903
                # entries. There is nothing to relink one at a time.
                #
                # ncurses ships the switch, and this is quoted from
                # its own configure rather than remembered:
                #
                #   --enable-symlinks  make tic use symbolic links
                #                      not hard links
                #
                # ASKED BEFORE IT WAS USED, deliberately. Autoconf
                # ignores an unrecognised --enable-* silently, so a
                # guessed flag would have configured, compiled,
                # installed hard links anyway and failed at the
                # manifest exactly as before -- having spent a full
                # ncurses build to learn nothing.
                #
                "--enable-symlinks"
                #
                # The same policy for the other alias mechanism this
                # package has: 933 man pages are installed and their
                # aliases are links too. Not a guess about whether
                # they are currently hard links -- it is the same
                # statement of intent, and correct either way.
                #
                "--with-manpage-symlinks"
            }
        }
        # Deliberately after configure: the Makefiles this edits are
        # generated by it.
        #
        # `exactly 4` is MEASURED, not guessed. `exactly N` on a glob is
        # a total across every matched file rather than a count per
        # file, so the number cannot be known without counting -- 6.6-9
        # declared 1 and the build answered "source edit expected 1
        # matches but found 4". One deliberate failing cycle is the
        # price, and it buys an assertion the shell form's
        # `grep -rlq ... || exit 1` guard could not make: if upstream
        # emits the flag in a fifth Makefile, this fails loudly instead
        # of leaving one behind.
        replace glob "${src}/ncurses/ncurses-6.6/**/Makefile" {
            from ",-stats,-lc"
            to ""
            exactly 4
        }
        cd "${src}/ncurses/ncurses-6.6" {
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/ncurses/ncurses-6.6" {
            run "make" {
                "DESTDIR=${dest}"
                "install"
            }
        }
        # Every target is RELATIVE: these links must resolve on the
        # installed host, where ${dest} does not exist. Operand order is
        # target first, the reverse of how `ln -s` reads in prose.
        #
        # --enable-widec builds libncursesw only, and everything that
        # links -lncurses or -ltinfo expects those names to exist.
        symlink "libncursesw.so.6" to "${dest}/usr/lib/libncurses.so.6"
        symlink "libncursesw.so.6" to "${dest}/usr/lib/libncurses.so"
        symlink "libncursesw.so.6" to "${dest}/usr/lib/libtinfo.so.6"
        symlink "libncursesw.so.6" to "${dest}/usr/lib/libtinfo.so"
        symlink "ncursesw.pc" to "${dest}/usr/lib/pkgconfig/ncurses.pc"
        symlink "ncursesw.pc" to "${dest}/usr/lib/pkgconfig/tinfo.pc"
        # The real file, not one of the soname links above: `require
        # file` lstat()s and demands a regular file, so it reports a
        # symlink as "does not exist" (cix-build-system#175).
        require file "${dest}/usr/lib/libncursesw.so.6.6" {
            exists
            nonempty
        }
        require file "${dest}/usr/bin/tic" {
            exists
            nonempty
        }
    }
}
