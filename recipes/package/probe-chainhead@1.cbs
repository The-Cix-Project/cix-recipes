#
# probe-chainhead -- cix#380: two recipes with a byte-identical source and sha256,
# one a runtime dependency of the other, installed as one chain.
#
package "probe-chainhead" {
    version "1"
    release 1
    format "cixpkg"

    sources {
        main "cix" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/0.2.57-386.tar.gz"
            sha256 "2c00b3b73b9d834112341628b595b107448df567207b79663fe3904c8895689b"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
        }
        runtime {
            package "probe-chaindep"
        }
    }

    metadata {
        "changelog" "1: the head of the cix#380 reproducer -- depends on probe-chaindep, declares the identical source and sha256; its fetch and checksum are the probe, its build fails on purpose."
    }

    build {
        run "false" {
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-chainhead" parents chmod 0755
    }
}
