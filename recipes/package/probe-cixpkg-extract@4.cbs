#
# probe-cixpkg-extract 4 -- what `cbs extract` says about its
# DESTINATION, so CIXPKG-E4001 can be matched to a cause or ruled out.
#
# 1 through 3 established that cbs extracts the glibc 2.44-19 artifact
# correctly, that /run has 3.9 GB free against a 47 MB tree, and that a
# TMPDIR naming a directory these images lack changes nothing. The
# daemon still fails on the same bytes with
#
#   error[CIXPKG-E4001]: artifact extraction failed
#
# so the remaining difference is where it extracts TO (cix#485).
#
# Reading cixpkg_unpack_start() and its caller says the destination's
# parent cannot be missing: persist_mkdir_p(dest_dir) creates the whole
# path, and only the leaf is rmdir()ed before the fork. That is a claim
# about the code rather than a measurement, and it is not the question
# this answers anyway. The question is whether E4001 is the SIGNATURE
# of a destination problem at all:
#
#   - a destination whose parent does not exist
#   - a destination that already exists, which the daemon rmdir()s
#     precisely because cbs refuses it
#
# Either reproducing E4001 would point back at the daemon's handling of
# dest_dir. Neither reproducing it rules the destination out entirely
# and leaves what the child inherits.
#
# Both runs expect exit 4, which is what cbs answered for the missing
# parent on the first attempt (an expect exit 1 there failed with
# "exited with status 4"), and is presumably its E4xxx class. If cbs
# SUCCEEDS or answers otherwise, the expect
# fails and that is the finding.
#
package "probe-cixpkg-extract" {
    version "4"
    release 1
    format "cixpkg"

    sources {
        main "glibc" {
            url "http://192.168.15.31:8080/glibc-2.44-19-x86_64.cixpkg"
            sha256 "220c11019bf7cc729befca2b0cdf7ddd77399de2b436a50000299d52bd4d954d"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
        }
    }

    metadata {
        "changelog" "4: cbs answers exit 4 for a destination whose parent is missing. whether CIXPKG-E4001 is what cbs says about a destination whose parent is missing, or one that already exists. 1-3 ruled out cbs itself, disk space and TMPDIR (cix#485)."
    }

    build {
        # A destination whose PARENT does not exist.
        run "/usr/bin/cbs" {
            "extract" "${src}/glibc/glibc-2.44-19-x86_64.cixpkg"
            "--into" "${build}/nosuchparent/out"
            stderr file "${build}/missing-parent.err"
            expect exit 4
        }
        run "cat" {
            "${build}/missing-parent.err"
        }

        # A destination that ALREADY EXISTS -- what the daemon's rmdir()
        # exists to avoid.
        mkdir "${build}/exists"
        run "/usr/bin/cbs" {
            "extract" "${src}/glibc/glibc-2.44-19-x86_64.cixpkg"
            "--into" "${build}/exists"
            stderr file "${build}/exists.err"
            expect exit 4
        }
        run "cat" {
            "${build}/exists.err"
        }

        run "false" {
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-cixpkg-extract"
    }
}
