#
# probe-cpdlversion -- does ${version} interpolate in the cbs this
# host actually runs?
#
# cix-build-system#238 was closed with "the CPDL values version and
# release were already supported by validation and runtime
# interpolation; v0.1.62 adds an end-to-end regression". If that
# holds on the cbs installed here -- v0.1.56, measured, older than
# that release -- then the cix recipe can state its version once in
# the `version` field instead of five times, and the drift that
# shipped a v2.57.332 binary stamped v2.57.277 to a booted host on
# 2026-09-26 becomes unexpressible. That is worth one probe rather
# than one deploy.
#
# "Already supported" is upstream's statement about upstream's code.
# This asks the binary on this box.
#
# HOW TO READ IT. Deliberate failure, so the log is retained:
#   cixctl pkg build-logs --file=probe-cpdlversion-1-1-<stamp>.log
# PROBE-VERSION=[7.7.7] and PROBE-RELEASE=[3] mean both interpolate.
# The literal text back means they do not. A validation error naming
# an unknown binding means the same thing, more loudly.
#
package "probe-cpdlversion" {
    version "7.7.8"
    release 3
    format "cixpkg"

    sources {
        main "cix" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/v2.57.332.tar.gz"
            sha256 "9dd7c9f275236c3b85f463831826469718251bcca364e1bef8ca81fadd78796e"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
        }
    }

    metadata {
        "changelog" "1: does ${version} interpolate in the installed cbs (v0.1.56)? cbs#238 says version and release were always supported; this asks the binary rather than the ticket. Deliberately odd version/release so the answer cannot be confused with anything else on the box."
    }

    build {
        run "echo" {
            "PROBE-VERSION=[${version}]"
        }
        run "echo" {
            "PROBE-RELEASE=[${release}]"
        }
        run "false" {
        }
    }

    install {
        mkdir "${dest}/usr/share" chmod 0755
    }
}
