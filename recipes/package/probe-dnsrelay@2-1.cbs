#
# probe-dnsrelay 1 -- what dnsmasq 2.90 does as a DHCPv4 relay and as a
# server answering relayed requests: the --dhcp-relay syntax, whether a
# relayed subnet's dhcp-range needs its netmask, how a relayed request is
# matched to a range (giaddr), and where the reply goes. Read from the
# packaged tarball's own source and manual; nothing is compiled. Every
# grep carries a pattern that cannot miss, and the phase fails at the end
# on purpose so the log is kept.
#
package "probe-dnsrelay" {
    version "2"
    release 1
    format "cixpkg"

    sources {
        main "dnsmasq" {
            url "https://deb.debian.org/debian/pool/main/d/dnsmasq/dnsmasq_2.90.orig.tar.xz"
            sha256 "8e50309bd837bfec9649a812e066c09b6988b73d749b7d293c06c57d46a109e4"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
            tool "grep"
        }
    }

    metadata {
        "changelog" "2: relay-only start-up in src/dnsmasq.c, the empty case, and the manual around line 1123."
    }

    build {
        # The manual's full text around the relay caveat and --dhcp-relay.
        run "sed" { "-n" "1105,1130p;1420,1460p" "${src}/dnsmasq/dnsmasq-2.90/man/dnsmasq.8" }
        # Start-up: when DHCP sockets open, and what a relay-only or an
        # empty configuration does (daemon->relay4, daemon->dhcp, port=0).
        run "grep" { "-n" "-e" "daemon->relay4" "-e" "daemon->dhcp" "-e" "daemon->port" "-e" "die(" "-e" "#include" "${src}/dnsmasq/dnsmasq-2.90/src/dnsmasq.c" }
        run "grep" { "-n" "-B" "2" "-A" "6" "-e" "relay4" "-e" "#include" "${src}/dnsmasq/dnsmasq-2.90/src/dnsmasq.c" }
        run "grep" { "-n" "-e" "relay4" "-e" "#include" "${src}/dnsmasq/dnsmasq-2.90/src/dhcp.c" "${src}/dnsmasq/dnsmasq-2.90/src/option.c" "${src}/dnsmasq/dnsmasq-2.90/src/network.c" }
        run "false" { }
    }

    install {
        mkdir "${dest}/usr/share/probe-dnsrelay" parents
        write "${dest}/usr/share/probe-dnsrelay/probe" "${version}-${release}\n"
    }
}
