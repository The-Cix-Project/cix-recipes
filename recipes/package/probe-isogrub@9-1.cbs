#
# probe-isogrub 9 -- the candidate fix for cix#430, measured before any C
# is written: strip the two arguments that make the embedded EFI image a
# PARTITION, append the same image past the end of the ISO instead, and
# see whether the GPT then carries an entry spanning the ISO9660
# filesystem.
#
# WHY THIS IS THE ONLY ROUTE LEFT. 7-1 measured that libisofs REFUSES a
# spanning entry while the ESP sits inside the filesystem -- "Overlapping
# MBR partition entries requested" -- so the published Gap0/ESP/Gap1
# layout is not a flag nobody passed. probe-grubsrc@1-1 then read
# grub-mkrescue.c: `efi.img` is built inside iso9660_dir (line 857), so
# it is a file in the filesystem, and `--efi-boot efi.img`,
# `-efi-boot-part`, `--efi-boot-image` are pushed at 865-868 under no
# system_area guard, so no grub-side option can ask for an appended ESP.
# The wrapper has to do it.
#
# WHAT IS KEPT AND WHY. `--efi-boot efi.img` STAYS, so the El Torito
# catalogue still points at the copy inside the filesystem and optical
# EFI boot is untouched. Only the pair that describes that copy as a
# partition is removed, and the same file is appended as partition 2 of
# type 0xef, which is the layout probe-isopoff@4-1 already measured
# produces an `ISO9660` entry spanning the filesystem. grub-mkrescue's
# own line 870 keeps that copy deliberately ("so that we have a
# duplicate on the ISO 9660 file system"), so there is a file to append.
#
# --directory IS PASSED THIS TIME, which is the caveat the earlier
# revisions carried. mkinstalleriso computes
# `<isotools_root>/lib/grub/x86_64-efi` and passes it as --directory=,
# and `-d` is what re-runs grub's platform auto-detection (line 560) and
# decides which push blocks fire. The build image's own module directory
# is the same thing structurally, so the argv shape here is the real one
# rather than a default-path approximation. The directory is listed
# first, so what platforms are actually present is recorded rather than
# assumed -- and revision 8 already recorded it, which is what the ONE
# PLATFORM note below is drawn from.
#
# TWO VARIANTS, primary first so a failing control cannot cost the
# answer:
#
#   A  strip the pair AND append the image   -- the candidate fix
#   B  strip the pair only                   -- isolates which half acts
#
# B is a control, not a candidate: without an appended ESP there is no
# EFI system partition in the GPT for firmware to find on a USB stick,
# which is the thing cix#430 exists to provide.
#
# THE WRAPPER FAILS LOUDLY, BUT NOT AT THE CAPABILITY PROBE -- which is
# what revision 8 got wrong and is the whole reason this revision
# exists. grub-mkrescue calls the xorriso it was given TWICE: first
# check_xorriso() forks `xorriso -as mkisofs -help` through a pipe and
# greps the output for "graft-points", then the real image write. The
# probe invocation carries none of the image-writing arguments, so
# revision 8's wrapper found no `--efi-boot`, refused, and printed its
# refusal into grub's pipe where no log could show it. grub-mkrescue
# reported `error: xorriso not found` and stopped 5 ms in, before any
# ISO existed -- which is exactly how revisions 3 to 5 died, recorded in
# cix#430 as "lost to grub-mkrescue's own version probe" with no cause
# attached. So the wrapper passes an argv with no `--efi-boot` straight
# through, untouched, and this is a constraint on the real
# image/src/cix-xorriso.c too, not an artefact of probing.
#
# Otherwise it still fails loudly: it prints its input argv (the capture
# earlier revisions were missing), locates the staged directory holding
# the relative `--efi-boot` value by testing the argv's own directory
# arguments, and exits non-zero rather than guessing if the directory
# cannot be found. Producing media from a half-applied rewrite is the
# one outcome worse than failing.
#
# ONE PLATFORM, measured by this probe's own first command: the module
# directory holds `x86_64-efi` and nothing else. So the HFS+ blocks
# grub-mkrescue guards at lines 744 and 898 cannot fire here whether
# --directory is passed or not, which is why no revision's argv has
# carried an HFS+ argument. cix-xorriso.c's strip list is not wrong --
# it was written from a real failure -- but on this module set it has
# nothing to strip.
#
# NO BUILD OUTPUT. The phase fails deliberately at the end so the log is
# kept and no artifact is published.
#
package "probe-isogrub" {
    version "9"
    release 1
    format "cixpkg"

    sources {
        main "anchor" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/0.2.57-472.tar.gz"
            sha256 "5b89135b1976289b050a1b73d6d5724606b3a96d54f0ed042a749ad548d0597e"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
            tool "grub"
            tool "mtools"
            tool "xorriso"
        }
    }

    metadata {
        "changelog" "9: revision 8 refused grub-mkrescue's capability probe (xorriso -as mkisofs -help, no --efi-boot in argv) and died as error: xorriso not found -- the same way revisions 3 to 5 did. The wrapper now passes a probe argv through untouched, which is a constraint on cix-xorriso.c too."
    }

    build {
        # What platforms the module directory actually holds. This is
        # what --directory points grub-mkrescue at, and what decides
        # which of its push blocks fire.
        run "ls" {
            "-la"
            "/usr/lib/grub"
        }
        run "ls" {
            "/usr/lib/grub/x86_64-efi"
        }

        mkdir "${build}/isoroot/boot" parents
        write "${build}/isoroot/boot/marker" "cix#430 probe-isogrub\n"

        # Variant A: the candidate fix.
        write "${build}/xw_a" """
        #!/usr/bin/bash
        echo "cix#430 A input argv: $@"
        # grub-mkrescue runs this FIRST as a capability probe --
        # check_xorriso() forks `xorriso -as mkisofs -help` through a
        # pipe and greps the output for "graft-points" -- with none of
        # the image-writing arguments present. Pass that through
        # untouched: revision 8 refused it for having no --efi-boot,
        # the refusal went into grub's pipe where nothing could see it,
        # and grub-mkrescue stopped with "xorriso not found" before any
        # ISO was attempted.
        case " $* " in
          *" --efi-boot "*) ;;
          *) exec /usr/bin/xorriso "$@" ;;
        esac
        pre=(-boot_image any partition_offset=16)
        pre+=(-boot_image any gpt_disk_guid=11111111-2222-3333-4444-555555555555)
        pre+=(-boot_image any appended_part_as=gpt)
        out=()
        efirel=""
        while [ $# -gt 0 ]; do
          case "$1" in
            -hfsplus) shift ;;
            -apm-block-size) shift 2 ;;
            -hfsplus-file-creator-type) shift 4 ;;
            -hfs-bless-by) shift 3 ;;
            --efi-boot) efirel="$2"; out+=("$1" "$2"); shift 2 ;;
            -efi-boot-part) shift ;;
            --efi-boot-image) shift ;;
            *) out+=("$1"); shift ;;
          esac
        done
        efiabs=""
        for a in "${out[@]}"; do
          if [ -d "$a" ] && [ -f "$a/$efirel" ]; then efiabs="$a/$efirel"; fi
        done
        if [ -z "$efirel" ]; then echo "cix#430 A: no --efi-boot in argv"; exit 9; fi
        if [ -z "$efiabs" ]; then echo "cix#430 A: no argv directory holds $efirel"; exit 9; fi
        echo "cix#430 A efi image: $efiabs"
        ls -la "$efiabs"
        full=("${pre[@]}" "${out[@]}" -append_partition 2 0xef "$efiabs")
        echo "cix#430 A output argv: ${full[@]}"
        exec /usr/bin/xorriso "${full[@]}"
        """

        # Variant B: the control -- strip the pair, append nothing.
        write "${build}/xw_b" """
        #!/usr/bin/bash
        echo "cix#430 B input argv: $@"
        # Same capability-probe passthrough as A, for the same reason.
        case " $* " in
          *" --efi-boot "*) ;;
          *) exec /usr/bin/xorriso "$@" ;;
        esac
        pre=(-boot_image any partition_offset=16)
        pre+=(-boot_image any gpt_disk_guid=11111111-2222-3333-4444-555555555555)
        pre+=(-boot_image any appended_part_as=gpt)
        out=()
        while [ $# -gt 0 ]; do
          case "$1" in
            -hfsplus) shift ;;
            -apm-block-size) shift 2 ;;
            -hfsplus-file-creator-type) shift 4 ;;
            -hfs-bless-by) shift 3 ;;
            -efi-boot-part) shift ;;
            --efi-boot-image) shift ;;
            *) out+=("$1"); shift ;;
          esac
        done
        full=("${pre[@]}" "${out[@]}")
        echo "cix#430 B output argv: ${full[@]}"
        exec /usr/bin/xorriso "${full[@]}"
        """
        run "chmod" {
            "0755"
            "${build}/xw_a"
            "${build}/xw_b"
        }

        # ---------------- variant A: the candidate fix ----------------
        run "grub-mkrescue" {
            "--directory=/usr/lib/grub/x86_64-efi"
            "--xorriso=${build}/xw_a"
            "-o"
            "${build}/ga.iso"
            "${build}/isoroot"
        }
        run "ls" {
            "-la"
            "${build}/ga.iso"
        }
        # GPT header: "EFI PART" +0, disk GUID +56, entry array LBA +72,
        # entry count +80, entry size +84.
        run "dd" {
            "if=${build}/ga.iso"
            "of=${build}/ha"
            "bs=1"
            "skip=512"
            "count=96"
        }
        run "od" {
            "-Ad"
            "-tx1"
            "${build}/ha"
        }
        # Five entries. Per entry: type GUID +0, unique GUID +16, first
        # LBA +32, last LBA +40, attributes +48, UTF-16LE name +56.
        run "dd" {
            "if=${build}/ga.iso"
            "of=${build}/ea"
            "bs=1"
            "skip=1024"
            "count=640"
        }
        run "od" {
            "-Ad"
            "-tx1"
            "${build}/ea"
        }
        run "od" {
            "-Ad"
            "-c"
            "${build}/ea"
        }
        # The partition-relative volume descriptor.
        run "dd" {
            "if=${build}/ga.iso"
            "of=${build}/oa"
            "bs=1"
            "skip=65536"
            "count=8"
        }
        run "od" {
            "-c"
            "${build}/oa"
        }

        # ---------------- variant B: the control ----------------
        run "grub-mkrescue" {
            "--directory=/usr/lib/grub/x86_64-efi"
            "--xorriso=${build}/xw_b"
            "-o"
            "${build}/gb.iso"
            "${build}/isoroot"
        }
        run "ls" {
            "-la"
            "${build}/gb.iso"
        }
        run "dd" {
            "if=${build}/gb.iso"
            "of=${build}/hb"
            "bs=1"
            "skip=512"
            "count=96"
        }
        run "od" {
            "-Ad"
            "-tx1"
            "${build}/hb"
        }
        run "dd" {
            "if=${build}/gb.iso"
            "of=${build}/eb"
            "bs=1"
            "skip=1024"
            "count=640"
        }
        run "od" {
            "-Ad"
            "-tx1"
            "${build}/eb"
        }
        run "od" {
            "-Ad"
            "-c"
            "${build}/eb"
        }

        run "false" {
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-isogrub" parents
        write "${dest}/usr/share/probe-isogrub/probe" "${version}-${release}\n"
    }
}
