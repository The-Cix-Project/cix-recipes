# probe-pylayout: unpacks every source SearXNG needs and lists each
# one's module layout, and which compiled extensions ship their
# generated C, so the searxng recipe is written from measurement.
package "probe-pylayout" {
    version "1"
    release 1
    format "cixpkg"
    license "MIT"

    sources {
        main "searxng" {
            url "https://github.com/searxng/searxng/archive/d96f0ec9bbb8555bd379334a4adcbd1dc06575d5.tar.gz"
            sha256 "3e71f4d170a39216f9f4365a376b9ae2792875a546d890488857dbd41f010fda"
