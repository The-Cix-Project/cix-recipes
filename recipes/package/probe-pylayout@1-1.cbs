    requires {
        build {
            tool "bash"
            tool "coreutils"
            tool "findutils"
        }
    }

    metadata {
        "changelog" "1-1: lists every SearXNG dependency's source layout."
    }

    prepare {
        mkdir "${build}/deps" parents
        extract $source.certifi into "${build}/deps" as "certifi"
        extract $source.babel into "${build}/deps" as "babel"
        extract $source.flaskbabel into "${build}/deps" as "flaskbabel"
        extract $source.flask into "${build}/deps" as "flask"
        extract $source.jinja2 into "${build}/deps" as "jinja2"
        extract $source.lxml into "${build}/deps" as "lxml"
        extract $source.pygments into "${build}/deps" as "pygments"
        extract $source.pythondateutil into "${build}/deps" as "pythondateutil"
        extract $source.pyyaml into "${build}/deps" as "pyyaml"
        extract $source.curlcffi into "${build}/deps" as "curlcffi"
        extract $source.valkey into "${build}/deps" as "valkey"
        extract $source.markdownitpy into "${build}/deps" as "markdownitpy"
        extract $source.msgspec into "${build}/deps" as "msgspec"
        extract $source.typer into "${build}/deps" as "typer"
        extract $source.isodate into "${build}/deps" as "isodate"
        extract $source.whitenoise into "${build}/deps" as "whitenoise"
        extract $source.typingextensions into "${build}/deps" as "typingextensions"
        extract $source.granian into "${build}/deps" as "granian"
        extract $source.pytz into "${build}/deps" as "pytz"
        extract $source.blinker into "${build}/deps" as "blinker"
        extract $source.click into "${build}/deps" as "click"
        extract $source.itsdangerous into "${build}/deps" as "itsdangerous"
        extract $source.markupsafe into "${build}/deps" as "markupsafe"
        extract $source.werkzeug into "${build}/deps" as "werkzeug"
        extract $source.six into "${build}/deps" as "six"
        extract $source.tzdata into "${build}/deps" as "tzdata"
        extract $source.cffi into "${build}/deps" as "cffi"
        extract $source.pycparser into "${build}/deps" as "pycparser"
        extract $source.mdurl into "${build}/deps" as "mdurl"
        extract $source.pydantic into "${build}/deps" as "pydantic"
        extract $source.pydanticcore into "${build}/deps" as "pydanticcore"
        extract $source.annotatedtypes into "${build}/deps" as "annotatedtypes"
        extract $source.typinginspection into "${build}/deps" as "typinginspection"
        extract $source.shellingham into "${build}/deps" as "shellingham"
        extract $source.annotateddoc into "${build}/deps" as "annotateddoc"
        extract $source.setuptools into "${build}/deps" as "setuptools"
        extract $source.rich into "${build}/deps" as "rich"
    }

    build {
        run "find" { "${build}/deps" "-maxdepth" "3" "-not" "-path" "*/tests/*" "-not" "-path" "*/docs/*" }
        run "find" { "${build}/deps" "-name" "*.c" "-not" "-path" "*/tests/*" }
        run "find" { "${build}/deps" "-name" "Cargo.lock" }
        run "find" { "${src}/searxng" "-maxdepth" "2" }
        run "false" {
        }
    }

    install {
        run "true" {
        }
    }
}
