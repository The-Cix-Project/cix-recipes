#
# probe-recipe-gates -- runs cix-recipes' own `make test` (the content
# gates: test_recipe_hygiene, test_toolchain_policy, secrets) on a Cix
# host, against the corpus at one commit (cix#628). THE SANDBOX RULE:
# nothing compiles in the dev sandbox, and nothing else runs them.
#
# The build ends in a deliberate `false` so the gates' output is read
# from the retained build log; nothing is published.
#
package "probe-recipe-gates" {
    version "1"
    release 5
    format "cixpkg"

    sources {
        main "recipes" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix-recipes/archive/ab452d472371d5adea0ffae4852feed2a60272b9.tar.gz"
            sha256 "cf74b97e4e2707826640c722af5e65de8e992f017a10b12b7e360eddcb2a08c1"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
            tool "make"
            tool "tcc"
            tool "linux-headers"
            tool "grep"
            tool "sed"
        }
    }

    metadata {
        "changelog" "5: declares linux-headers, which glibc's limits.h includes; runs make test at ab452d47 (788778 bytes, sha256 measured by revision 3), whose Makefile builds the gates with tcc (cix#628)."
    }

    build {
        cd "${src}/recipes/cix-recipes" {
            run "make" {
                "test"
            }
        }
        run "false" {
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-recipe-gates" parents
    }
}
