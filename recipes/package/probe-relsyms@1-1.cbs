        materialize $source.a63 to "${build}/x/grub-2.14-16.cixpkg"
        run "cbs" { "extract" "${build}/x/grub-2.14-16.cixpkg" "--into" "${build}/x/grub-2.14-16" }
        write "${build}/scan.c" """
            #define _GNU_SOURCE
            #include <elf.h>
            #include <ftw.h>
            #include <stdio.h>
            #include <stdlib.h>
            #include <string.h>
            static int g_scanned, g_stripped;
            static int ends_with(const char *p, const char *s) { size_t n = strlen(p), m = strlen(s); return n >= m && strcmp(p + n - m, s) == 0; }
            static int cb(const char *p, const struct stat *st, int t, struct FTW *f) {
                FILE *fp; Elf64_Ehdr eh; Elf64_Shdr *sh; int i, symtab = 0, locals = 0;
                if (t != FTW_F || ends_with(p, ".o") || ends_with(p, ".ko")) return 0;
                fp = fopen(p, "rb");
                if (fp == NULL) return 0;
                if (fread(&eh, 1, sizeof(eh), fp) != sizeof(eh) || memcmp(eh.e_ident, ELFMAG, SELFMAG) != 0 || eh.e_ident[EI_CLASS] != ELFCLASS64 || eh.e_type != ET_REL || eh.e_shnum == 0) { fclose(fp); return 0; }
                sh = calloc(eh.e_shnum, sizeof(*sh));
                if (sh == NULL || fseek(fp, (long)eh.e_shoff, SEEK_SET) != 0 || fread(sh, sizeof(*sh), eh.e_shnum, fp) != eh.e_shnum) { free(sh); fclose(fp); return 0; }
                for (i = 0; i < eh.e_shnum; i++) {
                    size_t k, cnt;
                    Elf64_Sym s;
                    if (sh[i].sh_type != SHT_SYMTAB) continue;
                    symtab = 1;
                    cnt = sh[i].sh_size / sizeof(Elf64_Sym);
                    if (fseek(fp, (long)sh[i].sh_offset, SEEK_SET) != 0) break;
                    for (k = 0; k < cnt; k++) {
                        if (fread(&s, sizeof(s), 1, fp) != 1) break;
                        if (ELF64_ST_BIND(s.st_info) == STB_LOCAL && ELF64_ST_TYPE(s.st_info) != STT_SECTION && ELF64_ST_TYPE(s.st_info) != STT_FILE && s.st_name != 0) locals++;
                    }
                }
                g_scanned++;
                if (!symtab || locals == 0) g_stripped++;
                printf("ETREL symtab=%d locals=%d %s", symtab, locals, p); putchar(10);
                free(sh);
                fclose(fp);
                return 0;
            }
            int main(int argc, char **argv) {
                if (argc != 2 || nftw(argv[1], cb, 32, FTW_PHYS) != 0) { printf("RELSYMS: walk failed"); putchar(10); return 1; }
                printf("RELSYMS: %d relocatable objects not named .o or .ko, %d with no named local symbols", g_scanned, g_stripped); putchar(10);
                return 0;
            }
            """
        run "tcc" { "-Wall" "-o" "${build}/scan" "${build}/scan.c" }
        run "${build}/scan" { "${build}/x" }
    }

    install {
        mkdir "${dest}/usr/share/probe-relsyms" parents
        write "${dest}/usr/share/probe-relsyms/done" "1\n"
    }
}
