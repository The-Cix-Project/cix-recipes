#
# probe-relsyms -- do installed packages finalized before 2026-09-24 ship
# relocatable objects stripped of their local symbols? (cix#651)
#
# Until 251d3e3e the finalize policy gave --strip-unneeded to every ELF
# not named *.o or *.ko, which removes the local symbols of a relocatable
# object (grub 2.14-13, #649). Versions 2-6 split the 61 installed
# versions whose cached artifact predates the fix, plus grub 2.14-13
# (known stripped) and 2.14-16 (known good) in version 6, into groups a
# recipe can declare (at most 16 sources). Each prints every ET_REL file
# not named .o or .ko with its count of named local symbols.
#
package "probe-relsyms" {
    version "2"
    release 1
    format "cixpkg"

    sources {
        main "cix" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/0.2.57-609.tar.gz"
            sha256 "ced95af234b17755482cbc07d98663c82ac2458582e3e14d6261ccc7e8682771"
        }
        extra "a1" {
            url "http://192.168.15.31:8080/autoconf-2.71-4-x86_64.cixpkg"
            sha256 "a80d417473db25c67af0154c4c0d8eb0aeb90ff277ef8bb348e178b1f510cb7f"
        }
        extra "a2" {
            url "http://192.168.15.31:8080/automake-1.16.5-4-x86_64.cixpkg"
            sha256 "4dae6a67f9d224e1211b56e67449e085edcbd9cc67a9bc3792651fdeee4a2775"
        }
        extra "a3" {
            url "http://192.168.15.31:8080/bash-5.2.37-6-x86_64.cixpkg"
            sha256 "822bd9af49c83a7b0034bcbbcc78935d0f8739712f302d95a85cb3806103d5f9"
        }
        extra "a4" {
            url "http://192.168.15.31:8080/bird-2.19.1-13-x86_64.cixpkg"
            sha256 "98f9db1f87a78fe2f926956498a50cbbf7e7277b3e2e131b6d1aa05f6b510633"
        }
        extra "a5" {
            url "http://192.168.15.31:8080/bison-3.8.2-8-x86_64.cixpkg"
            sha256 "6457cc49c17d477b7a5a367bd3c0d1b70357490ccb13d8cf5ca254565df8c667"
        }
        extra "a6" {
            url "http://192.168.15.31:8080/btop-1.4.7-3-x86_64.cixpkg"
            sha256 "8afa1d3fbadb9d1260653c9c048aee63c689c5118985fc86e4438a700502209d"
        }
        extra "a7" {
            url "http://192.168.15.31:8080/byobu-5.133-3-x86_64.cixpkg"
            sha256 "e26bcfc98263c68647ac6aff16e92ee9522e92b66a9cea945d06243750f75b71"
        }
        extra "a8" {
            url "http://192.168.15.31:8080/bzip2-1.0.8-6-x86_64.cixpkg"
            sha256 "dccc1dc9722864cdddb67a4f6d933595722af4524c579ccad261ad86e07cb1c7"
        }
        extra "a9" {
            url "http://192.168.15.31:8080/ca-certificates-2026.09.03-2-x86_64.cixpkg"
            sha256 "3991f72010507492752af600166ba204e2b3807e59b8ee89b7ad66a152c93466"
        }
        extra "a10" {
            url "http://192.168.15.31:8080/chrony-4.8-5-x86_64.cixpkg"
            sha256 "855dc517eb2d079b661dca89b9fa936d53cf41e6e0fd3d9bb09eac6d6029a162"
        }
        extra "a11" {
            url "http://192.168.15.31:8080/dhcpcd-10.5.2-9-x86_64.cixpkg"
            sha256 "d3e08d21b07ab5da04de9f85102b3980de08cecdeb7cfe3eeb64d8dc44a7a8b6"
        }
        extra "a12" {
            url "http://192.168.15.31:8080/dnsmasq-2.90-4-x86_64.cixpkg"
            sha256 "38c9b3b497a9cbca1290f913964545b49efdbc1bef3a9dd56a8ec56c607de49b"
        }
        extra "a13" {
            url "http://192.168.15.31:8080/dosfstools-4.2-3-x86_64.cixpkg"
            sha256 "a7ee2d4c29b67835d48fa4122b982021bc6c64c0dbfb6f01993789aad8e38650"
        }
        extra "a14" {
            url "http://192.168.15.31:8080/efivar-39-9-x86_64.cixpkg"
            sha256 "55b41f5b3467e60551f251ca6d737411e24356910de87d3812afab8f4d2592d5"
        }
        extra "a15" {
            url "http://192.168.15.31:8080/elfutils-0.192-14-x86_64.cixpkg"
            sha256 "c72c846eb40f8cc232ba1978f01677418ef3bb8ebff6632d5c7204912c095a19"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "binutils"
            tool "cbs"
        }
    }

    metadata {
        "changelog" "2: group 1 of 5 -- relocatable objects not named .o or .ko, with their named local symbols, in installed versions finalized before 2026-09-24 (cix#651)."
    }

    build {
        mkdir "${build}/x" parents
        materialize $source.a1 to "${build}/x/autoconf-2.71-4.cixpkg"
        run "cbs" { "extract" "${build}/x/autoconf-2.71-4.cixpkg" "--into" "${build}/x/autoconf-2.71-4" }
        materialize $source.a2 to "${build}/x/automake-1.16.5-4.cixpkg"
        run "cbs" { "extract" "${build}/x/automake-1.16.5-4.cixpkg" "--into" "${build}/x/automake-1.16.5-4" }
        materialize $source.a3 to "${build}/x/bash-5.2.37-6.cixpkg"
        run "cbs" { "extract" "${build}/x/bash-5.2.37-6.cixpkg" "--into" "${build}/x/bash-5.2.37-6" }
        materialize $source.a4 to "${build}/x/bird-2.19.1-13.cixpkg"
        run "cbs" { "extract" "${build}/x/bird-2.19.1-13.cixpkg" "--into" "${build}/x/bird-2.19.1-13" }
        materialize $source.a5 to "${build}/x/bison-3.8.2-8.cixpkg"
        run "cbs" { "extract" "${build}/x/bison-3.8.2-8.cixpkg" "--into" "${build}/x/bison-3.8.2-8" }
        materialize $source.a6 to "${build}/x/btop-1.4.7-3.cixpkg"
        run "cbs" { "extract" "${build}/x/btop-1.4.7-3.cixpkg" "--into" "${build}/x/btop-1.4.7-3" }
        materialize $source.a7 to "${build}/x/byobu-5.133-3.cixpkg"
        run "cbs" { "extract" "${build}/x/byobu-5.133-3.cixpkg" "--into" "${build}/x/byobu-5.133-3" }
        materialize $source.a8 to "${build}/x/bzip2-1.0.8-6.cixpkg"
        run "cbs" { "extract" "${build}/x/bzip2-1.0.8-6.cixpkg" "--into" "${build}/x/bzip2-1.0.8-6" }
        materialize $source.a9 to "${build}/x/ca-certificates-2026.09.03-2.cixpkg"
        run "cbs" { "extract" "${build}/x/ca-certificates-2026.09.03-2.cixpkg" "--into" "${build}/x/ca-certificates-2026.09.03-2" }
        materialize $source.a10 to "${build}/x/chrony-4.8-5.cixpkg"
        run "cbs" { "extract" "${build}/x/chrony-4.8-5.cixpkg" "--into" "${build}/x/chrony-4.8-5" }
        materialize $source.a11 to "${build}/x/dhcpcd-10.5.2-9.cixpkg"
        run "cbs" { "extract" "${build}/x/dhcpcd-10.5.2-9.cixpkg" "--into" "${build}/x/dhcpcd-10.5.2-9" }
        materialize $source.a12 to "${build}/x/dnsmasq-2.90-4.cixpkg"
        run "cbs" { "extract" "${build}/x/dnsmasq-2.90-4.cixpkg" "--into" "${build}/x/dnsmasq-2.90-4" }
        materialize $source.a13 to "${build}/x/dosfstools-4.2-3.cixpkg"
        run "cbs" { "extract" "${build}/x/dosfstools-4.2-3.cixpkg" "--into" "${build}/x/dosfstools-4.2-3" }
        materialize $source.a14 to "${build}/x/efivar-39-9.cixpkg"
        run "cbs" { "extract" "${build}/x/efivar-39-9.cixpkg" "--into" "${build}/x/efivar-39-9" }
        materialize $source.a15 to "${build}/x/elfutils-0.192-14.cixpkg"
        run "cbs" { "extract" "${build}/x/elfutils-0.192-14.cixpkg" "--into" "${build}/x/elfutils-0.192-14" }
        write "${build}/scan.c" """
            #define _GNU_SOURCE
            #include <elf.h>
            #include <ftw.h>
            #include <stdio.h>
            #include <stdlib.h>
            #include <string.h>
            static int g_scanned, g_stripped;
            static int ends_with(const char *p, const char *s) { size_t n = strlen(p), m = strlen(s); return n >= m && strcmp(p + n - m, s) == 0; }
            static int cb(const char *p, const struct stat *st, int t, struct FTW *f) {
                FILE *fp; Elf64_Ehdr eh; Elf64_Shdr *sh; int i, symtab = 0, locals = 0;
                if (t != FTW_F || ends_with(p, ".o") || ends_with(p, ".ko")) return 0;
                fp = fopen(p, "rb");
                if (fp == NULL) return 0;
                if (fread(&eh, 1, sizeof(eh), fp) != sizeof(eh) || memcmp(eh.e_ident, ELFMAG, SELFMAG) != 0 || eh.e_ident[EI_CLASS] != ELFCLASS64 || eh.e_type != ET_REL || eh.e_shnum == 0) { fclose(fp); return 0; }
                sh = calloc(eh.e_shnum, sizeof(*sh));
                if (sh == NULL || fseek(fp, (long)eh.e_shoff, SEEK_SET) != 0 || fread(sh, sizeof(*sh), eh.e_shnum, fp) != eh.e_shnum) { free(sh); fclose(fp); return 0; }
                for (i = 0; i < eh.e_shnum; i++) {
                    size_t k, cnt;
                    Elf64_Sym s;
                    if (sh[i].sh_type != SHT_SYMTAB) continue;
                    symtab = 1;
                    cnt = sh[i].sh_size / sizeof(Elf64_Sym);
                    if (fseek(fp, (long)sh[i].sh_offset, SEEK_SET) != 0) break;
                    for (k = 0; k < cnt; k++) {
                        if (fread(&s, sizeof(s), 1, fp) != 1) break;
                        if (ELF64_ST_BIND(s.st_info) == STB_LOCAL && ELF64_ST_TYPE(s.st_info) != STT_SECTION && ELF64_ST_TYPE(s.st_info) != STT_FILE && s.st_name != 0) locals++;
                    }
                }
                g_scanned++;
                if (!symtab || locals == 0) g_stripped++;
                printf("ETREL symtab=%d locals=%d %s", symtab, locals, p); putchar(10);
                free(sh);
                fclose(fp);
                return 0;
            }
            int main(int argc, char **argv) {
                if (argc != 2 || nftw(argv[1], cb, 32, FTW_PHYS) != 0) { printf("RELSYMS: walk failed"); putchar(10); return 1; }
                printf("RELSYMS: %d relocatable objects not named .o or .ko, %d with no named local symbols", g_scanned, g_stripped); putchar(10);
                return 0;
            }
            """
        run "tcc" { "-Wall" "-o" "${build}/scan" "${build}/scan.c" }
        run "${build}/scan" { "${build}/x" }
    }

    install {
        mkdir "${dest}/usr/share/probe-relsyms" parents
        write "${dest}/usr/share/probe-relsyms/done" "2\n"
    }
}
