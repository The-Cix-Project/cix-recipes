#
# probe-relsyms -- do installed packages finalized before 2026-09-24 ship
# relocatable objects stripped of their local symbols? (cix#651)
#
# Until 251d3e3e the finalize policy gave --strip-unneeded to every ELF
# not named *.o or *.ko, which removes the local symbols of a relocatable
# object (grub 2.14-13, #649). Versions 2-6 split the 61 installed
# versions whose cached artifact predates the fix, plus grub 2.14-13
# (known stripped) and 2.14-16 (known good) in version 6, into groups a
# recipe can declare (at most 16 sources). Each prints every ET_REL file
# not named .o or .ko with its count of named local symbols.
#
package "probe-relsyms" {
    version "4"
    release 1
    format "cixpkg"

    sources {
        main "cix" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/0.2.57-609.tar.gz"
            sha256 "ced95af234b17755482cbc07d98663c82ac2458582e3e14d6261ccc7e8682771"
        }
        extra "a1" {
            url "http://192.168.15.31:8080/iw-6.17-5-x86_64.cixpkg"
            sha256 "7e80f7cddebff342091c2168ace8e11168d7e1e400ef232d7aead6aba0aa3e29"
        }
        extra "a2" {
            url "http://192.168.15.31:8080/keepalived-2.3.4-8-x86_64.cixpkg"
            sha256 "0d62e714539fe42df72d1477b4a25d14413868da4f5ae9510f22998ee393fa01"
        }
        extra "a3" {
            url "http://192.168.15.31:8080/keyutils-1.6.3-11-x86_64.cixpkg"
            sha256 "bb8dde493a07ecac81ef7dc8595534d88eeebfdd34b7733c7a38c0e206d42151"
        }
        extra "a4" {
            url "http://192.168.15.31:8080/kmod-34.2-7-x86_64.cixpkg"
            sha256 "6bac1972085db75ccc7fd3d997edd75778ba94c288b35065e59855e735225c79"
        }
        extra "a5" {
            url "http://192.168.15.31:8080/libnl-3.11.0-7-x86_64.cixpkg"
            sha256 "119a92e17a8b023ebea0b549afff86644bfe18bf8777e7a115110c199fd84f7c"
        }
        extra "a6" {
            url "http://192.168.15.31:8080/libtool-2.4.7-4-x86_64.cixpkg"
            sha256 "75d4fa7d52927294bfbfb92da01344296e869c8bf05d3675169a610d291ad0c0"
        }
        extra "a7" {
            url "http://192.168.15.31:8080/libuv-1.51.0-5-x86_64.cixpkg"
            sha256 "9f5aea502d80940dca2680f3c752581762999b415ba55cbc64e6aab134537f6c"
        }
        extra "a8" {
            url "http://192.168.15.31:8080/linux-pam-1.6.1-11-x86_64.cixpkg"
            sha256 "0aea9e87c1c1a4d025648840c83d6ea04fd93f6c0f74312b3fcebae59843593b"
        }
        extra "a9" {
            url "http://192.168.15.31:8080/m4-1.4.20-6-x86_64.cixpkg"
            sha256 "b1bd2405d8d15fd70d3f455a317ae18a79d7bb3c572397275f8e894d81587e3d"
        }
        extra "a10" {
            url "http://192.168.15.31:8080/minisign-0.12-4-x86_64.cixpkg"
            sha256 "c99891cd0f31702286921f2ebbed168f63b05302ec75c2e1c7af28f2b2ad6cac"
        }
        extra "a11" {
            url "http://192.168.15.31:8080/mokutil-0.7.2-4-x86_64.cixpkg"
            sha256 "926620c6287cccff514def4e21becd94e9c95f97b709b4039551549e32fea723"
        }
        extra "a12" {
            url "http://192.168.15.31:8080/mtools-4.0.49-6-x86_64.cixpkg"
            sha256 "6c4ba0b2779c343fd0b1ace6f78263fd27299195972d385f2fc03caf168b6f73"
        }
        extra "a13" {
            url "http://192.168.15.31:8080/net-tools-2.10-5-x86_64.cixpkg"
            sha256 "2b20d09980173c0534917f8d0852e1ad228f1dcd52f4a2fffbbdc066eb88117e"
        }
        extra "a14" {
            url "http://192.168.15.31:8080/nftables-1.1.1-5-x86_64.cixpkg"
            sha256 "091d02393e7b53cca5e64521d7d78b5f337103c0fd28a7f2580985e4fc9a3ea2"
        }
        extra "a15" {
            url "http://192.168.15.31:8080/openssl-3.0.20-7-x86_64.cixpkg"
            sha256 "12a038104f0e89f3c4fc179a667b8166e64e6c41ec8c84b69602fcf3ed3ff6f5"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "binutils"
            tool "cbs"
        }
    }

    metadata {
        "changelog" "4: group 3 of 5 -- relocatable objects not named .o or .ko, with their named local symbols, in installed versions finalized before 2026-09-24 (cix#651)."
    }

    build {
        mkdir "${build}/x" parents
        materialize $source.a1 to "${build}/x/iw-6.17-5.cixpkg"
        run "cbs" { "extract" "${build}/x/iw-6.17-5.cixpkg" "--into" "${build}/x/iw-6.17-5" }
        materialize $source.a2 to "${build}/x/keepalived-2.3.4-8.cixpkg"
        run "cbs" { "extract" "${build}/x/keepalived-2.3.4-8.cixpkg" "--into" "${build}/x/keepalived-2.3.4-8" }
        materialize $source.a3 to "${build}/x/keyutils-1.6.3-11.cixpkg"
        run "cbs" { "extract" "${build}/x/keyutils-1.6.3-11.cixpkg" "--into" "${build}/x/keyutils-1.6.3-11" }
        materialize $source.a4 to "${build}/x/kmod-34.2-7.cixpkg"
        run "cbs" { "extract" "${build}/x/kmod-34.2-7.cixpkg" "--into" "${build}/x/kmod-34.2-7" }
        materialize $source.a5 to "${build}/x/libnl-3.11.0-7.cixpkg"
        run "cbs" { "extract" "${build}/x/libnl-3.11.0-7.cixpkg" "--into" "${build}/x/libnl-3.11.0-7" }
        materialize $source.a6 to "${build}/x/libtool-2.4.7-4.cixpkg"
        run "cbs" { "extract" "${build}/x/libtool-2.4.7-4.cixpkg" "--into" "${build}/x/libtool-2.4.7-4" }
        materialize $source.a7 to "${build}/x/libuv-1.51.0-5.cixpkg"
        run "cbs" { "extract" "${build}/x/libuv-1.51.0-5.cixpkg" "--into" "${build}/x/libuv-1.51.0-5" }
        materialize $source.a8 to "${build}/x/linux-pam-1.6.1-11.cixpkg"
        run "cbs" { "extract" "${build}/x/linux-pam-1.6.1-11.cixpkg" "--into" "${build}/x/linux-pam-1.6.1-11" }
        materialize $source.a9 to "${build}/x/m4-1.4.20-6.cixpkg"
        run "cbs" { "extract" "${build}/x/m4-1.4.20-6.cixpkg" "--into" "${build}/x/m4-1.4.20-6" }
        materialize $source.a10 to "${build}/x/minisign-0.12-4.cixpkg"
        run "cbs" { "extract" "${build}/x/minisign-0.12-4.cixpkg" "--into" "${build}/x/minisign-0.12-4" }
        materialize $source.a11 to "${build}/x/mokutil-0.7.2-4.cixpkg"
        run "cbs" { "extract" "${build}/x/mokutil-0.7.2-4.cixpkg" "--into" "${build}/x/mokutil-0.7.2-4" }
        materialize $source.a12 to "${build}/x/mtools-4.0.49-6.cixpkg"
        run "cbs" { "extract" "${build}/x/mtools-4.0.49-6.cixpkg" "--into" "${build}/x/mtools-4.0.49-6" }
        materialize $source.a13 to "${build}/x/net-tools-2.10-5.cixpkg"
        run "cbs" { "extract" "${build}/x/net-tools-2.10-5.cixpkg" "--into" "${build}/x/net-tools-2.10-5" }
        materialize $source.a14 to "${build}/x/nftables-1.1.1-5.cixpkg"
        run "cbs" { "extract" "${build}/x/nftables-1.1.1-5.cixpkg" "--into" "${build}/x/nftables-1.1.1-5" }
        materialize $source.a15 to "${build}/x/openssl-3.0.20-7.cixpkg"
        run "cbs" { "extract" "${build}/x/openssl-3.0.20-7.cixpkg" "--into" "${build}/x/openssl-3.0.20-7" }
        write "${build}/scan.c" """
            #define _GNU_SOURCE
            #include <elf.h>
            #include <ftw.h>
            #include <stdio.h>
            #include <stdlib.h>
            #include <string.h>
            static int g_scanned, g_stripped;
            static int ends_with(const char *p, const char *s) { size_t n = strlen(p), m = strlen(s); return n >= m && strcmp(p + n - m, s) == 0; }
            static int cb(const char *p, const struct stat *st, int t, struct FTW *f) {
                FILE *fp; Elf64_Ehdr eh; Elf64_Shdr *sh; int i, symtab = 0, locals = 0;
                if (t != FTW_F || ends_with(p, ".o") || ends_with(p, ".ko")) return 0;
                fp = fopen(p, "rb");
                if (fp == NULL) return 0;
                if (fread(&eh, 1, sizeof(eh), fp) != sizeof(eh) || memcmp(eh.e_ident, ELFMAG, SELFMAG) != 0 || eh.e_ident[EI_CLASS] != ELFCLASS64 || eh.e_type != ET_REL || eh.e_shnum == 0) { fclose(fp); return 0; }
                sh = calloc(eh.e_shnum, sizeof(*sh));
                if (sh == NULL || fseek(fp, (long)eh.e_shoff, SEEK_SET) != 0 || fread(sh, sizeof(*sh), eh.e_shnum, fp) != eh.e_shnum) { free(sh); fclose(fp); return 0; }
                for (i = 0; i < eh.e_shnum; i++) {
                    size_t k, cnt;
                    Elf64_Sym s;
                    if (sh[i].sh_type != SHT_SYMTAB) continue;
                    symtab = 1;
                    cnt = sh[i].sh_size / sizeof(Elf64_Sym);
                    if (fseek(fp, (long)sh[i].sh_offset, SEEK_SET) != 0) break;
                    for (k = 0; k < cnt; k++) {
                        if (fread(&s, sizeof(s), 1, fp) != 1) break;
                        if (ELF64_ST_BIND(s.st_info) == STB_LOCAL && ELF64_ST_TYPE(s.st_info) != STT_SECTION && ELF64_ST_TYPE(s.st_info) != STT_FILE && s.st_name != 0) locals++;
                    }
                }
                g_scanned++;
                if (!symtab || locals == 0) g_stripped++;
                printf("ETREL symtab=%d locals=%d %s", symtab, locals, p); putchar(10);
                free(sh);
                fclose(fp);
                return 0;
            }
            int main(int argc, char **argv) {
                if (argc != 2 || nftw(argv[1], cb, 32, FTW_PHYS) != 0) { printf("RELSYMS: walk failed"); putchar(10); return 1; }
                printf("RELSYMS: %d relocatable objects not named .o or .ko, %d with no named local symbols", g_scanned, g_stripped); putchar(10);
                return 0;
            }
            """
        run "tcc" { "-Wall" "-o" "${build}/scan" "${build}/scan.c" }
        run "${build}/scan" { "${build}/x" }
    }

    install {
        mkdir "${dest}/usr/share/probe-relsyms" parents
        write "${dest}/usr/share/probe-relsyms/done" "4\n"
    }
}
