#
# probe-rootimage -- ADR-0371 phase 3 (cix#350): is the cix-root image
# the root mkbootroot assembles today, path by path and byte by byte,
# now that the library and tool packages are split (decisions C-E)?
#
# Two trees, and a recursive diff between them:
#   root   the control-plane root inside cix-installer-0.2.57-675, which
#          .95 built from the 0.2.57-675 hostbuild artifacts on
#          2026-11-13 and published to the LAN cache;
#   image  HALF A of the packages installed in the cix-root image on .95
#          that day (cix-root@1.1.0 and its runtime closure, 23 packages),
#          each extracted from its cached .cixpkg and merged. One package
#          owns a path, so the merge is the image.
#
# diff -rq --no-dereference prints one line per difference to the build
# log. Its exit status is 1 when the trees differ, which they will: the
# root adds mount points, resolv.conf and os-release, and each half holds
# only its own packages. 0 would fail the build and say so.
#
package "probe-rootimage" {
    version "4"
    release 1
    format "cixpkg"

    sources {
        main "filler" {
            url "https://github.com/ninja-build/ninja/archive/refs/tags/v1.13.2.tar.gz"
            sha256 "974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17"
        }
        extra "iso" {
            url "http://192.168.15.31:8080/cix-installer-0.2.57-675-x86_64.iso"
            sha256 "41c43dc0ccd38748c5be58e75e8d3338dd80a9268143d9f06320f3e18e753f27"
        }
        extra "pglibc" {
            url "http://192.168.15.31:8080/glibc-2.44-21-x86_64.cixpkg"
            sha256 "0d6c8dd0128b4b2b9d4403a536d7392e2b76e8b85ed125d38cdc4e8f84bd7d4c"
        }
        extra "popenssl" {
            url "http://192.168.15.31:8080/openssl-3.0.20-9-x86_64.cixpkg"
            sha256 "74e33791cd3dbbf5174813d6640c9811d3b38bf87ee0d80bcc3b4420d96b4167"
        }
        extra "pzlib" {
            url "http://192.168.15.31:8080/zlib-1.3.2-15-x86_64.cixpkg"
            sha256 "66dbad62eb06e3fd34163eb005376ac69a3aefae7da846bf1e57672971877eef"
        }
        extra "pxz" {
            url "http://192.168.15.31:8080/xz-5.8.3-12-x86_64.cixpkg"
            sha256 "5b98fd565e7dea816b1ec5ab49acac690ce24605e9dd70927df0d9b1e806cc0c"
        }
        extra "pzstd" {
            url "http://192.168.15.31:8080/zstd-1.5.7-5-x86_64.cixpkg"
            sha256 "75e78994a5f46bab071a93ae83a88f095d4a98aba79e39316e5a860763bde05c"
        }
        extra "plibarchive" {
            url "http://192.168.15.31:8080/libarchive-3.8.1-6-x86_64.cixpkg"
            sha256 "58ef0b077babe541c35b4704d733b988b36217229949a511ac70fa1ec3282183"
        }
        extra "pcurl" {
            url "http://192.168.15.31:8080/curl-8.21.0-9-x86_64.cixpkg"
            sha256 "7aa749d2c72b175a911a5a09d2320eeb22ad9b233d87f9d0ed8120065822d5bf"
        }
        extra "pcixd" {
            url "http://192.168.15.31:8080/cixd-0.2.57-675-x86_64.cixpkg"
            sha256 "a18ce794972b2c190669a4d44e48970665cf384e25081c9fc4806febfe7fbbfc"
        }
        extra "pcixctl" {
            url "http://192.168.15.31:8080/cixctl-0.2.57-675-x86_64.cixpkg"
            sha256 "7152bd2433e71785713d860bc90fc1523a498f4196c67580e73aa3fc3d17622f"
        }
        extra "pkernelmodules" {
            url "http://192.168.15.31:8080/kernel-modules-7.3.4-1-x86_64.cixpkg"
            sha256 "2d363b6d88329979866d2411bce0f23416bef3038d337ad7db406c56528bfda2"
        }
        extra "pkmod" {
            url "http://192.168.15.31:8080/kmod-34.2-7-x86_64.cixpkg"
            sha256 "6bac1972085db75ccc7fd3d997edd75778ba94c288b35065e59855e735225c79"
        }
        extra "prtw88firmware" {
            url "http://192.168.15.31:8080/rtw88-firmware-3-1-x86_64.cixpkg"
            sha256 "2956ead95de0fc268fa0d63cdd9f85bb4a1206c14e434fce4d98bcd1982a6758"
        }
    }

    requires {
        build {
            tool "xorriso"
            tool "squashfs-tools"
            tool "bash"
            tool "coreutils"
            tool "diffutils"
            tool "cbs"
        }
    }

    metadata {
        "changelog" "4: half A of cix-root@1.1.0 (glibc openssl zlib xz zstd libarchive curl cixd cixctl kernel-modules kmod rtw88-firmware) against the root in cix-installer-0.2.57-675, by diff -rq, after the library and tool splits; a recipe holds at most 16 sources, so the 23 packages are compared in two halves (ADR-0371 phase 3, cix#350)."
    }

    prepare {
        mkdir "${build}/pkgs" parents
        mkdir "${build}/x" parents
        mkdir "${build}/image" parents
        materialize $source.iso to "${build}/cix.iso"
        materialize $source.pglibc to "${build}/pkgs/glibc.cixpkg"
        materialize $source.popenssl to "${build}/pkgs/openssl.cixpkg"
        materialize $source.pzlib to "${build}/pkgs/zlib.cixpkg"
        materialize $source.pxz to "${build}/pkgs/xz.cixpkg"
        materialize $source.pzstd to "${build}/pkgs/zstd.cixpkg"
        materialize $source.plibarchive to "${build}/pkgs/libarchive.cixpkg"
        materialize $source.pcurl to "${build}/pkgs/curl.cixpkg"
        materialize $source.pcixd to "${build}/pkgs/cixd.cixpkg"
        materialize $source.pcixctl to "${build}/pkgs/cixctl.cixpkg"
        materialize $source.pkernelmodules to "${build}/pkgs/kernel-modules.cixpkg"
        materialize $source.pkmod to "${build}/pkgs/kmod.cixpkg"
        materialize $source.prtw88firmware to "${build}/pkgs/rtw88-firmware.cixpkg"
    }

    build {
        # mkinstalleriso puts the control-plane root at
        # payload/cix-root.squashfs (image/src/mkinstalleriso.c).
        run "xorriso" {
            "-osirrox"
            "on"
            "-indev"
            "${build}/cix.iso"
            "-extract"
            "/payload/cix-root.squashfs"
            "${build}/cix-root.squashfs"
        }
        run "unsquashfs" {
            "-d"
            "${build}/root"
            "${build}/cix-root.squashfs"
        }

        # The image: every package's tree merged into one.
        run "cbs" {
            "extract"
            "${build}/pkgs/glibc.cixpkg"
            "--into"
            "${build}/x/glibc"
        }
        run "cp" {
            "-a"
            "${build}/x/glibc/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/openssl.cixpkg"
            "--into"
            "${build}/x/openssl"
        }
        run "cp" {
            "-a"
            "${build}/x/openssl/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/zlib.cixpkg"
            "--into"
            "${build}/x/zlib"
        }
        run "cp" {
            "-a"
            "${build}/x/zlib/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/xz.cixpkg"
            "--into"
            "${build}/x/xz"
        }
        run "cp" {
            "-a"
            "${build}/x/xz/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/zstd.cixpkg"
            "--into"
            "${build}/x/zstd"
        }
        run "cp" {
            "-a"
            "${build}/x/zstd/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/libarchive.cixpkg"
            "--into"
            "${build}/x/libarchive"
        }
        run "cp" {
            "-a"
            "${build}/x/libarchive/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/curl.cixpkg"
            "--into"
            "${build}/x/curl"
        }
        run "cp" {
            "-a"
            "${build}/x/curl/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/cixd.cixpkg"
            "--into"
            "${build}/x/cixd"
        }
        run "cp" {
            "-a"
            "${build}/x/cixd/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/cixctl.cixpkg"
            "--into"
            "${build}/x/cixctl"
        }
        run "cp" {
            "-a"
            "${build}/x/cixctl/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/kernel-modules.cixpkg"
            "--into"
            "${build}/x/kernel-modules"
        }
        run "cp" {
            "-a"
            "${build}/x/kernel-modules/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/kmod.cixpkg"
            "--into"
            "${build}/x/kmod"
        }
        run "cp" {
            "-a"
            "${build}/x/kmod/."
            "${build}/image/"
        }
        run "cbs" {
            "extract"
            "${build}/pkgs/rtw88-firmware.cixpkg"
            "--into"
            "${build}/x/rtw88-firmware"
        }
        run "cp" {
            "-a"
            "${build}/x/rtw88-firmware/."
            "${build}/image/"
        }

        # The finding. One line per path only in one tree, and one per
        # file whose bytes differ.
        run "diff" {
            "-rq"
            "--no-dereference"
            "${build}/root"
            "${build}/image"
            expect exit 1
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-rootimage" parents
    }
}
