#
# probe-rootlibs -- what libraries does a Cix control-plane root
# actually carry? (cix#589)
#
# THE QUESTION, and it is cix#589's own first action rather than a
# guess. mkbootroot's shelled_bin_libs[] stages 43 libraries from the
# BUILD HOST's /lib/x86_64-linux-gnu, unconditionally, under the
# comment "/* curl */" -- and Cix's own curl is built --without-nghttp2
# --without-libidn2 --without-librtmp --without-libssh2 --without-libpsl
# --without-gssapi --disable-ldap, with none of those packaged at all.
# So that list is Debian's dependency closure.
#
# Real assembly on 192.168.15.95 SUCCEEDS, and that loop is not gated
# on anything, and on .95 mkbootroot runs on the control-plane root
# itself. Those three joined say the running root already carries
# Debian-built libraries, perpetuated because each assembly stages from
# the root the previous one made -- the mechanism mkbootroot's own
# btrfs comment describes for mkfs.btrfs. That is an INFERENCE, so this
# probe replaces it with a measurement.
#
# WHY THE ISO IS A FAIR PROXY, and a better one than it first looks.
# The host is shell-less and no REST endpoint reads a host file, so the
# booted root cannot be listed directly. But `cixctl iso build` runs
# the SAME mkbootroot from the same hostbuild artifacts, and
# cix-installer-0.2.57-480 was built on .95 after booting 0.2.57-480 --
# so its payload/cix-root.squashfs is a control-plane root this
# release's mkbootroot produced on this host. If Debian libraries are
# in there, they are in the booted root for the same reason.
#
# ONE ANSWER, TWO WAYS: the lib directory is listed, and the specific
# names cix#589 names are searched for by name, so a quiet absence and
# a quiet presence look different in the log.
#
package "probe-rootlibs" {
    version "1"
    release 1
    format "cixpkg"

    sources {
        main "filler" {
            url "https://github.com/ninja-build/ninja/archive/refs/tags/v1.13.2.tar.gz"
            sha256 "974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17"
        }
        extra "iso" {
            url "http://192.168.15.31:8080/cix-installer-0.2.57-480-x86_64.iso"
            sha256 "efc5bc54a86efd57c7b957573edf639e209cd762557b27cc2e3c8d2e305d0feb"
        }
    }

    requires {
        build {
            tool "xorriso"
            tool "squashfs-tools"
            tool "bash"
            tool "coreutils"
            tool "findutils"
            tool "grep"
        }
    }

    metadata {
        "changelog" "1: what libraries does a Cix control-plane root actually carry? cix#589's first action. mkbootroot stages 43 libraries from the build host's /lib under a /* curl */ comment, and Cix's curl is built without every one past the first four, none of which is packaged. Whether the booted root carries Debian-built libraries was an inference; this measures it, from the ISO's own payload/cix-root.squashfs (cix#589)."
    }

    prepare {
        materialize $source.iso to "${build}/cix.iso"
    }

    build {
        # mkinstalleriso puts the control-plane root at
        # payload/cix-root.squashfs (image/src/mkinstalleriso.c:1412).
        run "xorriso" {
            "-osirrox"
            "on"
            "-indev"
            "${build}/cix.iso"
            "-extract"
            "/payload/cix-root.squashfs"
            "${build}/cix-root.squashfs"
        }

        run "ls" {
            "-la"
            "${build}/cix-root.squashfs"
        }

        # Only the library directory, not the whole root.
        run "unsquashfs" {
            "-d"
            "${build}/root"
            "${build}/cix-root.squashfs"
            "lib"
        }

        run "ls" {
            "-la"
            "${build}/root/lib/x86_64-linux-gnu"
        }

        # And the names cix#589 names, by name, so an absence reads as
        # an absence rather than as something missed in a long listing.
        run "find" {
            "${build}/root"
            "-name"
            "libnghttp2.so.*"
            "-o"
            "-name"
            "libgnutls.so.*"
            "-o"
            "-name"
            "libkrb5.so.*"
            "-o"
            "-name"
            "libldap*"
            "-o"
            "-name"
            "libcurl.so.*"
        }

        run "false" {
        }

        on_fail {
            run "ls" {
                "-la"
                "${build}"
                allow_failure
            }
            run "find" {
                "${build}/root"
                "-maxdepth"
                "3"
                allow_failure
            }
        }
    }

    install {
        mkdir "${dest}/usr/share/probe-rootlibs" parents
    }
}
