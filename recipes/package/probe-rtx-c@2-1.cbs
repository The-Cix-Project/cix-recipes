#
# probe-rtx-c 2 -- throwaway (cix#680): plays gcc 16.2.0-20. The three
# paths move to an output that the main package requires, named by a
# path, a symlink and a glob, replacing two other packages.
#
package "probe-rtx-c" {
    version "2"
    release 1
    format "cixpkg"

    sources {
        main "filler" {
            url "https://github.com/ninja-build/ninja/archive/refs/tags/v1.13.2.tar.gz"
            sha256 "974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
        }
        runtime {
            package "probe-rtx-c-libs"
        }
    }

    metadata {
        "changelog" "2: throwaway for cix#680, gcc 16.2.0-20's shape: the libraries in an output the main package requires."
    }

    output "probe-rtx-c-libs" {
        files {
            "usr/lib/rtx-c.1"
            "usr/lib/rtx-c.6"
            glob "usr/lib/rtx-c.6.0.*"
        }
        replaces {
            package "probe-rtx-b"
            package "probe-rtx-x"
        }
    }

    install {
        mkdir "${dest}/usr/lib" parents
        mkdir "${dest}/usr/bin" parents
        run "touch" { "${dest}/usr/lib/rtx-c.1" "${dest}/usr/lib/rtx-c.6.0.9" "${dest}/usr/bin/rtx-c" }
        symlink "rtx-c.6.0.9" to "${dest}/usr/lib/rtx-c.6"
    }
}
