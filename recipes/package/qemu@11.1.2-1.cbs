#
# qemu -- the machine emulator Cix's own boot tests need. (cix#584)
#
# WHY IT IS HERE. Seven of this project's tests boot a real kernel or
# a real installer ISO under QEMU, and they have never run on a Cix
# host because no Cix host had QEMU. With ovmf@202608-1 for the EFI
# half, this is the other half of cix#584.
#
# ONE TARGET. --target-list=x86_64-softmmu, because that is the
# machine Cix runs on and every other target is build time spent on
# something nothing here boots.
#
# TCG ONLY, AND THAT IS NOT A LIMITATION HERE. This kernel has no KVM
# at all -- CONFIG_KVM appears nowhere in image/kernel/qemu-part1.config,
# which is built allnoconfig plus a merge, so there is no /dev/kvm and
# no module to load. The seven boot tests were developed in an
# environment that also had none, so their timeouts are already tuned
# for software emulation.
#
# --disable-slirp DELIBERATELY, AND IT IS A STATED GAP rather than an
# oversight: qemu needs libslirp for -netdev user, and
# test_disk_image.c's with_nic case uses exactly that. libslirp is not
# packaged yet, so this revision builds without it and the NIC case
# stays unavailable. Everything that boots a kernel or an ISO without
# a NIC works. The alternative was to hold qemu back entirely until
# one more library landed, which delivers nothing in the meantime.
#
# gcc, BECAUSE MESON REFUSES TCC. Measured by pixman@0.46.4-1: meson
# answers "Unknown compiler(s): [['tcc']]" before reading a source
# file. qemu's ./configure is a shell wrapper that hands the real work
# to meson, so the same limit applies.
#
# THE INTERPRETERS ARE NAMED ABSOLUTELY. --python, --meson and --ninja
# are passed explicitly rather than left to PATH discovery, for the
# same reason CLAUDE.md requires gcc by absolute path: what a build
# resolved is then recorded in the recipe instead of depending on the
# build environment's search order.
#
package "qemu" {
    version "11.1.2"
    release 1
    format "cixpkg"

    license "GPL-2.0-only"

    sources {
        main "qemu" {
            url "https://download.qemu.org/qemu-11.1.2.tar.xz"
            sha256 "731b5681e4bb18be313231579b8efd0296c5b015fa36dc533874b639ba838016"
        }
    }

    requires {
        build {
            compiler "gcc"
            tool "meson"
            tool "ninja"
            tool "python"
            tool "pkgconf"
            tool "glib"
            tool "pixman"
            tool "zlib"
            tool "libffi"
            tool "pcre2"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "findutils"
            tool "diffutils"
            tool "binutils"
        }
        runtime {
            package "glib"
            package "pixman"
            package "zlib"
            package "libffi"
            package "pcre2"
        }
    }

    toolchain "gcc" {
        reason "qemu's ./configure hands the real work to meson, and meson does not recognise this tcc at all: 'Unknown compiler(s): [[tcc]]', before any source file is read. The build system's limit rather than qemu's. Measured on 192.168.15.95, 2026-10-09 by pixman@0.46.4-1."
    }

    metadata {
        "changelog" "11.1.2-1: first revision. Seven of this project's tests boot a kernel or an installer ISO under QEMU and none has ever run on a Cix host, because no Cix host had QEMU; with ovmf@202608-1 this is the other half of cix#584. One target (x86_64-softmmu), TCG only since this kernel has no KVM, and --disable-slirp as a STATED gap: -netdev user needs libslirp, which is not packaged yet, so test_disk_image's with_nic case stays unavailable while everything else becomes possible."
    }

    prepare {
        require directory "${src}/qemu/qemu-11.1.2" {
            exists
        }
        require file "${src}/qemu/qemu-11.1.2/configure" {
            exists
            nonempty
        }
    }

    build {
        cd "${src}/qemu/qemu-11.1.2" {
            run "./configure" {
                "--prefix=/usr"
                "--target-list=x86_64-softmmu"
                "--disable-docs"
                "--disable-gtk"
                "--disable-sdl"
                "--disable-vnc"
                "--disable-curses"
                "--disable-slirp"
                "--disable-user"
                "--disable-werror"
                "--audio-drv-list="
                "--python=/usr/bin/python3"
                "--meson=/usr/bin/meson"
                "--ninja=/usr/bin/ninja"
                env "CC" = "/usr/bin/gcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/qemu/qemu-11.1.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/bin/qemu-system-x86_64" {
            exists
            nonempty
        }
        require file "${dest}/usr/bin/qemu-img" {
            exists
            nonempty
        }
    }
}
