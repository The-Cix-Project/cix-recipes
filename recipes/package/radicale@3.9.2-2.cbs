#
# radicale -- a CalDAV and CardDAV server, for the `dav` container: the
# owner's calendars and contacts (the owner, 2026-11-23, choosing it
# over Baikal, which is PHP and would need PHP packaged first).
#
# NOTHING IS COMPILED HERE. Radicale and every dependency it needs are
# pure python, so this package stages their module trees into
# /usr/lib/radicale and provides one wrapper that sets PYTHONPATH, the
# shape meson@1.12.1 and edk2-basetools use: no pip (CPDL-E3006), and no
# dependence on python's version-specific site-packages name.
#
# The dependencies travel inside this package rather than as packages of
# their own, because Radicale is their only consumer here: defusedxml,
# passlib (1.9.5, which libpass>=1.9.3 resolves to), vobject with pytz,
# six, python-dateutil and tzdata, and ldap3 with pyasn1 for checking
# logins against the directory. Each is a PyPI source archive pinned by
# the sha256 PyPI publishes. Layouts measured by probe-radicale-layout@1-1.
#
package "radicale" {
    version "3.9.2"
    release 2
    format "cixpkg"

    license "GPL-3.0-or-later"

    sources {
        main "radicale" {
            url "https://files.pythonhosted.org/packages/d1/cc/369803acc91a1c4250ea1e3b5e7f949d9c67932c827d55ff7ec6d207bd97/radicale-3.9.2.tar.gz"
            sha256 "d0ac4d537d0d357507eab9792183aee8861bfe8330fa4787574a276a4b091695"
        }
        extra "defusedxml" {
            url "https://files.pythonhosted.org/packages/0f/d5/c66da9b79e5bdb124974bfe172b4daf3c984ebd9c2a06e2b8a4dc7331c72/defusedxml-0.7.1.tar.gz"
            sha256 "1bb3032db185915b62d7c6209c5a8792be6a32ab2fedacc84e01b52c51aa3e69"
        }
        extra "passlib" {
            url "https://files.pythonhosted.org/packages/4a/05/0c74404b2e028a949ab89eac270203dc151d3033656b60b2f71db9fea6dd/passlib-1.9.5.tar.gz"
            sha256 "15d39a9b2044a86f341a2e443170e4e9a6d71fe0266fe28b91032a8ca723f8aa"
        }
        extra "vobject" {
            url "https://files.pythonhosted.org/packages/d0/8a/15c34b3d27c43fc81a467d0f66577afc5542326804c42f30557e31c3259e/vobject-0.9.9.tar.gz"
            sha256 "ac44e5d7e2079d84c1d52c50a615b9bec4b1ba958608c4c7fe40cbf33247b38e"
        }
        extra "pythondateutil" {
            url "https://files.pythonhosted.org/packages/18/39/b3927f3616f6223832f9b760e4208e8a7c7e1dea2b4d9ad7d32a5d214c3a/python_dateutil-4.0.0.tar.gz"
            sha256 "d7295ff14fdc0f92f662100bfb6c551d160ca090f2939f1ec5b9794265c03f06"
        }
        extra "six" {
            url "https://files.pythonhosted.org/packages/94/e7/b2c673351809dca68a0e064b6af791aa332cf192da575fd474ed7d6f16a2/six-1.17.0.tar.gz"
            sha256 "ff70335d468e7eb6ec65b95b99d3a2836546063f63acc5171de367e834932a81"
        }
        extra "pytz" {
            url "https://files.pythonhosted.org/packages/f5/b0/168030b0bfcc334cf09fa3313afdb888d892c8a0027324683d1de0ec277e/pytz-2026.6.tar.gz"
            sha256 "3b0fc2727707663d6e517936f444fd8a8b240f1fc32f4bf7ee03274245945284"
        }
        extra "tzdata" {
            url "https://files.pythonhosted.org/packages/7a/29/6a1391d31cd00ff9e927215a224a880e1e84e826b64ba80a499e51c074d8/tzdata-2026.6.tar.gz"
            sha256 "85d2cd9c09f81f0bb29db27759fc83af4f1e620efb814f8c5bf8b4cc4feece6d"
        }
        extra "ldap3" {
            url "https://files.pythonhosted.org/packages/43/ac/96bd5464e3edbc61595d0d69989f5d9969ae411866427b2500a8e5b812c0/ldap3-2.9.1.tar.gz"
            sha256 "f3e7fc4718e3f09dda568b57100095e0ce58633bcabbed8667ce3f8fbaa4229f"
        }
        extra "pyasn1" {
            url "https://files.pythonhosted.org/packages/88/7e/3c0da41061a2021cac7cd524fd57092adbe5b515e8bf9005702e366802e2/pyasn1-0.6.5.tar.gz"
            sha256 "6b11616a6bcf3a40e635f082bb232fa57b5e0dd7f517bd7ddd69ec3794508a47"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
        }
        runtime {
            package "python"
        }
    }

    metadata {
        "artifact_sha256" "770385aa49094aedbeed7fb3672a3961016fb08ba7faca2b063f5ae5f91211e7"
        "changelog" "3.9.2-2: stages each module's PKG-INFO as METADATA in a dist-info directory, as pip would, so importlib.metadata finds them; Radicale reads its own version that way at import and 3.9.2-1 stopped with PackageNotFoundError."
    }

    prepare {
        mkdir "${build}/deps" parents
        extract $source.defusedxml into "${build}/deps" as "defusedxml"
        extract $source.passlib into "${build}/deps" as "passlib"
        extract $source.vobject into "${build}/deps" as "vobject"
        extract $source.pythondateutil into "${build}/deps" as "pythondateutil"
        extract $source.six into "${build}/deps" as "six"
        extract $source.pytz into "${build}/deps" as "pytz"
        extract $source.tzdata into "${build}/deps" as "tzdata"
        extract $source.ldap3 into "${build}/deps" as "ldap3"
        extract $source.pyasn1 into "${build}/deps" as "pyasn1"
        require file "${src}/radicale/radicale-3.9.2/radicale/__init__.py" {
            exists
        }
        require file "${build}/deps/pythondateutil/src/dateutil/__init__.py" {
            exists
        }
        require file "${build}/deps/tzdata/src/tzdata/__init__.py" {
            exists
        }
        on_fail {
            run "ls" {
                "-R" "${build}/deps/pythondateutil" "${build}/deps/tzdata"
                allow_failure
            }
        }
    }

    build {
        run "true" {
        }
    }

    install {
        mkdir "${dest}/usr/lib/radicale" parents
        copy tree "${src}/radicale/radicale-3.9.2/radicale" to "${dest}/usr/lib/radicale/radicale"
        copy tree "${build}/deps/defusedxml/defusedxml" to "${dest}/usr/lib/radicale/defusedxml"
        copy tree "${build}/deps/passlib/passlib" to "${dest}/usr/lib/radicale/passlib"
        copy tree "${build}/deps/vobject/vobject" to "${dest}/usr/lib/radicale/vobject"
        copy tree "${build}/deps/pythondateutil/src/dateutil" to "${dest}/usr/lib/radicale/dateutil"
        copy "${build}/deps/six/six.py" to "${dest}/usr/lib/radicale/six.py"
        copy tree "${build}/deps/pytz/pytz" to "${dest}/usr/lib/radicale/pytz"
        copy tree "${build}/deps/tzdata/src/tzdata" to "${dest}/usr/lib/radicale/tzdata"
        copy tree "${build}/deps/ldap3/ldap3" to "${dest}/usr/lib/radicale/ldap3"
        copy tree "${build}/deps/pyasn1/pyasn1" to "${dest}/usr/lib/radicale/pyasn1"

        # Each module's own PKG-INFO, as pip installs it: METADATA in a
        # <name>-<version>.dist-info beside the module, so importlib.metadata
        # finds it on PYTHONPATH. Radicale reads its own version that way at
        # import, and 3.9.2-1 stopped with PackageNotFoundError.
        mkdir "${dest}/usr/lib/radicale/radicale-3.9.2.dist-info" parents
        copy "${src}/radicale/radicale-3.9.2/PKG-INFO" to "${dest}/usr/lib/radicale/radicale-3.9.2.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/defusedxml-0.7.1.dist-info" parents
        copy "${build}/deps/defusedxml/PKG-INFO" to "${dest}/usr/lib/radicale/defusedxml-0.7.1.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/passlib-1.9.5.dist-info" parents
        copy "${build}/deps/passlib/PKG-INFO" to "${dest}/usr/lib/radicale/passlib-1.9.5.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/vobject-0.9.9.dist-info" parents
        copy "${build}/deps/vobject/PKG-INFO" to "${dest}/usr/lib/radicale/vobject-0.9.9.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/python_dateutil-4.0.0.dist-info" parents
        copy "${build}/deps/pythondateutil/PKG-INFO" to "${dest}/usr/lib/radicale/python_dateutil-4.0.0.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/six-1.17.0.dist-info" parents
        copy "${build}/deps/six/PKG-INFO" to "${dest}/usr/lib/radicale/six-1.17.0.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/pytz-2026.6.dist-info" parents
        copy "${build}/deps/pytz/PKG-INFO" to "${dest}/usr/lib/radicale/pytz-2026.6.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/tzdata-2026.6.dist-info" parents
        copy "${build}/deps/tzdata/PKG-INFO" to "${dest}/usr/lib/radicale/tzdata-2026.6.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/ldap3-2.9.1.dist-info" parents
        copy "${build}/deps/ldap3/PKG-INFO" to "${dest}/usr/lib/radicale/ldap3-2.9.1.dist-info/METADATA"
        mkdir "${dest}/usr/lib/radicale/pyasn1-0.6.5.dist-info" parents
        copy "${build}/deps/pyasn1/PKG-INFO" to "${dest}/usr/lib/radicale/pyasn1-0.6.5.dist-info/METADATA"

        mkdir "${dest}/usr/bin" chmod 0755
        write "${dest}/usr/bin/radicale" """
            #!/bin/sh
            PYTHONPATH=/usr/lib/radicale
            export PYTHONPATH
            exec /usr/bin/python3 -m radicale "$@"
            """
        chmod 0755 "${dest}/usr/bin/radicale"

        require file "${dest}/usr/lib/radicale/radicale/__main__.py" {
            exists
            nonempty
        }
    }
}
