# sqlite -- the embedded SQL database. First consumer: lighttpd's
# mod_webdav, which keeps WebDAV properties and locks in it (the nas
# container, the owner's request of 2026-11-22). The amalgamation
# tarball, built with tcc. sha256 measured on gibsson-1 by
# probe-cix-tarball@872-1.
#
# Outputs as ADR-0371 asks of a library: the main package carries the
# shared library only; sqlite-dev the header and pkg-config file;
# sqlite-tools the sqlite3 command-line shell.
package "sqlite" {
    version "3.50.4"
    release 3
    format "cixpkg"
    license "blessing"

    sources {
        main "sqlite" {
            url "https://sqlite.org/2025/sqlite-autoconf-3500400.tar.gz"
            sha256 "a3db587a1b92ee5ddac2f66b3edb41b26f9c867275782d46c3a088977d6a5b18"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "c6b15027f30c0541888b6e6d637af34529405f17d9afce52c24d21c7ef75364a"
        "artifact_sha256.sqlite-tools" "bbce3801b9dd6585fade32bb14690695860c674966f2c927cc2e58e478268527"
        "artifact_sha256.sqlite-dev" "ef32ed80368f7d57c1b5465744d8b7d6c6314b09ec2a07634f880967e8049add"
        "changelog" "3.50.4-3: configure gets CC=tcc as an argument and CC_FOR_BUILD=tcc in the environment: autosetup builds its bootstrap jimsh0 before it reads any argument, trying only cc and gcc unless CC_FOR_BUILD names a compiler (3.50.4-1 and -2: No working C compiler found). For lighttpd's WebDAV properties and locks; sqlite-dev and sqlite-tools as outputs."
    }

    output "sqlite-dev" {
        files {
            "usr/include"
            "usr/lib/pkgconfig"
        }
        requires { runtime { package "sqlite" } }
    }
    output "sqlite-tools" {
        files {
            "usr/bin/sqlite3"
            "usr/share/man"
        }
        requires { runtime { package "sqlite" } }
    }
    prepare {
        require directory "${src}/sqlite/sqlite-autoconf-3500400" {
            exists
        }
    }

    build {
        cd "${src}/sqlite/sqlite-autoconf-3500400" {
            run "./configure" {
                "--prefix=/usr"
                "--libdir=/usr/lib"
                "--disable-static"
                "--disable-readline"
                "CC=tcc"
                env "CC_FOR_BUILD" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
        on_fail {
            run "ls" { "-1" "${src}/sqlite" allow_failure }
        }
    }

    install {
        cd "${src}/sqlite/sqlite-autoconf-3500400" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/include/sqlite3.h" {
            exists
            nonempty
        }
        require file "${dest}/usr/lib/pkgconfig/sqlite3.pc" {
            exists
            nonempty
        }
        require file "${dest}/usr/bin/sqlite3" {
            exists
            executable
        }
    }

}
