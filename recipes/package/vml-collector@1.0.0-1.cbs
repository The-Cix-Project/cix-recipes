# vml-collector -- polls the Cix API's JSON reads (host, container,
# volume and storage stats; the kernel/cixd/audit log) into
# VictoriaMetrics and VictoriaLogs. cixd serves no /metrics, by the
# owner's decision (2026-11-26), so this is the metrics path for the vml
# observability container.
#
# One hibr script, from the hibr catalogue: cli/vml-collector in
# itdlabs/hibr-apps (the owner, 2026-11-26: hibr tools live in the
# catalogue, not in a repository each). The source is that repository's
# archive at the commit the hibr session published, pinned by sha256,
# since cbs takes only an archive as a main source (CPDL-E6001).
# Installed as /usr/bin/vml-collector with its #!/usr/bin/hibr line; it
# needs nothing but hibr (fetch.so, sys.so and, through hibr, openssl):
# no coreutils.
#
# Site settings (CIX_API, the app password, the CA file) belong to the
# deployment, never to this package.
package "vml-collector" {
    version "1.0.0"
    release 1
    format "cixpkg"
    license "GPL-3.0-or-later"

    sources {
        main "hibr-apps" {
            # hibr-apps at the commit that published cli/vml-collector
            # 1.0.0 (bundle sha256 a08df15c...0955 in the signed index).
            # Archive sha256 measured on the box by cix (zero-sha probe).
            url "https://git.uk.home.arpa/itdlabs/hibr-apps/archive/ee7c3d26503d75f683fd925f13464eb2c1b31d05.tar.gz"
            sha256 "e93de5e52052fcd6995884c90b1661a5120fa55d7767c86a33b6410378cea16e"
        }
    }

    requires {
        build {
            tool "bash"
            tool "coreutils"
            tool "grep"
        }
        runtime {
            package "hibr"
        }
    }

    metadata {
        "artifact_sha256" "f92d3ba349d1c5974248ba7466fa290589736b4f8447f244462fb76335beffd5"
        "changelog" "1.0.0-1: first revision, for the vml image. cli/vml-collector from the hibr catalogue (itdlabs/hibr-apps) at a pinned commit: Cix stats to VictoriaMetrics, kernel/cixd/audit log to VictoriaLogs."
    }

    prepare {
        require file "${src}/hibr-apps/hibr-apps/bundles/cli/vml-collector.hibr" {
            exists
            nonempty
        }
        on_fail {
            run "ls" { "-1" "${src}/hibr-apps" allow_failure }
            run "ls" { "-1" "${src}/hibr-apps/hibr-apps/bundles/cli" allow_failure }
        }
    }

    build {
        # The file is the catalogue's version 1.0.0, not some other one.
        run "grep" {
            "-q" "^app vml-collector .* 1[.]0[.]0$"
            "${src}/hibr-apps/hibr-apps/bundles/cli/vml-collector.hibr"
        }
    }

    install {
        mkdir "${dest}/usr/bin" parents
        copy "${src}/hibr-apps/hibr-apps/bundles/cli/vml-collector.hibr" to "${dest}/usr/bin/vml-collector"
        chmod 0755 "${dest}/usr/bin/vml-collector"
        require file "${dest}/usr/bin/vml-collector" {
            exists
            executable
        }
    }
}
