# xz, as a CPDL recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/xz/5.8.3-8/build.sh: same tarball at
# the same digest, same configure switches, same `make install`.
#
# Both of the shell recipe's post-install removals are gone, for two
# different reasons:
#
#   rm -rf usr/share            -- ADR-0306 withdrew this practice. The
#                                  platform removes what it CANNOT use,
#                                  never what it merely does not read.
#                                  xz is one of the 57 recipes #491
#                                  counts as still pruning by hand.
#   rm -f liblzma.{a,la}        -- redundant, not wrong. ADR-0251's
#                                  clauses 2 and 3 already drop a static
#                                  archive superseded by a shared object
#                                  beside it, and every .la file, in the
#                                  finalize phase that runs after this.
#                                  A recipe restating platform policy is
#                                  a second place for that policy to
#                                  live, which is what One Source of
#                                  Truth forbids.
package "xz" {
    version "5.8.3"
    release 12
    format "cixpkg"

    # xz 5.8.x is 0BSD for the core library and tools; the package also
    # carries GPL'd scripts (xzdiff, xzgrep, xzmore) and an LGPL'd
    # getopt replacement. SPDX for the tree as shipped.
    license "0BSD AND GPL-2.0-or-later AND LGPL-2.1-or-later"

    sources {
        main "xz" {
            url "https://github.com/tukaani-project/xz/releases/download/v5.8.3/xz-5.8.3.tar.gz"
            sha256 "3d3a1b973af218114f4f889bbaa2f4c037deaae0c8e815eec381c3d546b974a0"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
    }

    metadata {
        "artifact_sha256" "5b98fd565e7dea816b1ec5ab49acac690ce24605e9dd70927df0d9b1e806cc0c"
        "artifact_sha256.xz-dev" "f6a276587ff8324e7fa7f6c4c3ce3de9eac43e5a4f7beac962b66ecd7ba41b7f"
        "artifact_sha256.xz-tools" "e71f6fce5280eeebd301e97525933aeabca3726b91530bfc0787551ce50e6da8"
        "changelog" "5.8.3-12: the programs, scripts, man pages and message catalogues move to an xz-tools output, and the headers and pkg-config file to xz-dev; the xz package keeps liblzma (ADR-0371 decision E, cix#350). tool \"xz\" still composes both (ADR-0372); an image that runs xz declares xz-tools."
    }

    # ADR-0371 decision E (the owner, 2026-11-10): a library package's
    # main output carries the runtime library only, so the control-plane
    # root, which needs liblzma and runs none of these programs, carries
    # none of them. ADR-0372: a recipe that declares tool "xz" composes
    # every output; an image that runs xz declares xz-tools.
    output "xz-tools" {
        files {
            "usr/bin"
            "usr/share/man"
            "usr/share/locale"
        }
        requires { runtime { package "xz" } }
    }

    output "xz-dev" {
        files {
            "usr/include"
            "usr/lib/pkgconfig"
        }
        requires { runtime { package "xz" } }
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/xz"
        }
        require directory "${src}/xz/xz-5.8.3" {
            exists
        }
    }

    build {
        cd "${src}/xz/xz-5.8.3" {
            run "./configure" {
                "--prefix=/usr"
                "--disable-doc"
                "--disable-symbol-versions"
                env "CC" = "tcc"
            }
            run "make" {
                jobs $jobs
            }
        }
    }

    install {
        cd "${src}/xz/xz-5.8.3" {
            run "make" {
                "DESTDIR=${dest}"
                "install"
            }
        }
        require file "${dest}/usr/bin/xz" {
            exists
            nonempty
        }
        # liblzma.so.5.8.3, NOT liblzma.so.5: `require file` is
        # lstat()-based and demands S_ISREG, so it FAILS on a symlink
        # and says "does not exist" while the symlink is right there.
        # -9 asserted the soname link and failed with that message after
        # a clean `make install` (cix-build-system#175). The real file is
        # the one to assert on; the links beside it are libtool's.
        require file "${dest}/usr/lib/liblzma.so.5.8.3" {
            exists
            nonempty
        }
    }
}
