# zlib, as a CPDL recipe (ADR-0305 stage 4).
#
# A translation of recipes/package/zlib/1.3.2-11/build.sh: same tarball
# at the same digest, the same three environment variables, the same
# `make install`.
#
# The shell recipe's guard
#
#     if [ ! -f libz.so.1 ]; then echo "... static-only" >&2; exit 1; fi
#
# becomes a `require file`, and moves from install to the end of build,
# where the thing it checks is actually produced. That is the same
# assertion in the language's own terms rather than a shell idiom
# carried across -- and it fails with the path it was looking for
# instead of a message someone had to write.
#
# Both post-install removals are gone: usr/share/man by ADR-0306 (#491),
# and usr/lib/*.a because ADR-0251's finalize phase already drops a
# static archive superseded by a shared object beside it. libz.a is
# exactly that case.
package "zlib" {
    version "1.3.2"
    release 15
    format "cixpkg"

    license "Zlib"

    sources {
        main "zlib" {
            url "https://zlib.net/zlib-1.3.2.tar.gz"
            sha256 "bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "binutils"
            tool "linux-headers"
        }
    }

    metadata {
        "artifact_sha256" "66dbad62eb06e3fd34163eb005376ac69a3aefae7da846bf1e57672971877eef"
        "changelog" "1.3.2-15: identical to the previous revision except that it carries no artifact approval, so it genuinely BUILDS and produces a .cixpkg. The previous revision is CPDL but its cached artifact is a tar.gz, which is cix#497 -- a converted recipe whose approval predates the cixpkg flip -- so the daemon never rebuilt it and had only a tarball to publish. The ADR-0209 floor needs a cixpkg for every artifact it seeds (cix#529)."
    }

    prepare {
        run "ls" {
            "-la"
            "${src}/zlib"
        }
        require directory "${src}/zlib/zlib-1.3.2" {
            exists
        }
    }

    build {
        # All three are ENVIRONMENT variables, not make overrides: zlib
        # ships a hand-written configure (not autoconf) that reads them
        # from the environment to decide how to link. LDSHARED carries
        # the soname explicitly because TCC does not derive one, and
        # LDFLAGS names libtcc1.a because a TCC-linked shared object
        # needs its compiler runtime and nothing else supplies it.
        cd "${src}/zlib/zlib-1.3.2" {
            run "./configure" {
                "--prefix=/usr"
                env "CC" = "tcc"
                env "LDSHARED" = "tcc -shared -Wl,-soname,libz.so.1"
                env "LDFLAGS" = "/usr/lib/tcc/libtcc1.a"
            }
            run "make" {
                jobs $jobs
            }
            # The guard, in CPDL's terms. A configure that falls back
            # to static-only produces no shared library at all, and
            # every later link against -lz silently takes the archive.
            #
            # Named libz.so.1.3.2 and not libz.so.1, which -13 got wrong
            # twice over: `require file` lstat()s and demands a regular
            # file, so it rejects a symlink and says "does not exist"
            # (cix-build-system#175) -- and libz.so.1 IS a symlink here,
            # not only after `make install` as -13's comment claimed.
            # The build log settles it: zlib links its own test binaries
            # against `libz.so.1.3.2`, which is the file it built.
            require file "${src}/zlib/zlib-1.3.2/libz.so.1.3.2" {
                exists
                nonempty
            }
        }
    }

    install {
        cd "${src}/zlib/zlib-1.3.2" {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        # libz.so.1.3.2, NOT libz.so.1: `require file` lstat()s and
        # demands S_ISREG, so it fails on a symlink and reports "does
        # not exist" (cix-build-system#175).
        require file "${dest}/usr/lib/libz.so.1.3.2" {
            exists
            nonempty
        }
        require file "${dest}/usr/include/zlib.h" {
            exists
            nonempty
        }
    }
}
